{
  "code": "ZZ",
  "status": "active",
  "defaultLocale": "ja-JP",
  "supportedLocales": ["ja-JP", "en-US"],
  "defaultCurrency": "JPY",
  "settlementCurrency": "JPY",
  "timezone": "Asia/Tokyo",
  "requestLimits": {
    "anonymousIdentityPerMinute": 10,
    "defaultPerMinute": 200
  },
  "allowedOrigins": ["https://storefront.zz.test"],
  "identity": {
    "password": {
      "minLength": 16,
      "maxLength": 100
    },
    "existingAccountNoticeHours": 12,
    "sessions": {
      "customer": { "idleTimeoutMinutes": 10080, "absoluteLifetimeMinutes": 20160 },
      "seller": { "idleTimeoutMinutes": 600, "absoluteLifetimeMinutes": 1200 }
    },
    "keepSignedInSessions": {
      "seller": { "idleTimeoutMinutes": 10080, "absoluteLifetimeMinutes": 20160 }
    },
    "signInThrottles": {
      "accountOrigin": { "limit": 4, "windowMinutes": 10, "blockMinutes": 20 },
      "account": { "limit": 15, "windowMinutes": 60, "blockMinutes": 30 },
      "origin": { "limit": 25, "windowMinutes": 15, "blockMinutes": 15 }
    },
    "mailThrottles": {
      "account": { "limit": 2, "windowMinutes": 60, "blockMinutes": 0 },
      "origin": { "limit": 8, "windowMinutes": 30, "blockMinutes": 0 }
    },
    "signInRecordRetentionDays": 60,
    "links": {
      "lifetimeMinutes": { "verify-email": 720 },
      "targets": {
        "customer": {
          "verify-email": "https://storefront.zz.test/konto/bestaetigen?ref=mail",
          "sign-in": "https://storefront.zz.test/konto/anmelden"
        },
        "seller": {
          "verify-email": "https://seller.zz.test/konto/bestaetigen?ref=mail",
          "sign-in": "https://seller.zz.test/konto/anmelden"
        }
      }
    },
    "unverifiedAccountRetentionDays": 5,
    "mail": {
      "fromAddress": "noreply@zz.test",
      "fromName": "ZZ Shop"
    }
  },
  "sellers": {
    "approvalRequired": false,
    "address": {
      "fields": [
        {
          "key": "street",
          "labelKey": "sellers.address.street",
          "required": true,
          "maxLength": 120
        },
        {
          "key": "district",
          "labelKey": "sellers.address.district",
          "required": true,
          "maxLength": 120
        },
        {
          "key": "prefecture",
          "labelKey": "sellers.address.prefecture",
          "required": true,
          "maxLength": 20
        },
        {
          "key": "postalCode",
          "labelKey": "sellers.address.postal-code",
          "required": true,
          "maxLength": 8
        }
      ],
      "postcodeField": "postalCode",
      "regionField": "prefecture",
      "postcodePattern": "^[0-9]{7}$",
      "regions": ["ZA", "ZB"]
    },
    "reservedWords": {
      "slugs": ["admin", "api", "zz-staff", "zzmart"],
      "claimWords": ["blessed", "genuine", "pure"]
    },
    "timezones": {
      "countries": ["JP", "NZ"],
      "byRegion": {
        "ZA": {
          "default": "Asia/Tokyo",
          "selectable": ["Asia/Tokyo"]
        },
        "ZB": {
          "default": "Pacific/Auckland",
          "selectable": ["Pacific/Auckland", "Pacific/Chatham"]
        }
      }
    }
  },
  "inventory": {
    "maxSourcesPerSeller": 2
  }
}
