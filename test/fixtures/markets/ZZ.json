{
  "code": "ZZ",
  "status": "active",
  "defaultLocale": "ja-JP",
  "supportedLocales": ["ja-JP", "en-US"],
  "defaultCurrency": "JPY",
  "settlementCurrency": "JPY",
  "pricesIncludeTax": false,
  "maxLineQuantity": 50,
  "timezone": "Asia/Tokyo",
  "requestLimits": {
    "anonymousIdentityPerMinute": 10,
    "defaultPerMinute": 200
  },
  "allowedOrigins": {
    "admin": ["https://admin.zz.test"],
    "seller": ["https://seller.zz.test"],
    "customer": ["https://storefront.zz.test"]
  },
  "identity": {
    "password": {
      "minLength": 16,
      "maxLength": 100
    },
    "existingAccountNoticeHours": 12,
    "sessions": {
      "customer": {
        "idleTimeoutMinutes": 10080,
        "absoluteLifetimeMinutes": 20160
      },
      "seller": {
        "idleTimeoutMinutes": 600,
        "absoluteLifetimeMinutes": 1200
      },
      "admin": {
        "idleTimeoutMinutes": 20,
        "absoluteLifetimeMinutes": 480
      }
    },
    "keepSignedInSessions": {
      "seller": {
        "idleTimeoutMinutes": 10080,
        "absoluteLifetimeMinutes": 20160
      }
    },
    "signInThrottles": {
      "accountOrigin": {
        "limit": 4,
        "windowMinutes": 10,
        "blockMinutes": 20
      },
      "account": {
        "limit": 15,
        "windowMinutes": 60,
        "blockMinutes": 30
      },
      "origin": {
        "limit": 25,
        "windowMinutes": 15,
        "blockMinutes": 15
      }
    },
    "mailThrottles": {
      "account": {
        "limit": 2,
        "windowMinutes": 60,
        "blockMinutes": 0
      },
      "origin": {
        "limit": 8,
        "windowMinutes": 30,
        "blockMinutes": 0
      }
    },
    "signInRecordRetentionDays": 60,
    "links": {
      "lifetimeMinutes": {
        "verify-email": 720,
        "reset-password": 60,
        "enrol-second-factor": 45
      },
      "targets": {
        "customer": {
          "verify-email": "https://storefront.zz.test/konto/bestaetigen?ref=mail",
          "sign-in": "https://storefront.zz.test/konto/anmelden",
          "reset-password": "https://storefront.zz.test/konto/passwort?ref=mail"
        },
        "seller": {
          "verify-email": "https://seller.zz.test/konto/bestaetigen?ref=mail",
          "sign-in": "https://seller.zz.test/konto/anmelden",
          "reset-password": "https://seller.zz.test/konto/passwort?ref=mail",
          "accept-invitation": "https://seller.zz.test/konto/einladung"
        },
        "admin": {
          "seller-review-queue": "https://admin.zz.test/haendler/pruefung?ref=mail",
          "sign-in": "https://admin.zz.test/anmelden",
          "accept-invitation": "https://admin.zz.test/einladung",
          "enrol-second-factor": "https://admin.zz.test/zweiter-faktor",
          "reset-password": "https://admin.zz.test/passwort"
        }
      }
    },
    "invitations": {
      "lifetimeMinutes": {
        "admin": 2880,
        "seller-owner": 7200,
        "staff": 7200
      }
    },
    "challenges": {
      "maxAttempts": 4,
      "lifetimeSeconds": 240
    },
    "secondFactorThrottles": {
      "account": {
        "limit": 8,
        "windowMinutes": 2880,
        "blockMinutes": 2880
      }
    },
    "sellerReapplyLimit": 3,
    "customRoleLimits": { "seller": 20, "platform": 50 },
    "unverifiedAccountRetentionDays": 5,
    "mail": {
      "fromAddress": "noreply@zz.test",
      "fromName": "ZZ Shop"
    }
  },
  "sellers": {
    "approvalRequired": false,
    "businessIdentifier": {
      "scheme": "zz-corp-no",
      "required": false,
      "labelKey": "sellers.business-identifier.zz-corp-no"
    },
    "registerLookup": {
      "adapter": "fake",
      "manualLinkTemplate": "https://register.example.test/lookup/{identifier}",
      "maxResultAgeDays": 7,
      "perAccountLimit": 2,
      "perOriginLimit": 3,
      "marketDailyBudget": 20,
      "legalSuffixes": ["kk", "zz ltd"]
    },
    "address": {
      "fields": [
        {
          "key": "street",
          "labelKey": "sellers.address.street",
          "required": true,
          "maxLength": 120
        },
        {
          "key": "district",
          "labelKey": "sellers.address.district",
          "required": true,
          "maxLength": 120
        },
        {
          "key": "prefecture",
          "labelKey": "sellers.address.prefecture",
          "required": true,
          "maxLength": 20
        },
        {
          "key": "postalCode",
          "labelKey": "sellers.address.postal-code",
          "required": true,
          "maxLength": 8
        }
      ],
      "postcodeField": "postalCode",
      "regionField": "prefecture",
      "postcodePattern": "^[0-9]{7}$",
      "regions": ["ZA", "ZB"]
    },
    "reservedWords": {
      "slugs": ["admin", "api", "zz-staff", "zzmart"],
      "claimWords": ["zzmart", "blessed", "genuine", "pure"]
    },
    "timezones": {
      "countries": ["JP", "NZ"],
      "byRegion": {
        "ZA": {
          "default": "Asia/Tokyo",
          "selectable": ["Asia/Tokyo"]
        },
        "ZB": {
          "default": "Pacific/Auckland",
          "selectable": ["Pacific/Auckland", "Pacific/Chatham"]
        }
      }
    }
  },
  "inventory": {
    "maxSourcesPerSeller": 2,
    "defaultLowStockThreshold": 3
  },
  "catalog": {
    "taxCategories": [
      {
        "code": "zz_standard",
        "labelKey": "catalog.tax.zz-standard"
      },
      {
        "code": "zz_reduced",
        "labelKey": "catalog.tax.zz-reduced"
      },
      {
        "code": "zz_zero",
        "labelKey": "catalog.tax.zz-zero"
      }
    ],
    "sensitiveChanges": {
      "platformCategories": false,
      "taxCategory": true,
      "name": true,
      "primaryImage": false,
      "anyImage": true,
      "variantRemoved": false
    },
    "maxVariantsPerProduct": 3,
    "approvalRequired": false,
    "productTypes": ["simple"],
    "defaultFamily": "default",
    "conditions": ["new"],
    "sellFromCatalogue": true,
    "sellerCanCreateProduct": true
  },
  "pricing": {
    "maxUnitPriceMinor": 2000000,
    "jumpThreshold": {
      "numerator": 1,
      "denominator": 4
    },
    "jumpDirections": "up",
    "jumpWindow": "P3D"
  }
}
