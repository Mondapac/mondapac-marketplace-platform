# Copy to .env for local development. Never commit .env (CLAUDE.md rule 5).
# Every variable the application reads must be listed and explained here.

# HTTP port the API listens on.
PORT=3000

# development | test | production.
NODE_ENV=development

# true | false. Serves Swagger UI at /docs. Off by default; keep it off in production.
API_DOCS_ENABLED=true

# Log level: fatal | error | warn | info | debug | trace | silent.
LOG_LEVEL=info

# Required. api | worker; no default (P 8). `api` serves HTTP; `worker` runs background
# jobs and opens no port.
APP_ROLE=api

# Required. Comma-separated Market codes this Region Stack serves (ADR-0003).
# There is no default market: the API refuses to start when this is missing or empty.
HOSTED_MARKETS=AU

# Optional. Directory with one <CODE>.json per Market. Defaults to config/markets in the
# repository. Every market in HOSTED_MARKETS must have a valid file there.
# MARKET_CONFIG_DIR=

# Optional. Directory with one <CODE>.json of ServiceArea postcode sets per Market. Defaults to
# config/service-areas in the repository. Every market in HOSTED_MARKETS must have a valid file there.
# SERVICE_AREA_CONFIG_DIR=

# Optional. Directory of translation catalogues, <locale>/<module>.json (INTL-11). Defaults to
# config/locales in the repository. Every hosted Market's default locale must have the texts its
# modules need (identity checks its mail texts at start-up).
# LOCALE_CONFIG_DIR=

# Required. PostgreSQL connection URL of the application login (`mondapac_api`, a member of
# the group role `mondapac_app`). The only database URL the application reads: it may insert
# and read what the migrations grant, and it refuses to start when this role can do more
# (docs/design/data/platform.md 10.8). The value matches scripts/db/bootstrap-dev.sql.
# It contains credentials: keep real values out of the repository and out of logs.
DATABASE_URL=postgresql://mondapac_api:mondapac_api@localhost:5432/mondapac

# Optional. Integer from 1 to 100, default 10. Size of the connection pool of each API process
# for the application login (`mondapac_api`). A read-only unit of work opens no transaction and
# takes a connection for each statement (ADR-0025). Keep the sum over all processes, plus the
# migration role and `pnpm test:db`, well below PostgreSQL's max_connections (100).
DATABASE_POOL_MAX=10

# Required for `pnpm db:*`, `pnpm test:db` and `pnpm verify` only. PostgreSQL connection URL of
# the migration role (`mondapac_migrator`), which owns the database and creates and drops the
# test databases. The application never reads it and refuses to start when it is set in its
# environment. It contains credentials, like DATABASE_URL.
MIGRATION_DATABASE_URL=postgresql://mondapac_migrator:mondapac_migrator@localhost:5432/mondapac

# Optional. Base URL of the local mail catcher's HTTP API (Mailpit in docker-compose.yml; use
# its UI port). Mail is sent there by the worker (identity design 9). Allowed only when NODE_ENV
# is explicitly development or test. Unset, every mail send fails: the worker retries it and
# dead-letters it with an alert, and no mail leaves the process.
MAIL_CATCHER_URL=http://localhost:8025

# Optional, deployment only (ADR-0037). Both empty (the default) means the feature is off: the
# client address is the socket's, as before, and a request that carries `x-client-address` is
# refused. Set both, or neither; the API refuses to start with only one.
# TRUSTED_BFF_CIDRS: comma-separated CIDRs the BFF servers (panels, storefront) send from, for
# example 10.20.1.0/24,fd00:20:1::/64. No prefix wider than /16 (IPv4) or /48 (IPv6), so never
# 0.0.0.0/0 or ::/0; no host bits set. From inside these networks every request except /health
# and /health/ready must carry a valid `x-client-address` proof.
TRUSTED_BFF_CIDRS=
# CLIENT_ADDRESS_KEYS: entries separated by `;`, each `keyId:cidrs:base64`. keyId is
# [a-z0-9-]{1,32}, one per BFF and key generation (panel, storefront, panel-2); cidrs is a
# comma-separated list inside TRUSTED_BFF_CIDRS from which this key alone is accepted; base64 is
# the HMAC secret in standard base64, at least 32 random bytes (`openssl rand -base64 32`), never
# shared by two keyIds. Rotate by adding a new keyId, moving the BFF to it, then removing the old
# one. A secret: real values live in the Region Stack's secret store (Kazem), never here or in a
# log. Example: panel:10.20.1.0/24:<base64>;storefront:10.20.2.0/24:<base64>
CLIENT_ADDRESS_KEYS=

# Optional host ports for docker-compose.yml, if the defaults are taken on your machine:
# POSTGRES_PORT=5432  REDIS_PORT=6379  SMTP_PORT=1025  MAILPIT_UI_PORT=8025
