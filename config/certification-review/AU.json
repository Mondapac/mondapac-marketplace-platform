{
  "market": "AU",
  "note": "Review checks and reasons of the launch Market (certification design 5.1). The codes are stable; the words are working texts until the reviewer procedure and the ux-copy are final (Reza, Hadi). A check that is required must be recorded done or not applicable before an approval.",
  "checks": [
    { "code": "holder-name", "required": true, "modes": ["THIRD_PARTY_DOCUMENT"] },
    { "code": "location-scope", "required": true, "modes": ["THIRD_PARTY_DOCUMENT"] },
    { "code": "issuer", "required": true, "modes": ["THIRD_PARTY_DOCUMENT"] },
    { "code": "dates", "required": true, "modes": ["THIRD_PARTY_DOCUMENT"] },
    { "code": "tampering", "required": true, "modes": ["THIRD_PARTY_DOCUMENT"] },
    { "code": "legibility-language", "required": true, "modes": ["THIRD_PARTY_DOCUMENT"] },
    { "code": "issuer-enquiry", "required": false, "modes": ["THIRD_PARTY_DOCUMENT"] },
    { "code": "declaration-read", "required": true, "modes": ["SELF_DECLARATION"] }
  ],
  "reasons": [
    {
      "code": "unreadable",
      "check": "legibility-language",
      "nextStep": "upload-clearer-file",
      "label": "The file could not be read, or it is in a language we cannot review.",
      "outcomes": ["changes-requested"]
    },
    {
      "code": "holder-name-mismatch",
      "check": "holder-name",
      "nextStep": "check-holder-name",
      "label": "The name on the certificate does not match your business.",
      "outcomes": ["changes-requested", "declined"]
    },
    {
      "code": "location-scope-unclear",
      "check": "location-scope",
      "nextStep": "check-location-scope",
      "label": "The location or scope on the certificate does not cover what you sell.",
      "outcomes": ["changes-requested", "declined"]
    },
    {
      "code": "issuer-unclear",
      "check": "issuer",
      "nextStep": "choose-issuer",
      "label": "We could not match the certificate to the issuer you chose.",
      "outcomes": ["changes-requested"]
    },
    {
      "code": "dates-unclear",
      "check": "dates",
      "nextStep": "check-dates",
      "label": "The dates you entered do not match the certificate.",
      "outcomes": ["changes-requested"]
    },
    {
      "code": "incomplete-file",
      "check": null,
      "nextStep": "upload-all-pages",
      "label": "The certificate is incomplete: pages or details are missing.",
      "outcomes": ["changes-requested"]
    },
    {
      "code": "signs-of-tampering",
      "check": "tampering",
      "nextStep": "contact-support",
      "label": "The certificate shows signs of having been altered.",
      "outcomes": ["declined", "revoked"]
    },
    {
      "code": "issuer-not-recognised",
      "check": "issuer",
      "nextStep": "contact-support",
      "label": "The issuer is not one the platform recognises.",
      "outcomes": ["declined"]
    },
    {
      "code": "not-confirmed-by-issuer",
      "check": "issuer-enquiry",
      "nextStep": "contact-support",
      "label": "The issuer did not confirm the certificate.",
      "outcomes": ["declined", "revoked", "suspended"]
    },
    {
      "code": "declaration-not-accepted",
      "check": "declaration-read",
      "nextStep": "contact-support",
      "label": "The declaration could not be accepted.",
      "outcomes": ["changes-requested", "declined"]
    },
    {
      "code": "withdrawn-by-issuer",
      "check": null,
      "nextStep": "add-new-certificate",
      "label": "The issuer has withdrawn or suspended this certificate.",
      "outcomes": ["revoked", "suspended"]
    },
    {
      "code": "approved-in-error",
      "check": null,
      "nextStep": "contact-support",
      "label": "The certificate was approved in error and no longer counts.",
      "outcomes": ["revoked"]
    },
    {
      "code": "under-investigation",
      "check": null,
      "nextStep": "contact-support",
      "label": "The certificate is being checked again and does not count until the check ends.",
      "outcomes": ["suspended"]
    }
  ],
  "issuerRequestReasons": [
    {
      "code": "issuer-not-recognised",
      "label": "The body you named is not one the platform's experts recognise as an issuer."
    },
    {
      "code": "issuer-not-identified",
      "label": "We could not identify the body you named from the request and the file."
    },
    {
      "code": "issuer-other-type",
      "label": "The body you named does not issue certificates of this type."
    }
  ]
}
