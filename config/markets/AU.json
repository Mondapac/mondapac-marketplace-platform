{
  "code": "AU",
  "status": "planned",
  "defaultLocale": "en-AU",
  "supportedLocales": ["en-AU"],
  "defaultCurrency": "AUD",
  "settlementCurrency": "AUD",
  "timezone": "Australia/Brisbane",
  "requestLimits": {
    "anonymousIdentityPerMinute": 20,
    "defaultPerMinute": 300
  },
  "allowedOrigins": [],
  "identity": {
    "password": {
      "minLength": 15,
      "maxLength": 128
    },
    "existingAccountNoticeHours": 24,
    "sessions": {
      "customer": { "idleTimeoutMinutes": 20160, "absoluteLifetimeMinutes": 43200 },
      "seller": { "idleTimeoutMinutes": 720, "absoluteLifetimeMinutes": 1440 }
    },
    "keepSignedInSessions": {
      "seller": { "idleTimeoutMinutes": 20160, "absoluteLifetimeMinutes": 43200 }
    },
    "signInThrottles": {
      "accountOrigin": { "limit": 5, "windowMinutes": 15, "blockMinutes": 15 },
      "account": { "limit": 20, "windowMinutes": 60, "blockMinutes": 60 },
      "origin": { "limit": 30, "windowMinutes": 15, "blockMinutes": 15 }
    },
    "mailThrottles": {
      "account": { "limit": 3, "windowMinutes": 60, "blockMinutes": 0 },
      "origin": { "limit": 10, "windowMinutes": 60, "blockMinutes": 0 }
    },
    "signInRecordRetentionDays": 90,
    "links": {
      "lifetimeMinutes": { "verify-email": 1440 },
      "targets": {
        "customer": {
          "verify-email": "https://storefront.au.mondapac.test/account/confirm-email",
          "sign-in": "https://storefront.au.mondapac.test/account/sign-in"
        },
        "seller": {
          "verify-email": "https://seller.au.mondapac.test/confirm-email",
          "sign-in": "https://seller.au.mondapac.test/sign-in"
        }
      }
    },
    "unverifiedAccountRetentionDays": 7,
    "mail": {
      "fromAddress": "no-reply@au.mondapac.test",
      "fromName": "MondaPac"
    }
  },
  "sellers": {
    "approvalRequired": true,
    "address": {
      "fields": [
        {
          "key": "line1",
          "labelKey": "sellers.address.line1",
          "required": true,
          "maxLength": 120
        },
        {
          "key": "line2",
          "labelKey": "sellers.address.line2",
          "required": false,
          "maxLength": 120
        },
        {
          "key": "suburb",
          "labelKey": "sellers.address.suburb",
          "required": true,
          "maxLength": 120
        },
        {
          "key": "state",
          "labelKey": "sellers.address.state",
          "required": true,
          "maxLength": 3
        },
        {
          "key": "postcode",
          "labelKey": "sellers.address.postcode",
          "required": true,
          "maxLength": 4
        }
      ],
      "postcodeField": "postcode",
      "regionField": "state",
      "postcodePattern": "^[0-9]{4}$",
      "regions": ["ACT", "NSW", "NT", "QLD", "SA", "TAS", "VIC", "WA"]
    },
    "reservedWords": {
      "slugs": [
        "about",
        "account",
        "admin",
        "api",
        "app",
        "assets",
        "blog",
        "cart",
        "categories",
        "category",
        "checkout",
        "contact",
        "dashboard",
        "help",
        "login",
        "logout",
        "mondapac",
        "orders",
        "platform",
        "privacy",
        "product",
        "products",
        "register",
        "search",
        "seller",
        "sellers",
        "settings",
        "shop",
        "shops",
        "signin",
        "signup",
        "static",
        "store",
        "stores",
        "support",
        "terms"
      ],
      "claimWords": [
        "authentic",
        "certified",
        "halal",
        "kosher",
        "official",
        "organic",
        "vegan",
        "verified"
      ]
    },
    "timezones": {
      "countries": ["AU"],
      "byRegion": {
        "ACT": {
          "default": "Australia/Sydney",
          "selectable": ["Australia/Sydney"]
        },
        "NSW": {
          "default": "Australia/Sydney",
          "selectable": ["Australia/Sydney", "Australia/Broken_Hill", "Australia/Lord_Howe"]
        },
        "NT": {
          "default": "Australia/Darwin",
          "selectable": ["Australia/Darwin"]
        },
        "QLD": {
          "default": "Australia/Brisbane",
          "selectable": ["Australia/Brisbane", "Australia/Lindeman"]
        },
        "SA": {
          "default": "Australia/Adelaide",
          "selectable": ["Australia/Adelaide"]
        },
        "TAS": {
          "default": "Australia/Hobart",
          "selectable": ["Australia/Hobart"]
        },
        "VIC": {
          "default": "Australia/Melbourne",
          "selectable": ["Australia/Melbourne"]
        },
        "WA": {
          "default": "Australia/Perth",
          "selectable": ["Australia/Perth", "Australia/Eucla"]
        }
      }
    }
  },
  "inventory": {
    "maxSourcesPerSeller": 4
  }
}
