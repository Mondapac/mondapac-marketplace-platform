# Buyer site (apps/web). Copy to .env.local. See ADR-0037.
# The API the buyer site reads. Empty: nothing is read from the API and every page runs on sample
# data (the local demo with no backend).
API_BASE_URL=
# origin=MARKET pairs, required with API_BASE_URL: the Market of each host the site is served
# on. A request to a host not listed reads nothing from the API. https only, except *.localhost.
# Locally use storefront.localhost. The same hosts serve /api/*, the relay of the buyer's session
# and guest-cart cookies (src/storefront/session-relay.ts); the API must list each origin in the
# Market's allowedOrigins.customer (locally, STOREFRONT_ORIGIN of scripts/dev-panels-market.mjs fills it).
STOREFRONT_HOSTS=http://storefront.localhost:3003=AU

# Client address (ADR-0037 decision 9). server.mjs sets the address of every request from the
# socket peer (socket) or, when the peer is inside EDGE_CIDRS, from the one header the edge sets
# (edge). Required, no default. Locally: socket.
CLIENT_ADDRESS_SOURCE=socket
# edge only. Comma-separated CIDRs of the edge, none wider than /16 (IPv4) or /48 (IPv6).
EDGE_CIDRS=
# edge only. The one lowercase header name the edge sets, for example cf-connecting-ip.
EDGE_CLIENT_ADDRESS_HEADER=
# Signing key for the address the API verifies. Both empty: no header is sent, which is only
# accepted on *.localhost hosts. keyId is storefront or storefront-<suffix> (the API takes buyer-site
# requests only under such a key); the secret is base64 of 32+ bytes.
BFF_CLIENT_ADDRESS_KEY_ID=
BFF_CLIENT_ADDRESS_SECRET=
