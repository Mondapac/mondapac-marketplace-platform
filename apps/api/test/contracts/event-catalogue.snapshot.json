    "aggregateType": "one-time-link",
    "fields": {
      "linkId": "id",
      "accountId": "id",
      "purpose": "enumOf(verify-email|reset-password|enrol-second-factor|confirm-second-factor-reset)"
    }
  },
  {
    "type": "identity.seller-registered.v1",
