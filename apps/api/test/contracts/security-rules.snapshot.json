    "groupBy": "market",
    "threshold": 3,
    "window": "PT1H"
  },
  {
    "code": "sign-in-failures-daily",
    "kind": "threshold",
    "severity": "s4",
    "title": "Failed sign-ins across the Market in a day",
    "types": ["identity.sign-in.failed"],
    "groupBy": "market",
    "threshold": 50,
    "window": "PT24H"
  }
