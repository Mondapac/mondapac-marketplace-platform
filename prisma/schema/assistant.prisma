// The assistant module's tables (buyer assistant settings, package 2). Every model is named
// Assistant<Name> and mapped to its table with @@map. The CHECKs and the grants are hand-written
// in the migration.

/// One version of a Market's buyer assistant settings. Insert-only: the settings in force are the
/// row with the highest version, and the rows before it are the change history (who, when, what).
model AssistantSettings {
  marketId                String   @map("market_id") @db.VarChar(8)
  /// 1 for the first admin change, +1 for each later one. The primary key refuses two admins
  /// saving from the same version: the second one is told to reload.
  version                 Int
  tenantId                String   @map("tenant_id")
  enabled                 Boolean
  /// internal | percent | all
  audience                String   @db.VarChar(16)
  /// 1 to 100, set if and only if audience is percent.
  audiencePercent         Int?     @map("audience_percent") @db.SmallInt
  /// read-only | cart-suggestions
  scope                   String   @db.VarChar(32)
  /// fast | balanced; the provider model of each tier is server configuration.
  modelTier               String   @map("model_tier") @db.VarChar(16)
  /// guests-and-customers | customers-only
  users                   String   @db.VarChar(32)
  guestMessageLimit       Int      @map("guest_message_limit") @db.SmallInt
  customerMessageLimit    Int      @map("customer_message_limit") @db.SmallInt
  /// none | 30-days | 12-months
  retention               String   @db.VarChar(16)
  /// buyer | english
  replyLanguage           String   @map("reply_language") @db.VarChar(16)
  dailySpendCapUsdCents   Int      @map("daily_spend_cap_usd_cents")
  monthlySpendCapUsdCents Int      @map("monthly_spend_cap_usd_cents")
  /// email-link | in-panel-form
  supportHandoff          String   @map("support_handoff") @db.VarChar(16)
  /// null: the storefront's default welcome text.
  welcomeText             String?  @map("welcome_text") @db.VarChar(200)
  changedAt               DateTime @map("changed_at") @db.Timestamptz(6)
  /// The admin account that made the change (a plain id, no foreign key).
  changedBy               String   @map("changed_by") @db.Uuid

  @@id([marketId, version])
  @@map("settings")
  @@schema("assistant")
}

/// One buyer conversation (package 4): owned by exactly one account or one guest token hash
/// (CHECK). Its message text is encrypted under its own subject key (ADR-0019 R5), so the purge
/// deletes the rows and destroys the key. `turns` counts buyer messages (at most 30).
model AssistantConversation {
  id             String             @id @db.Uuid
  marketId       String             @map("market_id") @db.VarChar(8)
  tenantId       String             @map("tenant_id")
  /// The customer's account id (a plain id, no foreign key); null for a guest's.
  accountId      String?            @map("account_id") @db.Uuid
  /// SHA-256 of the assistant guest token (32 bytes); null for an account's. Never the token.
  guestTokenHash Bytes?             @map("guest_token_hash")
  turns          Int                @db.SmallInt
  /// 0 (no text kept), 30 or 365, fixed when the conversation starts.
  retentionDays  Int                @map("retention_days") @db.SmallInt
  startedAt      DateTime           @map("started_at") @db.Timestamptz(6)
  lastMessageAt  DateTime           @map("last_message_at") @db.Timestamptz(6)
  messages       AssistantMessage[]

  /// The foreign-key target of the messages.
  @@unique([marketId, id])
  /// The purge reads the conversations of a Market by the age of their last message.
  @@index([marketId, retentionDays, lastMessageAt])
  @@map("conversations")
  @@schema("assistant")
}

/// One message of a conversation, kept only when the retention keeps text. The buyer's text was
/// masked before it was stored; the text is ciphertext under the conversation's subject key.
model AssistantMessage {
  marketId       String                @map("market_id") @db.VarChar(8)
  tenantId       String                @map("tenant_id")
  conversationId String                @map("conversation_id") @db.Uuid
  /// 1, 2, 3 ... in the order written.
  position       Int                   @db.SmallInt
  /// buyer | assistant
  role           String                @db.VarChar(16)
  textCipher     String                @map("text_cipher")
  /// The cards shown with a reply, by kind and id only (product:<offer id>, page:<page>, support).
  cards          String[]              @db.VarChar(64)
  createdAt      DateTime              @map("created_at") @db.Timestamptz(6)
  conversation   AssistantConversation @relation(fields: [marketId, conversationId], references: [marketId, id], onDelete: Cascade, onUpdate: Restrict)

  @@id([marketId, conversationId, position])
  @@map("messages")
  @@schema("assistant")
}

/// A Market's assistant spend for one day of its own calendar (time zone of the Market): counted
/// up by every model call, read against the daily and monthly caps. The auto-off columns record
/// the first cap reached that day (the admin screen's "last auto-off").
model AssistantSpendDay {
  marketId      String    @map("market_id") @db.VarChar(8)
  day           DateTime  @db.Date
  tenantId      String    @map("tenant_id")
  /// Micro US dollars (1e-6 USD), at the configured list price.
  spendMicroUsd BigInt    @map("spend_micro_usd")
  inputTokens   BigInt    @map("input_tokens")
  outputTokens  BigInt    @map("output_tokens")
  conversations Int
  /// daily | monthly; null while no cap was reached that day.
  autoOffCap    String?   @map("auto_off_cap") @db.VarChar(8)
  autoOffAt     DateTime? @map("auto_off_at") @db.Timestamptz(6)

  @@id([marketId, day])
  @@map("spend_days")
  @@schema("assistant")
}
