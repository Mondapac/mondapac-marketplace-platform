// The engagement module's tables (personalization package 1a: shopping behaviour). Every model is
// named Engagement<Name> and mapped to its table with @@map. The CHECKs and the grants are
// hand-written in the migration. An event names an account (identity) or a guest token's hash,
// and products, offers, variants and categories (catalog) by plain ids with no foreign key.

/// One shopping behaviour event: what a signed-in customer or a guest viewed, searched for or
/// added to the cart, by ids (the search text is the only free text and is never logged). Kept
/// 12 months for an account and 30 days for a guest, then deleted by the daily purge; deleted at
/// once when the customer switches personalization off. Never updated.
model EngagementBehaviourEvent {
  id          String   @id @db.Uuid
  marketId    String   @map("market_id") @db.VarChar(8)
  tenantId    String   @map("tenant_id")
  /// The signed-in customer's account; null for a guest.
  accountId   String?  @map("account_id") @db.Uuid
  /// The SHA-256 (hex) of the guest's engagement cookie token; null for an account.
  guestHash   String?  @map("guest_hash") @db.Char(64)
  /// `product-viewed`, `category-viewed`, `search-performed` or `added-to-cart`.
  kind        String   @db.VarChar(32)
  productId   String?  @map("product_id") @db.Uuid
  offerId     String?  @map("offer_id") @db.Uuid
  variantId   String?  @map("variant_id") @db.Uuid
  categoryId  String?  @map("category_id") @db.Uuid
  /// The normalized search text of a `search-performed` event, 1 to 200 characters.
  searchQuery String?  @map("search_query") @db.VarChar(200)
  occurredAt  DateTime @map("occurred_at") @db.Timestamptz(6)

  @@index([marketId, accountId, occurredAt(sort: Desc)])
  @@index([marketId, guestHash, occurredAt(sort: Desc)])
  @@index([marketId, occurredAt])
  @@map("behaviour_events")
  @@schema("engagement")
}

/// A customer's personalization switch (owner decision 4). No row means on; `enabled` false
/// means no behaviour is recorded for the account (what was recorded is deleted when it is
/// switched off).
model EngagementPersonalizationSetting {
  id        String   @id @db.Uuid
  marketId  String   @map("market_id") @db.VarChar(8)
  tenantId  String   @map("tenant_id")
  accountId String   @map("account_id") @db.Uuid
  enabled   Boolean
  changedAt DateTime @map("changed_at") @db.Timestamptz(6)
  createdAt DateTime @map("created_at") @db.Timestamptz(6)

  @@unique([marketId, accountId])
  @@map("personalization_settings")
  @@schema("engagement")
}

/// How often a storefront block (a module placement on a published page) was shown and clicked on
/// one UTC day: two counters per (Market, page, day, placement) and nothing else. Aggregate only:
/// no account, guest token, cookie, IP address, user agent or any other column that could name a
/// person, and no way to tell one visit from another. Plain ids, no foreign keys (the page and its
/// placements are storefront's). Rows older than 13 months are deleted by the daily purge.
model EngagementBlockCount {
  marketId    String   @map("market_id") @db.VarChar(8)
  tenantId    String   @map("tenant_id")
  pageId      String   @map("page_id") @db.Uuid
  /// The placement id as storefront stores it in a page version (a UUIDv7 text).
  placementId String   @map("placement_id") @db.Uuid
  /// The UTC calendar day of the Clock when the event was counted.
  day         DateTime @db.Date
  impressions Int      @default(0)
  clicks      Int      @default(0)
  updatedAt   DateTime @map("updated_at") @db.Timestamptz(6)

  @@id([marketId, pageId, day, placementId])
  @@index([marketId, day])
  @@map("block_counts")
  @@schema("engagement")
}

/// A customer follows a seller's store (customers management phase 3). Added and removed by the
/// customer (one row per account and store; following again after an unfollow is a new row),
/// removed with everything engagement holds when the account is erased. Never updated. The seller is
/// `sellers`' id with no foreign key. The CHECKs and the grants are hand-written in the migration.
model EngagementStoreFollow {
  id         String   @id @db.Uuid
  marketId   String   @map("market_id") @db.VarChar(8)
  tenantId   String   @map("tenant_id")
  accountId  String   @map("account_id") @db.Uuid
  sellerId   String   @map("seller_id") @db.Uuid
  followedAt DateTime @map("followed_at") @db.Timestamptz(6)

  @@unique([marketId, accountId, sellerId])
  /// The customer's "My stores", newest first.
  @@index([marketId, accountId, followedAt(sort: Desc), id(sort: Desc)])
  /// A store's followers (counts).
  @@index([marketId, sellerId, followedAt(sort: Desc)])
  @@map("store_follows")
  @@schema("engagement")
}

/// Engagement's outbox: `engagement.store-followed.v1` and `engagement.store-unfollowed.v1`.
model EngagementOutbox {
  /// UUIDv7 stamped by the outbox writer.
  eventId          String    @id @map("event_id") @db.Uuid
  /// "engagement.<subject>-<verb>.v<N>"; the CHECK refuses another module's type.
  type             String
  /// The instant the use case took from Clock (UTC).
  occurredAt       DateTime  @map("occurred_at") @db.Timestamptz(6)
  /// Market of the unit that wrote the event (ADR-0003); stamped by the writer.
  marketId         String    @map("market_id") @db.VarChar(8)
  /// Tenant seam (ADR-0001); stamped by the writer, no database default.
  tenantId         String    @map("tenant_id")
  aggregateType    String    @map("aggregate_type")
  aggregateId      String    @map("aggregate_id") @db.Uuid
  /// The aggregate's version after the change; unique per aggregate (P 10).
  aggregateVersion Int       @map("aggregate_version")
  correlationId    String    @map("correlation_id")
  /// The consumed event that caused this one, or null.
  causationId      String?   @map("causation_id") @db.Uuid
  payload          Json      @db.JsonB
  /// Set by the relay when the event was handed to the bus; the only column that changes.
  publishedAt      DateTime? @map("published_at") @db.Timestamptz(6)

  /// No two events of one aggregate share a version (I7); led by market_id (data design C7).
  @@unique([marketId, aggregateId, aggregateVersion])
  @@map("outbox")
  @@schema("engagement")
}
