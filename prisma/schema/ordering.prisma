// The ordering module's tables (docs/design/domain/ordering.md, simplified for speed mode). Every
// model is named Ordering<Name> and mapped to its table with @@map. The CHECKs, the partial unique
// indexes and the grants are hand-written in the migration. Money is minor units (BigInt) plus a
// currency; rows of an order are never deleted by the application.

/// One order: a checkout of one customer's cart, paid in one Stripe Checkout session. The order id
/// is also the `checkoutRef` of the inventory reservation and the client reference of the session.
model OrderingOrder {
  id                    String                @id @db.Uuid
  marketId              String                @map("market_id") @db.VarChar(8)
  tenantId              String                @map("tenant_id")
  /// The customer's account id (a plain id, no foreign key).
  accountId             String                @map("account_id") @db.Uuid
  /// pending-payment, confirmed or cancelled (CHECK).
  status                String
  /// Set when cancelled: expired, payment-failed, stock-unavailable, superseded, provider-failed (CHECK).
  cancelReason          String?               @map("cancel_reason")
  /// none, authorised, captured or voided (CHECK). Moves only forward.
  paymentState          String                @map("payment_state")
  currency              String                @db.VarChar(3)
  /// Sum of the seller orders (prices as pricing gives them, plus any tax a price excludes).
  totalAmount           BigInt                @map("total_amount")
  /// The inventory reservation holding the stock while the order is pending.
  reservationId         String                @map("reservation_id") @db.Uuid
  /// Stored before Stripe is called; never replaced by a new key (hybrid handoff, hard rules).
  stripeIdempotencyKey  String                @map("stripe_idempotency_key")
  stripeSessionId       String?               @map("stripe_session_id")
  stripePaymentIntentId String?               @map("stripe_payment_intent_id")
  /// When the Checkout session stops accepting payment.
  paymentExpiresAt      DateTime              @map("payment_expires_at") @db.Timestamptz(6)
  createdAt             DateTime              @map("created_at") @db.Timestamptz(6)
  confirmedAt           DateTime?             @map("confirmed_at") @db.Timestamptz(6)
  cancelledAt           DateTime?             @map("cancelled_at") @db.Timestamptz(6)
  /// Optimistic version of the aggregate; 1 at insert, +1 per change.
  version               Int
  /// The tax strategy the order's tax was worked out under (a plain id, no foreign key); null for
  /// the Market's built-in strategy and on orders placed before tax was recorded (ADR-0039).
  taxStrategyId         String?               @map("tax_strategy_id") @db.Uuid
  /// Personal; the canonical JSON of the delivery address chosen at checkout, sealed under the
  /// customer account's subject key (customers package 2). Written once; null on older orders.
  shipToCiphertext      String?               @map("ship_to_ciphertext")
  sellerOrders          OrderingSellerOrder[]
  lines                 OrderingOrderLine[]

  /// The foreign-key target of the children.
  @@unique([marketId, id])
  /// One Checkout session per order; the key is stored before Stripe is called.
  @@unique([marketId, stripeIdempotencyKey])
  @@index([marketId, accountId, createdAt(sort: Desc)])
  @@index([marketId, status, createdAt(sort: Desc)])
  /// The partial index (market_id, confirmed_at, id) WHERE status = 'confirmed' (nightly bought-together
  /// job) is hand-written in its own migration, built CONCURRENTLY; Prisma cannot declare it.
  @@map("orders")
  @@schema("ordering")
}

/// The part of an order that belongs to one seller (the sub-order). `shippingAmount` is the
/// seller's flat fee at placement (SHP-01). The seller records the shipment and then the delivery.
model OrderingSellerOrder {
  id                   String              @id @db.Uuid
  marketId             String              @map("market_id") @db.VarChar(8)
  tenantId             String              @map("tenant_id")
  orderId              String              @map("order_id") @db.Uuid
  sellerId             String              @map("seller_id") @db.Uuid
  subtotalAmount       BigInt              @map("subtotal_amount")
  shippingAmount       BigInt              @map("shipping_amount")
  /// The tax on the flat shipping fee, frozen at placement beside the rate and the price basis
  /// (ADR-0039 decision 4). All three are null on orders placed before it was recorded (CHECK).
  shippingTaxRateBps   Int?                @map("shipping_tax_rate_bps")
  shippingTaxAmount    BigInt?             @map("shipping_tax_amount")
  shippingTaxInclusive Boolean?            @map("shipping_tax_inclusive")
  totalAmount          BigInt              @map("total_amount")
  /// to-ship, shipped or delivered (CHECK). Moves only forward.
  fulfilment           String
  /// The carrier the seller named when shipping (1 to 60 characters, CHECK).
  carrier              String?
  /// The tracking reference, if the seller had one (1 to 80 characters, CHECK).
  trackingRef          String?             @map("tracking_ref")
  shippedAt            DateTime?           @map("shipped_at") @db.Timestamptz(6)
  deliveredAt          DateTime?           @map("delivered_at") @db.Timestamptz(6)
  /// Set by the worker once inventory has recorded the lines as shipped.
  inventoryRecordedAt  DateTime?           @map("inventory_recorded_at") @db.Timestamptz(6)
  /// pending, recorded or not-applicable (CHECK): whether the worker has written the seller
  /// order into the seller ledger (commission-payouts). Orders placed before the commission rate
  /// was frozen on their lines are not-applicable.
  ledgerState          String              @map("ledger_state")
  /// How many times the ledger refused this seller order; the worker takes the fewest first.
  ledgerAttempts       Int                 @default(0) @map("ledger_attempts")
  /// The gross of the refunds not failed (pending or succeeded); never above the total (CHECK).
  /// Raised under the value read, so two refunds of one seller order cannot both pass (tax step 3).
  refundedAmount       BigInt              @default(0) @map("refunded_amount")
  order                OrderingOrder       @relation(fields: [marketId, orderId], references: [marketId, id], onDelete: Restrict, onUpdate: Restrict)
  lines                OrderingOrderLine[]
  refunds              OrderingRefund[]

  @@unique([marketId, id])
  @@unique([marketId, orderId, sellerId])
  /// The foreign-key target of the refunds: a refund's order and seller are its seller order's.
  @@unique([marketId, id, orderId, sellerId])
  @@index([marketId, sellerId, orderId])
  @@map("seller_orders")
  @@schema("ordering")
}

/// One line of an order: a sell unit, a quantity and the unit price the customer was shown.
model OrderingOrderLine {
  id                String               @id @db.Uuid
  marketId          String               @map("market_id") @db.VarChar(8)
  tenantId          String               @map("tenant_id")
  orderId           String               @map("order_id") @db.Uuid
  sellerOrderId     String               @map("seller_order_id") @db.Uuid
  offerId           String               @map("offer_id") @db.Uuid
  variantId         String               @map("variant_id") @db.Uuid
  quantity          Int
  unitAmount        BigInt               @map("unit_amount")
  lineAmount        BigInt               @map("line_amount")
  /// True when the unit price already includes GST (AU).
  taxInclusive      Boolean              @map("tax_inclusive")
  /// The reservation line this order line commits.
  reservationLineId String               @map("reservation_line_id") @db.Uuid
  /// The commission rate in basis points, frozen when the order was placed (COM-04); null only
  /// on lines placed before the rate was frozen.
  commissionRateBps Int?                 @map("commission_rate_bps")
  /// The tax rate in basis points and the tax of the line in minor units, frozen when the order
  /// was placed (ADR-0039); both null only on lines placed before tax was recorded (CHECK).
  taxRateBps        Int?                 @map("tax_rate_bps")
  taxAmount         BigInt?              @map("tax_amount")
  /// The tax category code of the product at placement (catalog's published revision), frozen
  /// beside the rate; null only on lines placed before it was recorded (CHECK with the rate).
  taxCategoryCode   String?              @map("tax_category_code") @db.VarChar(64)
  order             OrderingOrder        @relation(fields: [marketId, orderId], references: [marketId, id], onDelete: Restrict, onUpdate: Restrict)
  sellerOrder       OrderingSellerOrder  @relation(fields: [marketId, sellerOrderId], references: [marketId, id], onDelete: Restrict, onUpdate: Restrict)
  refundLines       OrderingRefundLine[]

  /// The foreign-key target of the refund lines: a refund line names a line of its own seller
  /// order and copies the line's quantity, which caps the units it refunds (CHECK).
  @@unique([marketId, id, sellerOrderId, quantity])
  @@unique([marketId, orderId, offerId, variantId])
  @@index([marketId, orderId])
  @@map("order_lines")
  @@schema("ordering")
}

/// One refund of part or all of a seller order (tax step 3; ADR-0007 decision 11). The amounts are
/// worked out from the values frozen on the order, never from a current price or rate, and the
/// rows are written once: only the state, the Stripe refund id, the attempts and the settled time
/// change. At most one refund of a seller order is pending (partial unique index).
model OrderingRefund {
  id                   String               @id @db.Uuid
  marketId             String               @map("market_id") @db.VarChar(8)
  tenantId             String               @map("tenant_id")
  orderId              String               @map("order_id") @db.Uuid
  sellerOrderId        String               @map("seller_order_id") @db.Uuid
  sellerId             String               @map("seller_id") @db.Uuid
  currency             String               @db.VarChar(3)
  /// What goes back to the customer, tax included (lines plus shipping); above zero.
  grossAmount          BigInt               @map("gross_amount")
  /// The tax inside `grossAmount` (lines plus shipping).
  taxAmount            BigInt               @map("tax_amount")
  /// The part of the shipping charge refunded (gross) and its tax; zero when none.
  shippingGrossAmount  BigInt               @map("shipping_gross_amount")
  shippingTaxAmount    BigInt               @map("shipping_tax_amount")
  /// The shipping tax rate and price basis frozen on the seller order; null when no shipping.
  shippingTaxRateBps   Int?                 @map("shipping_tax_rate_bps")
  shippingTaxInclusive Boolean?             @map("shipping_tax_inclusive")
  /// not-received, damaged, wrong-item, not-as-described, seller-cancelled or other (CHECK).
  reason               String
  /// Always admin (CHECK; no seller refund path): who asked for the refund, with their account.
  actorPopulation      String               @map("actor_population")
  actorAccountId       String               @map("actor_account_id") @db.Uuid
  /// pending, succeeded or failed (CHECK). Moves only from pending (trigger).
  state                String
  /// Stored before Stripe is called; the same key on every retry.
  stripeIdempotencyKey String               @map("stripe_idempotency_key")
  /// Kept once Stripe made the refund (also while it is pending there); never changes after.
  stripeRefundId       String?              @map("stripe_refund_id")
  /// How many Stripe answers were not final; only grows (trigger).
  attempts             Int                  @default(0)
  requestedAt          DateTime             @map("requested_at") @db.Timestamptz(6)
  settledAt            DateTime?            @map("settled_at") @db.Timestamptz(6)
  sellerOrder          OrderingSellerOrder  @relation(fields: [marketId, sellerOrderId, orderId, sellerId], references: [marketId, id, orderId, sellerId], onDelete: Restrict, onUpdate: Restrict)
  lines                OrderingRefundLine[]
  creditNote           OrderingCreditNote?

  @@unique([marketId, id])
  /// The foreign-key target of the refund lines and the credit note.
  @@unique([marketId, id, sellerOrderId])
  @@unique([marketId, stripeIdempotencyKey])
  @@index([marketId, sellerOrderId])
  @@map("refunds")
  @@schema("ordering")
}

/// The units of one order line a refund gives back, with the tax they reverse (the line's frozen
/// per-unit shares at positions `[units_before, units_before + quantity)`). Written once.
model OrderingRefundLine {
  marketId      String            @map("market_id") @db.VarChar(8)
  tenantId      String            @map("tenant_id")
  refundId      String            @map("refund_id") @db.Uuid
  sellerOrderId String            @map("seller_order_id") @db.Uuid
  orderLineId   String            @map("order_line_id") @db.Uuid
  quantity      Int
  /// The order line's quantity (proven by the foreign key): units never pass it (CHECK).
  lineQuantity  Int               @map("line_quantity")
  /// Units of the line refunded by earlier refunds that had not failed.
  unitsBefore   Int               @map("units_before")
  grossAmount   BigInt            @map("gross_amount")
  taxAmount     BigInt            @map("tax_amount")
  /// The rate and the price basis frozen on the order line.
  taxRateBps    Int               @map("tax_rate_bps")
  taxInclusive  Boolean           @map("tax_inclusive")
  refund        OrderingRefund    @relation(fields: [marketId, refundId, sellerOrderId], references: [marketId, id, sellerOrderId], onDelete: Restrict, onUpdate: Restrict)
  orderLine     OrderingOrderLine @relation(fields: [marketId, orderLineId, sellerOrderId, lineQuantity], references: [marketId, id, sellerOrderId, quantity], onDelete: Restrict, onUpdate: Restrict)

  @@id([marketId, refundId, orderLineId])
  /// Serves no query: it only keeps the order-line foreign key cheap to check.
  @@index([marketId, orderLineId])
  @@map("refund_lines")
  @@schema("ordering")
}

/// The credit note of a refund Stripe made (ADR-0007 decision 11): written once, when the refund
/// succeeds; never changed or deleted. Its lines are the refund's lines. Not yet a numbered
/// adjustment note: gap-free numbering and the wording wait for the tax agent (AG-3, AG-11).
model OrderingCreditNote {
  id            String         @id @db.Uuid
  marketId      String         @map("market_id") @db.VarChar(8)
  tenantId      String         @map("tenant_id")
  refundId      String         @map("refund_id") @db.Uuid
  orderId       String         @map("order_id") @db.Uuid
  sellerOrderId String         @map("seller_order_id") @db.Uuid
  sellerId      String         @map("seller_id") @db.Uuid
  currency      String         @db.VarChar(3)
  grossAmount   BigInt         @map("gross_amount")
  taxAmount     BigInt         @map("tax_amount")
  issuedAt      DateTime       @map("issued_at") @db.Timestamptz(6)
  refund        OrderingRefund @relation(fields: [marketId, refundId, sellerOrderId], references: [marketId, id, sellerOrderId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([marketId, refundId])
  /// The key of the one-to-one refund relation (the pair above is already unique).
  @@unique([marketId, refundId, sellerOrderId])
  @@index([marketId, sellerOrderId])
  @@map("credit_notes")
  @@schema("ordering")
}

/// Events of the ordering module (ADR-0006 decisions 1 and 2). Written only by the platform
/// OutboxWriter in the unit of the state change, read and marked only by the relay. Every outbox of
/// every module has exactly these fields. Payloads hold ids only: no email, name, address or amount.
model OrderingOutbox {
  /// UUIDv7 stamped by the outbox writer.
  eventId          String    @id @map("event_id") @db.Uuid
  /// "ordering.<subject>-<verb>.v<N>"; the CHECK refuses another module's type.
  type             String
  /// The instant the use case took from Clock (UTC).
  occurredAt       DateTime  @map("occurred_at") @db.Timestamptz(6)
  /// Market of the unit that wrote the event (ADR-0003); stamped by the writer.
  marketId         String    @map("market_id") @db.VarChar(8)
  /// Tenant seam (ADR-0001); stamped by the writer, no database default.
  tenantId         String    @map("tenant_id")
  aggregateType    String    @map("aggregate_type")
  aggregateId      String    @map("aggregate_id") @db.Uuid
  /// The aggregate's version after the change; unique per aggregate (P 10).
  aggregateVersion Int       @map("aggregate_version")
  correlationId    String    @map("correlation_id")
  /// The consumed event that caused this one, or null.
  causationId      String?   @map("causation_id") @db.Uuid
  payload          Json      @db.JsonB
  /// Set by the relay when the event was handed to the bus; the only column that changes.
  publishedAt      DateTime? @map("published_at") @db.Timestamptz(6)

  /// No two events of one aggregate share a version (I7); led by market_id (data design C7).
  @@unique([marketId, aggregateId, aggregateVersion])
  @@map("outbox")
  @@schema("ordering")
}

/// Ordering's inbox (P 6.4): one row per consumed event and handler, so a repeated delivery of
/// `ordering.order-paid.v1` (carrier booking) or `shipping.carrier-delivery-progressed.v1`
/// changes nothing. Insert-only.
model OrderingInbox {
  eventId     String   @map("event_id") @db.Uuid
  /// The subscriber's name, "ordering.<handler>".
  handler     String
  marketId    String   @map("market_id") @db.VarChar(8)
  tenantId    String   @map("tenant_id")
  processedAt DateTime @map("processed_at") @db.Timestamptz(6)

  @@id([eventId, handler])
  @@map("inbox")
  @@schema("ordering")
}

/// "Bought together" (personalization 1d-2): for one Offer, the other Offers that appeared with it
/// on at least 3 distinct paid orders over the last 90 days. Rebuilt in full each night by
/// `ordering.rebuild-offer-pairs` (delete and insert per Market, one transaction); both directions
/// are stored, so a read is one primary-key range. Offer ids and an order count only: no account,
/// customer, seller or amount. Plain ids, no foreign keys (the Offers are catalog's).
model OrderingOfferPair {
  marketId      String   @map("market_id") @db.VarChar(8)
  tenantId      String   @map("tenant_id")
  offerId       String   @map("offer_id") @db.Uuid
  pairedOfferId String   @map("paired_offer_id") @db.Uuid
  /// The distinct paid orders that contain both Offers (3 or more, CHECK).
  orders        Int
  computedAt    DateTime @map("computed_at") @db.Timestamptz(6)

  @@id([marketId, offerId, pairedOfferId])
  @@map("offer_pairs")
  @@schema("ordering")
}
