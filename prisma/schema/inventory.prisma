// The inventory module (schema "inventory"). Physical design: docs/design/data/inventory.md;
// every model is named Inventory<Name> (its C9) and mapped to its table with @@map. Slice 1
// creates the inbox, the seller inventory root and its sources; slice 2 adds the outbox, the
// stock items, the ledger, the availability signals and the retirement tombstones; the
// reservations follow, each in its own migration (data design 8.1).

/// Events of the inventory module (ADR-0006 decisions 1 and 2; data design 3.1, PM1). Written
/// only by the platform OutboxWriter in the unit of the state change, read and marked only by
/// the relay (platform/persistence/outbox/). Every outbox of every module has exactly these
/// fields. The only aggregate type is `availability-signal` (inventory design 7.3). The CHECKs,
/// the partial claim index and the grants are hand-written in the migration.
model InventoryOutbox {
  /// UUIDv7 stamped by the outbox writer.
  eventId          String    @id @map("event_id") @db.Uuid
  /// "inventory.<subject>-<verb>.v<N>"; the CHECK refuses another module's type.
  type             String
  /// The instant the use case took from Clock (UTC).
  occurredAt       DateTime  @map("occurred_at") @db.Timestamptz(6)
  /// Market of the unit that wrote the event (ADR-0003); stamped by the writer.
  marketId         String    @map("market_id") @db.VarChar(8)
  /// Tenant seam (ADR-0001); stamped by the writer, no database default.
  tenantId         String    @map("tenant_id")
  aggregateType    String    @map("aggregate_type")
  aggregateId      String    @map("aggregate_id") @db.Uuid
  /// The aggregate's version after the change; unique per aggregate (P 10).
  aggregateVersion Int       @map("aggregate_version")
  correlationId    String    @map("correlation_id")
  /// The consumed event that caused this one, or null.
  causationId      String?   @map("causation_id") @db.Uuid
  payload          Json      @db.JsonB
  /// Set by the relay when the event was handed to the bus; the only column that changes.
  publishedAt      DateTime? @map("published_at") @db.Timestamptz(6)

  /// No two events of one aggregate share a version (I7); led by market_id (data design C7).
  @@unique([marketId, aggregateId, aggregateVersion])
  @@map("outbox")
  @@schema("inventory")
}

/// Events inventory's subscribers have handled (ADR-0006 decision 5; data design 3.1, PM4):
/// `runOnce` inserts (event_id, handler) in the handler's own unit and skips the work when the
/// row exists. Written only by platform/persistence/outbox/. The CHECKs and the grants are
/// hand-written in the migration.
model InventoryInbox {
  eventId     String   @map("event_id") @db.Uuid
  /// The subscriber's name, "inventory.<handler>".
  handler     String
  marketId    String   @map("market_id") @db.VarChar(8)
  tenantId    String   @map("tenant_id")
  processedAt DateTime @map("processed_at") @db.Timestamptz(6)

  @@id([eventId, handler])
  @@map("inbox")
  @@schema("inventory")
}

/// The inventory of one seller in one Market (inventory design 2.1; data design 3.2): the root
/// of its sources and of the optional low-stock threshold. Created by the handler of the
/// approval, with the Default source in the same unit. The CHECK on the threshold is
/// hand-written in the migration.
model InventorySellerInventory {
  id                String            @id @db.Uuid
  marketId          String            @map("market_id") @db.VarChar(8)
  tenantId          String            @map("tenant_id")
  /// The seller id identity minted (C4: a plain id, no foreign key).
  sellerId          String            @map("seller_id") @db.Uuid
  /// The seller's override (Q8); null means the Market default. 0 to 99, by a CHECK.
  lowStockThreshold Int?              @map("low_stock_threshold")
  /// Optimistic version of the aggregate (P 10); 1 at insert. A source change raises it.
  version           Int
  createdAt         DateTime          @map("created_at") @db.Timestamptz(6)
  sources           InventorySource[]

  /// One inventory per seller and Market; the foreign-key target of the sources (3.2).
  @@unique([marketId, sellerId])
  @@map("seller_inventories")
  @@schema("inventory")
}

/// One place a seller keeps stock (inventory design 2.1; data design 3.3), a child entity of
/// the seller inventory. Name, address and zone are the seller's text and may hold personal
/// data. The CHECKs and the partial unique index "at most one Default" are hand-written in the
/// migration; "exactly one Default" and gap-free priorities stay with the aggregate.
model InventorySource {
  id              String                   @id @db.Uuid
  marketId        String                   @map("market_id") @db.VarChar(8)
  tenantId        String                   @map("tenant_id")
  /// The owner; never changes.
  sellerId        String                   @map("seller_id") @db.Uuid
  /// 1 to 80 characters, no outer spaces (CHECK).
  name            String
  /// The source's address (an object), or null: the Default source starts without one (Q-H2).
  address         Json?                    @db.JsonB
  /// An IANA zone id, or null: the seller's own zone (ADR-0005 decision 2).
  timeZone        String?                  @map("time_zone")
  /// Set at creation and never changed.
  isDefault       Boolean                  @map("is_default")
  /// Position 1..n in the seller's order (Q9).
  priority        Int
  createdAt       DateTime                 @map("created_at") @db.Timestamptz(6)
  sellerInventory InventorySellerInventory @relation(fields: [marketId, sellerId], references: [marketId, sellerId], onDelete: Restrict, onUpdate: Restrict)
  stockItems      InventoryStockItem[]

  /// A position is held by one source; also the seller's list in priority order (3.3, T2).
  @@unique([marketId, sellerId, priority])
  /// The foreign-key target of the stock items of slice 2 (C3): their seller is their source's.
  @@unique([marketId, id, sellerId])
  @@map("sources")
  @@schema("inventory")
}

/// The stock of one sell unit (Offer + Variant) in one source (inventory design 2.1, 3.3; data
/// design 3.4). Retired, never deleted (C8). A stock write raises `version`; a reservation does
/// not (C5). The CHECKs and the grants are hand-written in the migration.
model InventoryStockItem {
  id        String                   @id @db.Uuid
  marketId  String                   @map("market_id") @db.VarChar(8)
  tenantId  String                   @map("tenant_id")
  /// The catalog's ids (C4: plain ids, no foreign key).
  offerId   String                   @map("offer_id") @db.Uuid
  variantId String                   @map("variant_id") @db.Uuid
  sourceId  String                   @map("source_id") @db.Uuid
  /// The source's seller, proved by the foreign key (C3).
  sellerId  String                   @map("seller_id") @db.Uuid
  /// Units on hand; 0 or more by a CHECK.
  onHand    Int                      @map("on_hand")
  /// Set once, never cleared (inventory design 3.3).
  retiredAt DateTime?                @map("retired_at") @db.Timestamptz(6)
  version   Int
  createdAt DateTime                 @map("created_at") @db.Timestamptz(6)
  source    InventorySource          @relation(fields: [marketId, sourceId, sellerId], references: [marketId, id, sellerId], onDelete: Restrict, onUpdate: Restrict)
  movements InventoryStockMovement[]

  /// The inventory key (brief s5, ADR-0010 decision 2); its prefix serves "every item of a sell unit".
  @@unique([marketId, offerId, variantId, sourceId])
  /// The foreign-key target of the ledger (C3) and the lock statement's access path.
  @@unique([marketId, id, offerId, variantId])
  /// The seller's own stock, by Offer.
  @@index([marketId, sellerId, offerId])
  @@map("stock_items")
  @@schema("inventory")
}

/// The append-only ledger of every `onHand` change (inventory design 2.1; data design 3.5, V4).
/// `SELECT, INSERT` only, by privilege. The CHECKs and the grants are hand-written.
model InventoryStockMovement {
  id              String             @id @db.Uuid
  marketId        String             @map("market_id") @db.VarChar(8)
  tenantId        String             @map("tenant_id")
  stockItemId     String             @map("stock_item_id") @db.Uuid
  /// Copies of the stock item's ids, proved equal by the foreign key (C3).
  offerId         String             @map("offer_id") @db.Uuid
  variantId       String             @map("variant_id") @db.Uuid
  /// Signed, never 0.
  delta           Int
  resultingOnHand Int                @map("resulting_on_hand")
  /// seller-set, shipment, restock or re-key (CHECK; a new reason needs a migration).
  reason          String
  /// account or module (CHECK).
  actorKind       String             @map("actor_kind")
  actorAccountId  String?            @map("actor_account_id") @db.Uuid
  actorModule     String?            @map("actor_module")
  correlationId   String             @map("correlation_id")
  occurredAt      DateTime           @map("occurred_at") @db.Timestamptz(6)
  stockItem       InventoryStockItem @relation(fields: [marketId, stockItemId, offerId, variantId], references: [marketId, id, offerId, variantId], onDelete: Restrict, onUpdate: Restrict)

  /// The ledger of one stock item, newest first, keyset on (occurred_at, id).
  @@index([marketId, stockItemId, occurredAt, id])
  @@map("stock_movements")
  @@schema("inventory")
}

/// The published availability of one sell unit (inventory design 2.1, 7.3; data design 3.9);
/// the maximum over its sources (Q10). Not the read model of `getAvailability`, which is
/// computed. `version` equals the last event's `aggregate_version`.
model InventoryAvailabilitySignal {
  id        String   @id @db.Uuid
  marketId  String   @map("market_id") @db.VarChar(8)
  tenantId  String   @map("tenant_id")
  offerId   String   @map("offer_id") @db.Uuid
  variantId String   @map("variant_id") @db.Uuid
  sellerId  String   @map("seller_id") @db.Uuid
  /// in-stock, low or out (CHECK).
  status    String
  /// Set exactly when `status` is low, 1 to 99 (CHECK).
  onlyLeft  Int?     @map("only_left")
  changedAt DateTime @map("changed_at") @db.Timestamptz(6)
  version   Int

  /// One signal per sell unit; the first recompute creates it.
  @@unique([marketId, offerId, variantId])
  @@map("availability_signals")
  @@schema("inventory")
}

/// A catalog retirement tombstone (inventory design 3.5; data design 3.10): a stock write that
/// arrives after the Offer or Variant was retired does not re-create a row. The two partial
/// unique indexes (one per scope) are hand-written; Prisma cannot declare NULLS NOT DISTINCT.
model InventoryRetirement {
  id                     String   @id @db.Uuid
  marketId               String   @map("market_id") @db.VarChar(8)
  tenantId               String   @map("tenant_id")
  /// offer or variant (CHECK).
  scope                  String
  offerId                String   @map("offer_id") @db.Uuid
  /// Set exactly when `scope` is variant (CHECK).
  variantId              String?  @map("variant_id") @db.Uuid
  /// The aggregate_version of the catalog event that retired it; kept for audit only.
  sourceAggregateVersion Int      @map("source_aggregate_version")
  retiredAt              DateTime @map("retired_at") @db.Timestamptz(6)

  @@map("retirements")
  @@schema("inventory")
}
