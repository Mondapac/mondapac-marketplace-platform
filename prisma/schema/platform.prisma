// Platform infrastructure tables (schema "platform"). Not a business module: these tables
// are written through platform/* services only (ADR-0004 decision 7, ADR-0008).
// Physical design and the hand-written migration SQL: docs/design/data/platform.md

/// Append-only audit trail (ADR-0004 decision 7, ADR-0009 pattern V4; IMP-10, CERT-32,
/// IMP-06/SEL-08). Rows are never updated or deleted: a database trigger rejects UPDATE,
/// DELETE and TRUNCATE. CHECK constraints and the triggers are hand-written in the
/// migration because Prisma cannot express them.
/// No personal data in any column: actors and targets are opaque ids, and before/after
/// hold allow-listed non-personal fields only (ADR-0009 decision 6).
model AuditLog {
  /// UUIDv7 generated by platform/audit.
  id            String         @id @db.Uuid
  /// Market code. Mandatory: every audited action resolves to exactly one market (ADR-0003).
  marketId      String         @map("market_id") @db.VarChar(8)
  /// Tenant seam (ADR-0001). Supplied by the writer; deliberately no database default.
  tenantId      String         @map("tenant_id")
  /// Instant of the audited action, from the injected Clock (ADR-0005), UTC, in whole
  /// milliseconds (CHECK audit_log_occurred_at_check; docs/design/data/platform.md 11.2).
  occurredAt    DateTime       @map("occurred_at") @db.Timestamptz(6)
  /// USER = an authenticated principal (actor_id required); SYSTEM = job, worker or relay;
  /// ANONYMOUS = a request with no session whose credential binds one account or invitation,
  /// named in target_id or after.boundSubjectId (docs/design/domain/platform-audit.md W4a).
  actorType     String         @map("actor_type")
  /// identity user id of the real actor. Plain id, no FK across schemas.
  actorId       String?        @map("actor_id") @db.Uuid
  /// During impersonation (SEL-08, IMP-06): the user the actor was acting as.
  actingAsId    String?        @map("acting_as_id") @db.Uuid
  /// Stable action code, "<module>.<subject>.<verb>", e.g. "certification.seller-certification.approved".
  action        String
  /// Aggregate or record type of the target, "<module>.<type>", e.g. "certification.seller-certification".
  targetType    String         @map("target_type")
  /// Target identifier as text: usually a UUID, but some targets have natural keys (a market code, a config key).
  targetId      String         @map("target_id")
  /// State before the change (null for creations). JSON object, non-personal fields only.
  before        Json?          @db.JsonB
  /// State after the change (null for deletions). JSON object, non-personal fields only.
  after         Json?          @db.JsonB
  /// Correlation id of the request, job run or event that caused the action.
  correlationId String         @map("correlation_id")
  /// Seals of this row, at most one per chain epoch (docs/design/data/platform.md 11.3).
  seals         AuditLogSeal[]

  /// Admin audit list and the sealer's keyset on (occurred_at, id); referenced by the seal's foreign key.
  @@unique([marketId, occurredAt, id], map: "audit_log_market_id_occurred_at_id_key")
  /// Audit history of one entity (CERT-32: a certification's decisions), newest first.
  @@index([marketId, targetType, targetId, occurredAt], map: "audit_log_market_id_target_type_target_id_occurred_at_idx")
  /// What one actor did (IMP-06: review of an admin's actions and impersonation sessions).
  @@index([marketId, actorId, occurredAt], map: "audit_log_market_id_actor_id_occurred_at_idx")
  @@map("audit_log")
  @@schema("platform")
}

/// One seal of one audit row in one chain epoch: the hash chain of the audit log (ADR-0009
/// V4; docs/design/domain/platform-audit.md 6; physical design docs/design/data/platform.md
/// 11.3). Append-only: a database trigger rejects UPDATE, DELETE and TRUNCATE for every role,
/// and the application holds SELECT and INSERT only. Written only by the sealer in
/// platform/persistence/audit/ (identity slice 6b). The CHECKs and the triggers are
/// hand-written in the migration. No personal data: ids, times and hashes only.
model AuditLogSeal {
  marketId        String   @map("market_id") @db.VarChar(8)
  /// Tenant seam (ADR-0001), from the sealer's context; no database default.
  tenantId        String   @map("tenant_id")
  /// Chain epoch, 1 from the first seal; a new epoch only through the recovery command (11.13). No default.
  epoch           Int
  /// 1, 2, 3, ... per Market and epoch.
  chainSeq        BigInt   @map("chain_seq")
  /// The sealed audit row.
  auditLogId      String   @map("audit_log_id") @db.Uuid
  /// Copy of the row's occurred_at, kept equal by the foreign key (11.3).
  auditOccurredAt DateTime @map("audit_occurred_at") @db.Timestamptz(6)
  /// 32 bytes: SHA-256 of the canonical row (platform-audit.md 6.2).
  rowHash         Bytes    @map("row_hash")
  /// 32 bytes: SHA-256 of the link, with hash_version and epoch in its input (6.2).
  chainHash       Bytes    @map("chain_hash")
  /// Sealed below the watermark (6.1 option A); part of the chain hash.
  late            Boolean
  /// 1 today (6.2).
  hashVersion     Int      @map("hash_version") @db.SmallInt
  /// From the sealer's Clock; not part of any hash.
  sealedAt        DateTime @map("sealed_at") @db.Timestamptz(6)
  auditLog        AuditLog @relation(fields: [marketId, auditOccurredAt, auditLogId], references: [marketId, occurredAt, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([marketId, epoch, chainSeq], map: "audit_log_seal_pkey")
  @@unique([marketId, epoch, auditOccurredAt, auditLogId], map: "audit_log_seal_market_id_epoch_occurred_at_id_key")
  @@map("audit_log_seal")
  @@schema("platform")
}

/// A chain head at checkpoint time, also sent to the anchor (docs/design/domain/platform-audit.md
/// 7.1 step 5 and 8; docs/design/data/platform.md 11.4). Append-only like the seal; no foreign
/// key to the seal, because checkpoints outlive dropped seals. The CHECKs and the triggers are
/// hand-written in the migration. No personal data.
model AuditChainCheckpoint {
  marketId    String   @map("market_id") @db.VarChar(8)
  /// Tenant seam (ADR-0001); no database default.
  tenantId    String   @map("tenant_id")
  /// The epoch of the checkpointed seal.
  epoch       Int
  /// The head at checkpoint time.
  chainSeq    BigInt   @map("chain_seq")
  /// 32 bytes: the chain_hash of that seal.
  chainHash   Bytes    @map("chain_hash")
  hashVersion Int      @map("hash_version") @db.SmallInt
  /// From the sealer's Clock.
  createdAt   DateTime @map("created_at") @db.Timestamptz(6)

  @@id([marketId, epoch, chainSeq], map: "audit_chain_checkpoint_pkey")
  @@map("audit_chain_checkpoint")
  @@schema("platform")
}

/// One wrapped data key per subject (platform-foundations design 4; ADR-0009 decisions 6 and
/// 8; docs/design/data/identity.md 3.2). Read and written only by the SubjectKeyService through
/// its store in platform/persistence/. A subject has one key for life: the primary key on the
/// subject refuses a second one, in any Market. Destroying the key sets wrapped_key to NULL and
/// keeps the row as a tombstone; a hand-written trigger makes that one-way and freezes the
/// identity columns for every role, and the application has no DELETE. CHECKs, the trigger
/// and the column-level grants are hand-written in the migration. Not personal data: an
/// opaque id and ciphertext.
model SubjectKey {
  /// An account id or a seller id; the table does not record which (ids never repeat across kinds).
  subjectId     String    @id @map("subject_id") @db.Uuid
  /// Market of the subject (ADR-0003); bound into the wrap, so a row moved to another Market does not unwrap.
  marketId      String    @map("market_id") @db.VarChar(8)
  /// Tenant seam (ADR-0001); supplied by the writer, no database default. Not bound into the wrap.
  tenantId      String    @map("tenant_id")
  /// Always 1 in Phase 2; part of the wrap binding (PF 4 row 10).
  keyVersion    Int       @map("key_version")
  /// The data key wrapped under the regional wrapping key, as a versioned text envelope; NULL once destroyed.
  wrappedKey    String?   @map("wrapped_key")
  /// Which regional wrapping key and version wrapped it (PF 4 row 2).
  wrappingKeyId String    @map("wrapping_key_id")
  /// From Clock, UTC.
  createdAt     DateTime  @map("created_at") @db.Timestamptz(6)
  /// The last rotation of the wrapping key.
  rewrappedAt   DateTime? @map("rewrapped_at") @db.Timestamptz(6)
  /// Set by destroyKey; the row stays as a tombstone.
  destroyedAt   DateTime? @map("destroyed_at") @db.Timestamptz(6)

  @@map("subject_keys")
  @@schema("platform")
}

/// One delivery of one event to one subscriber (ADR-0006 decisions 4 and 5; platform persistence
/// design 6.4, PM3; docs/design/data/identity.md 3.8): the work queue of the in-process event
/// bus, its retries and its dead letters. The relay's bus inserts a row per event and
/// subscriber in the relay's transaction, ignoring a repeated key; the dispatcher claims due
/// rows with FOR UPDATE SKIP LOCKED; the subscriber's unit marks its row delivered (runOnce).
/// The envelope is a copy of the outbox row, so the dispatcher never reads a module schema, and
/// it is never updated. Ids, codes and permission keys only: no personal data in any column.
/// The CHECKs, the partial claim index and the column-level grants are hand-written in the
/// migration.
model EventDelivery {
  /// The event's id (the outbox row's event_id).
  eventId          String    @map("event_id") @db.Uuid
  /// "<module>.<handler>": the subscription that receives the event.
  subscriber       String
  marketId         String    @map("market_id") @db.VarChar(8)
  tenantId         String    @map("tenant_id")
  /// pending | delivered | dead.
  status           String
  /// Claims so far; each claim counts one.
  attempts         Int
  /// When the row is next due; moved forward by the back-off at every claim.
  nextAttemptAt    DateTime  @map("next_attempt_at") @db.Timestamptz(6)
  /// The envelope copy (data design 3.1); never updated.
  type             String
  occurredAt       DateTime  @map("occurred_at") @db.Timestamptz(6)
  aggregateType    String    @map("aggregate_type")
  aggregateId      String    @map("aggregate_id") @db.Uuid
  aggregateVersion Int       @map("aggregate_version")
  correlationId    String    @map("correlation_id")
  causationId      String?   @map("causation_id") @db.Uuid
  payload          Json      @db.JsonB
  /// The last failure, as a code; never a message or a row value (P 12.3).
  errorCode        String?   @map("error_code")
  createdAt        DateTime  @map("created_at") @db.Timestamptz(6)
  deliveredAt      DateTime? @map("delivered_at") @db.Timestamptz(6)
  deadAt           DateTime? @map("dead_at") @db.Timestamptz(6)

  /// ADR-0006 decision 4: one row per event and subscriber.
  @@id([eventId, subscriber])
  @@map("event_delivery")
  @@schema("platform")
}

/// @market-scope none: the generic per-origin rate limiter counts across Markets (PF I11).
/// One fixed window per limit class and origin of the generic rate limiter (identity design 6.8
/// and 13; buyer scale-out item (a)), shared by every API instance. Written only by the
/// PostgreSQL store of `rate-limiter-flexible` through platform/persistence/, whose statements
/// fix the column names, their order and the key shape ("<limit class>:<origin key>"). The key
/// holds the keyed hash of the origin, never an address (identity data design HF3). Transient:
/// the store deletes windows that ended over an hour ago. CHECKs and grants are hand-written in
/// the migration.
model RateLimitCounter {
  /// "<limit class>:<64 lowercase hex of HMAC-SHA-256 of the origin>".
  key    String @id @db.VarChar(255)
  /// Requests counted in the window.
  points Int
  /// End of the window, epoch milliseconds (the package's clock).
  expire BigInt

  @@map("rate_limit_counters")
  @@schema("platform")
}

/// One security event (SOC package 1; design docs/design/data/platform.md 13): a sign-in outcome, a
/// second-factor failure, a password change, a webhook whose signature failed, or a
/// security-relevant audited action (a role, a switch, a payout account) projected from the
/// audit writer in the same unit. Written only through `SecurityEvents` (and the audit
/// writer's projection) in platform/persistence/audit/; no repository reaches it.
/// Insert-only for every role, the owner included: a hand-written trigger rejects UPDATE and
/// TRUNCATE, and rejects DELETE of a row younger than 90 days, so only the retention job can
/// move a row out (to the archive, in the same unit). No secret in any column: never a
/// password, code, token, card number or email; actors and targets are ids, the payload holds
/// declared ids, codes, integers, booleans and instants only, and the address only on the
/// types that declare it. CHECKs, the trigger and the grants are hand-written in the migration.
model SecurityEvent {
  /// UUIDv7 generated by the writer.
  id            String   @id @db.Uuid
  marketId      String   @map("market_id") @db.VarChar(8)
  tenantId      String   @map("tenant_id")
  /// From the injected Clock, UTC, whole milliseconds.
  occurredAt    DateTime @map("occurred_at") @db.Timestamptz(6)
  /// "<owner>.<subject>.<verb>", from the closed catalogue in platform/security-events/.
  type          String
  /// s1 (critical) to s4 (low), fixed per type by the catalogue (plan section 4).
  severity      String
  /// USER | SYSTEM | ANONYMOUS, from the call context, as in the audit log.
  actorType     String   @map("actor_type")
  /// The authenticated account; null for SYSTEM and ANONYMOUS.
  actorId       String?  @map("actor_id") @db.Uuid
  /// What the event is about: "account", "role", "market", "seller", ... or null.
  targetType    String?  @map("target_type")
  /// The target's id as text (a UUID, or a natural key such as a Market code).
  targetId      String?  @map("target_id")
  /// The client address (IPv4, or IPv6 in canonical form), only on types that declare it.
  ip            String?  @db.Inet
  /// The declared payload fields of the type; `{}` when it declares none.
  payload       Json     @db.JsonB
  /// Correlation id of the request, job run or event that caused it.
  correlationId String   @map("correlation_id")

  /// Recent events of a Market, newest first, and the retention job's scan (occurred_at, id).
  @@unique([marketId, occurredAt, id], map: "security_events_market_id_occurred_at_id_key")
  /// Events of one type in a window (the rules of package 2: failures per window).
  @@index([marketId, type, occurredAt], map: "security_events_market_id_type_occurred_at_idx")
  /// Events about one target (an account's failures, a role's changes).
  @@index([marketId, targetType, targetId, occurredAt], map: "security_events_market_id_target_type_target_id_occurred_at_idx")
  @@map("security_events")
  @@schema("platform")
}

/// The archive of security events (SOC decision T6): a row moves here, unchanged, when it is
/// 90 days old, and is deleted 90 + 365 days after it occurred. Same columns as
/// `security_events` plus `archived_at`; insert-only like it: hand-written triggers accept only
/// an identical copy of a row of `security_events`, reject UPDATE and TRUNCATE, and reject
/// DELETE of a row that occurred less than 454 days ago. Written and purged only by the
/// retention job.
model SecurityEventArchive {
  id            String   @id @db.Uuid
  marketId      String   @map("market_id") @db.VarChar(8)
  tenantId      String   @map("tenant_id")
  occurredAt    DateTime @map("occurred_at") @db.Timestamptz(6)
  type          String
  severity      String
  actorType     String   @map("actor_type")
  actorId       String?  @map("actor_id") @db.Uuid
  targetType    String?  @map("target_type")
  targetId      String?  @map("target_id")
  ip            String?  @db.Inet
  payload       Json     @db.JsonB
  correlationId String   @map("correlation_id")
  /// When the retention job moved it here, from the injected Clock.
  archivedAt    DateTime @map("archived_at") @db.Timestamptz(6)

  /// The purge scan and investigations over the archive, by occurrence.
  @@unique([marketId, occurredAt, id], map: "security_events_archive_market_id_occurred_at_id_key")
  @@map("security_events_archive")
  @@schema("platform")
}

/// One model call through the AI Gateway (docs/design/domain/platform-ai.md section 10): which
/// capability, route and attempt, the tokens, the unit price used, the cost, the latency and the
/// outcome. Never any text, customer id, IP or personal key; a seller id only for a seller-scoped
/// capability. Kept 90 days, then the retention job `platform.ai-usage-retention` deletes it in
/// batches (no partitions). Written and purged only by platform/persistence/ai-usage/. CHECKs and
/// the grants are hand-written in the migration.
model AiCall {
  /// The gateway's call id (UUIDv7), also the id of the call's budget reservation.
  id            String   @id @db.Uuid
  marketId      String   @map("market_id") @db.VarChar(8)
  tenantId      String   @map("tenant_id")
  /// When the call was sent, from the injected Clock.
  occurredAt    DateTime @map("occurred_at") @db.Timestamptz(6)
  /// The Market day (Market time zone) the call is counted on: the day of its reservation.
  day           DateTime @db.Date
  /// The registered capability id, `<module>.<name>`.
  capability    String   @db.VarChar(100)
  /// Seller-scoped capabilities only; a plain id, no FK across schemas.
  sellerId      String?  @map("seller_id") @db.Uuid
  /// A buyer capability called by an anonymous visitor (the guest pool).
  guest         Boolean
  provider      String   @db.VarChar(40)
  model         String   @db.VarChar(200)
  /// 1 for the first try; G3 adds fallbacks.
  attempt       Int      @db.SmallInt
  inputTokens   Int      @map("input_tokens")
  outputTokens  Int      @map("output_tokens")
  /// The unit prices the cost was counted at, pico US dollars per token.
  inputPicoUsd  BigInt   @map("input_pico_usd")
  outputPicoUsd BigInt   @map("output_pico_usd")
  /// US micro-dollars; on a timeout the most the call can cost.
  costMicroUsd  BigInt   @map("cost_micro_usd")
  latencyMs     Int      @map("latency_ms")
  /// ok | timeout | unavailable (CHECK).
  outcome       String   @db.VarChar(20)

  /// The retention scan, oldest first.
  @@index([marketId, occurredAt, id], map: "ai_calls_market_id_occurred_at_id_idx")
  @@map("ai_calls")
  @@schema("platform")
}

/// Daily totals of the AI Gateway per Market, capability and seller (platform-ai.md sections 10
/// and 11): calls, failures, budget refusals, tokens, settled cost and latency counts in fixed
/// buckets, from which p50 and p95 are read. Kept 25 months. One row per (market, day,
/// capability, seller): the unique index is NULLS NOT DISTINCT in the migration (no seller is
/// null). Written only by platform/persistence/ai-usage/.
model AiUsageDay {
  /// UUIDv7; the natural key is the hand-written unique index below.
  id               String   @id @db.Uuid
  marketId         String   @map("market_id") @db.VarChar(8)
  tenantId         String   @map("tenant_id")
  day              DateTime @db.Date
  capability       String   @db.VarChar(100)
  sellerId         String?  @map("seller_id") @db.Uuid
  calls            Int      @default(0)
  failures         Int      @default(0)
  /// Calls answered by a fallback route (G3); 0 until then.
  fallbacks        Int      @default(0)
  /// Runs refused before any call: a full cap, too large an input, too many rounds.
  refusals         Int      @default(0)
  inputTokens      BigInt   @default(0) @map("input_tokens")
  outputTokens     BigInt   @default(0) @map("output_tokens")
  costMicroUsd     BigInt   @default(0) @map("cost_micro_usd")
  /// Latency counts: calls that took at most 500 ms, 1, 2, 4, 8, 16 and 32 s, and longer.
  latencyLe500Ms   Int      @default(0) @map("latency_le_500_ms")
  latencyLe1000Ms  Int      @default(0) @map("latency_le_1000_ms")
  latencyLe2000Ms  Int      @default(0) @map("latency_le_2000_ms")
  latencyLe4000Ms  Int      @default(0) @map("latency_le_4000_ms")
  latencyLe8000Ms  Int      @default(0) @map("latency_le_8000_ms")
  latencyLe16000Ms Int      @default(0) @map("latency_le_16000_ms")
  latencyLe32000Ms Int      @default(0) @map("latency_le_32000_ms")
  latencyGt32000Ms Int      @default(0) @map("latency_gt_32000_ms")

  /// NULLS NOT DISTINCT in the migration (Prisma cannot declare it).
  @@unique([marketId, day, capability, sellerId], map: "ai_usage_days_market_id_day_capability_seller_id_key")
  @@map("ai_usage_days")
  @@schema("platform")
}

/// The AI budget counters (platform-ai.md sections 7 and 10): one row per Market, period (day or
/// month, in the Market's time zone) and cap scope (the Market, one capability, one seller, the
/// guest pool). `held` is settled plus reserved spend; a reservation adds to `held` only while
/// `held + estimate <= cap`, one conditional UPDATE per row, in a fixed order. Settling corrects
/// `held` and adds to `spent`. Kept 25 months. Written only by platform/persistence/ai-usage/.
model AiBudgetCounter {
  marketId      String   @map("market_id") @db.VarChar(8)
  tenantId      String   @map("tenant_id")
  /// day | month (CHECK).
  period        String   @db.VarChar(5)
  /// The day, or the first day of the month.
  periodStart   DateTime @map("period_start") @db.Date
  /// market | capability | seller | guest (CHECK).
  scope         String   @db.VarChar(10)
  /// The capability id or the seller id; '' for the Market and the guest pool.
  scopeKey      String   @map("scope_key") @db.VarChar(100)
  /// Settled plus reserved, US micro-dollars.
  heldMicroUsd  BigInt   @default(0) @map("held_micro_usd")
  /// Settled only, US micro-dollars.
  spentMicroUsd BigInt   @default(0) @map("spent_micro_usd")

  @@id([marketId, period, periodStart, scope, scopeKey], map: "ai_budget_counters_pkey")
  @@map("ai_budget_counters")
  @@schema("platform")
}

/// A budget reservation of one AI call (platform-ai.md section 10): the most the call can cost,
/// held on the counters of its scope until the call is settled. Settling deletes it (DELETE
/// once, so a second settle changes nothing); one a server never settled expires and the job
/// `platform.ai-reservation-sweeper` releases it. Lives minutes. Written only by
/// platform/persistence/ai-usage/.
model AiBudgetReservation {
  /// The call id.
  id               String   @id @db.Uuid
  marketId         String   @map("market_id") @db.VarChar(8)
  tenantId         String   @map("tenant_id")
  /// The Market day the counters were reserved on; the settle is written to it.
  day              DateTime @db.Date
  capability       String   @db.VarChar(100)
  sellerId         String?  @map("seller_id") @db.Uuid
  guest            Boolean
  estimateMicroUsd BigInt   @map("estimate_micro_usd")
  createdAt        DateTime @map("created_at") @db.Timestamptz(6)
  expiresAt        DateTime @map("expires_at") @db.Timestamptz(6)

  /// The sweeper's scan, soonest first.
  @@index([marketId, expiresAt, id], map: "ai_budget_reservations_market_id_expires_at_id_idx")
  @@map("ai_budget_reservations")
  @@schema("platform")
}
