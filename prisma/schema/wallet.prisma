// The wallet module's tables (customer wallet package 1, ledger core; store credit issued by the
// platform, no card or bank data). Every model is named Wallet<Name> and mapped to its table with
// @@map. The CHECKs, the insert-only and guard triggers, the balanced-journal constraint trigger
// and the grants are hand-written in the migration. Money is minor units (BigInt) plus a currency.

/// A wallet account: the customer's own (`credit_liability`, one per customer) or an internal
/// account of the Market (`promo_expense`, `refund_clearing`, `order_clearing`, `holds`,
/// `breakage_income`; `customer_account_id` null, one per kind). Only `status` changes.
model WalletAccount {
  id                String   @id @db.Uuid
  marketId          String   @map("market_id") @db.VarChar(8)
  tenantId          String   @map("tenant_id")
  /// credit_liability, promo_expense, refund_clearing, order_clearing, holds or breakage_income (CHECK).
  kind              String
  /// Set if and only if `kind` is credit_liability (CHECK). A plain id, no foreign key.
  customerAccountId String?  @map("customer_account_id") @db.Uuid
  currency          String   @db.VarChar(3)
  /// active, frozen or closed (CHECK).
  status            String
  createdAt         DateTime @map("created_at") @db.Timestamptz(6)

  lots     WalletLot[]
  holds    WalletHold[]
  postings WalletPosting[]
  journals WalletJournal[]
  balances WalletBalance[]

  // The target of the composite, market-scoped foreign keys of the other tables.
  @@unique([marketId, id])
  // Ties a lot, a hold or a balance to its wallet's currency.
  @@unique([marketId, id, currency])
  // One account per kind and customer; internal accounts have no customer (NULLS NOT DISTINCT in the migration).
  @@unique([marketId, kind, customerAccountId])
  @@map("accounts")
  @@schema("wallet")
}

/// One money fact. Insert-only. `(market_id, idempotency_key)` is unique; `fingerprint` is the
/// canonical form of the request, so the same key with another request is refused; `result` is
/// the first answer, returned again on a replay.
model WalletJournal {
  id              String   @id @db.Uuid
  marketId        String   @map("market_id") @db.VarChar(8)
  tenantId        String   @map("tenant_id")
  /// grant-promo, grant-refund, hold, capture, release, expire or reverse (CHECK).
  kind            String
  idempotencyKey  String   @map("idempotency_key")
  fingerprint     String
  /// system, admin or customer (CHECK); the id is null for the system.
  actorKind       String   @map("actor_kind")
  actorId         String?  @map("actor_id") @db.Uuid
  reasonCode      String   @map("reason_code")
  orderId         String?  @map("order_id") @db.Uuid
  /// The wallet this journal belongs to (the customer side), for history. Null only for
  /// `reverse` (CHECK); the foreign key is then skipped (MATCH SIMPLE), as intended.
  walletAccountId String?  @map("wallet_account_id") @db.Uuid
  /// The hold of a hold, capture or release journal; null for every other kind (CHECK). No
  /// foreign key by design: the journal is written before its hold row. Consistency is kept by
  /// the CHECK and the commit-time checks (check_hold_settled, books, lot ledger).
  holdId          String?  @map("hold_id") @db.Uuid
  /// The lot an expire journal expires; null for every other kind (CHECK). No foreign key, like
  /// holdId; the lot ledger check at commit requires a lot of the journal's wallet.
  lotId           String?  @map("lot_id") @db.Uuid
  result          Json
  createdAt       DateTime @map("created_at") @db.Timestamptz(6)

  wallet              WalletAccount?             @relation(fields: [marketId, walletAccountId], references: [marketId, id], onDelete: Restrict, onUpdate: Restrict)
  postings            WalletPosting[]
  lots                WalletLot[]
  adminCreditRequests WalletAdminCreditRequest[]

  @@unique([marketId, id])
  @@unique([marketId, idempotencyKey])
  @@index([marketId, walletAccountId, createdAt(sort: Desc), id(sort: Desc)])
  /// Partial (hold_id IS NOT NULL) in the migration: the journals of one hold.
  @@index([marketId, holdId])
  /// Partial (lot_id IS NOT NULL) in the migration: the expire journals of one lot.
  @@index([marketId, lotId])
  @@map("journals")
  @@schema("wallet")
}

/// One signed leg of a journal. Insert-only. The legs of a journal sum to zero and are at least
/// two (deferred constraint trigger).
model WalletPosting {
  id              String  @id @db.Uuid
  marketId        String  @map("market_id") @db.VarChar(8)
  tenantId        String  @map("tenant_id")
  journalId       String  @map("journal_id") @db.Uuid
  accountId       String  @map("account_id") @db.Uuid
  /// Signed minor units, never zero (CHECK).
  amountMinor     BigInt  @map("amount_minor")
  currency        String  @db.VarChar(3)
  /// The customer wallet of the journal, copied onto every leg (trigger-checked), so the books
  /// check sums one wallet's legs from an index.
  walletAccountId String? @map("wallet_account_id") @db.Uuid

  journal WalletJournal @relation(fields: [marketId, journalId], references: [marketId, id], onDelete: Restrict, onUpdate: Restrict)
  account WalletAccount @relation(fields: [marketId, accountId], references: [marketId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([marketId, journalId])
  /// The amount last, so the per-account sums read the index only.
  @@index([marketId, accountId, amountMinor])
  /// One wallet's legs by account, amount last: the books check reads the index only.
  @@index([marketId, walletAccountId, accountId, amountMinor])
  @@map("postings")
  @@schema("wallet")
}

/// One credit grant. Only `remaining_minor` changes (guard trigger: it only decreases, except a
/// released or expired hold restores what it took).
model WalletLot {
  id              String    @id @db.Uuid
  marketId        String    @map("market_id") @db.VarChar(8)
  tenantId        String    @map("tenant_id")
  walletAccountId String    @map("wallet_account_id") @db.Uuid
  /// promo or refund (CHECK).
  source          String
  journalId       String    @map("journal_id") @db.Uuid
  originalMinor   BigInt    @map("original_minor")
  remainingMinor  BigInt    @map("remaining_minor")
  currency        String    @db.VarChar(3)
  /// Null for refund credit, which never expires; set for promo credit (CHECK).
  expiresAt       DateTime? @map("expires_at") @db.Timestamptz(6)
  createdAt       DateTime  @map("created_at") @db.Timestamptz(6)

  wallet   WalletAccount   @relation(fields: [marketId, walletAccountId, currency], references: [marketId, id, currency], onDelete: Restrict, onUpdate: Restrict)
  journal  WalletJournal   @relation(fields: [marketId, journalId], references: [marketId, id], onDelete: Restrict, onUpdate: Restrict)
  holdLots WalletHoldLot[]

  @@unique([marketId, id])
  @@index([marketId, walletAccountId, remainingMinor])
  /// Partial (source = 'promo' AND remaining_minor > 0) in the migration: the due promo lots.
  @@index([marketId, expiresAt, id])
  @@map("lots")
  @@schema("wallet")
}

/// The money set aside for one order. Only `status` and `resolved_at` change, and only from `held`.
model WalletHold {
  id              String    @id @db.Uuid
  marketId        String    @map("market_id") @db.VarChar(8)
  tenantId        String    @map("tenant_id")
  walletAccountId String    @map("wallet_account_id") @db.Uuid
  /// A plain ordering id; one hold per order.
  orderId         String    @map("order_id") @db.Uuid
  amountMinor     BigInt    @map("amount_minor")
  currency        String    @db.VarChar(3)
  /// held, captured, released or expired (CHECK).
  status          String
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt       DateTime  @map("created_at") @db.Timestamptz(6)
  resolvedAt      DateTime? @map("resolved_at") @db.Timestamptz(6)

  wallet   WalletAccount   @relation(fields: [marketId, walletAccountId, currency], references: [marketId, id, currency], onDelete: Restrict, onUpdate: Restrict)
  holdLots WalletHoldLot[]

  @@unique([marketId, id])
  @@unique([marketId, orderId])
  /// Partial (status = 'held') in the migration: the held holds, oldest first.
  @@index([marketId, expiresAt, id])
  /// Partial (status = 'held') in the migration: one wallet's held holds, amount last.
  @@index([marketId, walletAccountId, amountMinor])
  @@map("holds")
  @@schema("wallet")
}

/// Which lots a hold took and how much, so a release restores the exact lots. Insert-only.
model WalletHoldLot {
  holdId      String @map("hold_id") @db.Uuid
  lotId       String @map("lot_id") @db.Uuid
  marketId    String @map("market_id") @db.VarChar(8)
  tenantId    String @map("tenant_id")
  amountMinor BigInt @map("amount_minor")

  hold WalletHold @relation(fields: [marketId, holdId], references: [marketId, id], onDelete: Restrict, onUpdate: Restrict)
  lot  WalletLot  @relation(fields: [marketId, lotId], references: [marketId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([marketId, holdId, lotId])
  @@index([marketId, lotId])
  @@map("hold_lots")
  @@schema("wallet")
}

/// The cached available and held amount of a customer wallet. Changed only in the unit of the
/// journal, after the row is locked.
model WalletBalance {
  walletAccountId String   @id @map("wallet_account_id") @db.Uuid
  marketId        String   @map("market_id") @db.VarChar(8)
  tenantId        String   @map("tenant_id")
  currency        String   @db.VarChar(3)
  availableMinor  BigInt   @map("available_minor")
  heldMinor       BigInt   @map("held_minor")
  updatedAt       DateTime @map("updated_at") @db.Timestamptz(6)

  wallet WalletAccount @relation(fields: [marketId, walletAccountId, currency], references: [marketId, id, currency], onDelete: Restrict, onUpdate: Restrict)

  @@map("balances")
  @@schema("wallet")
}

/// The runtime switch of the wallet in one Market. No row means `off`. Set by an admin.
model WalletMarketSetting {
  marketId           String   @map("market_id") @db.VarChar(8)
  tenantId           String   @map("tenant_id")
  /// off, active, paused or frozen (CHECK).
  status             String
  /// Required for paused and frozen (CHECK).
  reasonCode         String?  @map("reason_code")
  updatedAt          DateTime @map("updated_at") @db.Timestamptz(6)
  updatedByAccountId String   @map("updated_by_account_id") @db.Uuid

  @@id([marketId])
  @@map("market_settings")
  @@schema("wallet")
}

/// One admin credit issue (customer wallet package 2a): `granted` at once within the Market's
/// caps, or `pending` for a second admin, then `approved`, `rejected` or `expired`. Never deleted;
/// only a pending row is decided, once (guard trigger). The admin who asked never decides (CHECK).
/// `note` is free text for the admins only: it is never put in a journal, an audit row or an event.
model WalletAdminCreditRequest {
  id                   String    @id @db.Uuid
  marketId             String    @map("market_id") @db.VarChar(8)
  tenantId             String    @map("tenant_id")
  /// A plain identity account id, no foreign key.
  customerAccountId    String    @map("customer_account_id") @db.Uuid
  amountMinor          BigInt    @map("amount_minor")
  currency             String    @db.VarChar(3)
  /// goodwill, service-recovery, promotion or correction (CHECK).
  reasonCode           String    @map("reason_code")
  note                 String?
  /// granted, pending, approved, rejected or expired (CHECK).
  status               String
  /// issue-cap or daily-cap; null exactly when granted at once (CHECK).
  approvalReason       String?   @map("approval_reason")
  requestedByAccountId String    @map("requested_by_account_id") @db.Uuid
  requestedAt          DateTime  @map("requested_at") @db.Timestamptz(6)
  /// The requesting admin's calendar day in the Market's time zone: the daily cap's day.
  localDay             DateTime  @map("local_day") @db.Date
  /// Null exactly when granted at once (CHECK).
  expiresAt            DateTime? @map("expires_at") @db.Timestamptz(6)
  idempotencyKey       String    @map("idempotency_key")
  fingerprint          String
  /// Set exactly when approved or rejected, and never the requester (CHECK).
  decidedByAccountId   String?   @map("decided_by_account_id") @db.Uuid
  decidedAt            DateTime? @map("decided_at") @db.Timestamptz(6)
  /// The closed reject reason; set exactly when rejected (CHECK).
  decisionReasonCode   String?   @map("decision_reason_code")
  /// The grant's journal; set exactly when granted or approved (CHECK).
  journalId            String?   @map("journal_id") @db.Uuid

  journal WalletJournal? @relation(fields: [marketId, journalId], references: [marketId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([marketId, id])
  @@unique([marketId, idempotencyKey])
  /// A grant journal serves one request only.
  @@unique([marketId, journalId])
  /// One admin's day, status and amount last: the daily cap sums from the index only.
  @@index([marketId, requestedByAccountId, localDay, status, amountMinor])
  /// The admin list by status, newest first.
  @@index([marketId, status, requestedAt(sort: Desc), id(sort: Desc)])
  /// Partial (status = 'pending') in the migration: the expiry sweep.
  @@index([marketId, expiresAt, id])
  @@map("admin_credit_requests")
  @@schema("wallet")
}

/// The lock of one admin's day (package 2a): an issue locks this row first, so the daily cap is
/// counted one issue at a time. Created on first use; only `locked_at` changes; never deleted.
model WalletAdminCreditDay {
  marketId       String   @map("market_id") @db.VarChar(8)
  tenantId       String   @map("tenant_id")
  adminAccountId String   @map("admin_account_id") @db.Uuid
  localDay       DateTime @map("local_day") @db.Date
  lockedAt       DateTime @map("locked_at") @db.Timestamptz(6)

  @@id([marketId, adminAccountId, localDay])
  @@map("admin_credit_days")
  @@schema("wallet")
}
