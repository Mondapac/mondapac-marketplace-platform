// The sellers module (schema "sellers"). Physical design: docs/design/data/sellers.md; every
// model is named Sellers<Name> (its S2) and mapped to its table with @@map. Slice 1 creates
// the outbox, the inbox and the four roots that share the seller id (S3); slice 2 adds the
// file's details, shop slugs and rate counters; later slices add columns and tables, each in
// its own migration (data design 9.1).

/// Events of the sellers module (ADR-0006 decisions 1 and 2; data design 3.12, PM1). Written
/// only by the platform OutboxWriter in the unit of the state change, read and marked only by
/// the relay (platform/persistence/outbox/). Every outbox of every module has exactly these
/// fields. The CHECKs, the partial claim index and the grants are hand-written in the migration.
/// Payloads hold ids, codes, booleans and instants only (P 5.3); no personal data in any column.
model SellersOutbox {
  /// UUIDv7 stamped by the outbox writer.
  eventId          String    @id @map("event_id") @db.Uuid
  /// "sellers.<subject>-<verb>.v<N>"; the CHECK refuses another module's type.
  type             String
  /// The instant the use case took from Clock (UTC).
  occurredAt       DateTime  @map("occurred_at") @db.Timestamptz(6)
  /// Market of the unit that wrote the event (ADR-0003); stamped by the writer.
  marketId         String    @map("market_id") @db.VarChar(8)
  /// Tenant seam (ADR-0001); stamped by the writer, no database default.
  tenantId         String    @map("tenant_id")
  aggregateType    String    @map("aggregate_type")
  aggregateId      String    @map("aggregate_id") @db.Uuid
  /// The aggregate's version after the change; unique per aggregate (P 10).
  aggregateVersion Int       @map("aggregate_version")
  correlationId    String    @map("correlation_id")
  /// The consumed event that caused this one, or null.
  causationId      String?   @map("causation_id") @db.Uuid
  payload          Json      @db.JsonB
  /// Set by the relay when the event was handed to the bus; the only column that changes.
  publishedAt      DateTime? @map("published_at") @db.Timestamptz(6)

  /// No two events of one aggregate share a version (I7); led by market_id (data design C7).
  @@unique([marketId, aggregateId, aggregateVersion])
  @@map("outbox")
  @@schema("sellers")
}

/// Events sellers' subscribers have handled (ADR-0006 decision 5; data design 3.12, PM4):
/// `runOnce` inserts (event_id, handler) in the handler's own unit and skips the work when the
/// row exists. Written only by platform/persistence/outbox/. The CHECKs and the grants are
/// hand-written in the migration.
model SellersInbox {
  eventId     String   @map("event_id") @db.Uuid
  /// The subscriber's name, "sellers.<handler>".
  handler     String
  marketId    String   @map("market_id") @db.VarChar(8)
  tenantId    String   @map("tenant_id")
  processedAt DateTime @map("processed_at") @db.Timestamptz(6)

  @@id([eventId, handler])
  @@map("inbox")
  @@schema("sellers")
}

/// The file of one seller (sellers design 2.1; data design 3.1): created by the handler of
/// `identity.seller-registered.v1` or by the backfill, under the id identity minted (ADR-0022
/// decision 1). Slice 1 holds the columns every later slice builds on; the details, the
/// identifier and the approved-revision pointer arrive as nullable columns in slices 2 to 7.
/// The CHECKs are hand-written in the migration.
model SellersSellerFile {
  /// UUIDv7 minted by identity (S3); also the subject id of the seller's data key.
  sellerId                       String                        @id @map("seller_id") @db.Uuid
  marketId                       String                        @map("market_id") @db.VarChar(8)
  tenantId                       String                        @map("tenant_id")
  /// self | invitation.
  origin                         String
  /// The Market policy read in the creating unit (D 7.5); a missing row gives true.
  approvalRequiredAtRegistration Boolean                       @map("approval_required_at_registration")
  /// Written by the aggregate on every save: false at creation.
  draftComplete                  Boolean                       @map("draft_complete")
  /// Every change of the file; equals created_at at creation.
  lastChangedAt                  DateTime                      @map("last_changed_at") @db.Timestamptz(6)
  /// Slice 2. Clear (public once approved, D 8.1); the CHECK S7 class, 1 to 100 characters.
  storeName                      String?                       @map("store_name")
  /// Slice 2. The prefix-search key (NFKC, case-folded, whitespace collapsed by the
  /// application). The column is `COLLATE "C"` (S6), hand-written in the migration: Prisma
  /// does not see a column collation (spike S1), so the catalog test checks it.
  storeNameKey                   String?                       @map("store_name_key")
  /// Slice 2. Personal; ciphertext under the seller's subject key (S4), never compared or
  /// indexed. Label sellers.seller-file.business-name.
  businessNameCiphertext         String?                       @map("business_name_ciphertext")
  /// Slice 2. Personal, S4. Label sellers.seller-file.phone.
  phoneCiphertext                String?                       @map("phone_ciphertext")
  /// Slice 2. Personal, S4. Label sellers.seller-file.contact-email; never the sign-in email.
  contactEmailCiphertext         String?                       @map("contact_email_ciphertext")
  /// Slice 2. Personal, S4. The operating address (a JSON object of the Market's
  /// address.format); the only address that drives the ServiceArea and the zones.
  addressCiphertext              String?                       @map("address_ciphertext")
  /// Slice 2. Personal, S4. The registered address when it differs; NULL means "same as the
  /// operating address".
  registeredAddressCiphertext    String?                       @map("registered_address_ciphertext")
  /// Slice 2. Clear ServiceArea code (Market configuration) the address fell in at the last save.
  serviceAreaCode                String?                       @map("service_area_code")
  /// Slice 2. Clear IANA zone ID of the seller (ADR-0005 decision 1), never an offset: the
  /// address's zone, a hint, or a zone chosen from the region's list (spike 3 record).
  operatingTimezone              String?                       @map("operating_timezone")
  /// Slice 2. Who set operating_timezone: default | browser | location | seller | admin.
  timezoneSource                 String?                       @map("timezone_source")
  /// Slice 2. Clear IANA zone the operating address gives (the region's default), stored so no
  /// read decrypts the address to derive it (zero-unwrap rule; guardrail 3 of spike 3).
  addressTimezone                String?                       @map("address_timezone")
  /// Q-M25. The draft's chosen shop slug (normalised). Clear, not public while a draft; `COLLATE "C"`
  /// and the CHECK `seller_files_draft_slug_check` are hand-written in the migration. No unique key
  /// and no index: uniqueness is decided when the first submission holds the slug in shop_slugs (T1).
  draftSlug                      String?                       @map("draft_slug")
  /// Slice 3. Clear scheme code from Market configuration; the three identifier columns are all
  /// NULL or all set (CHECK seller_files_identifier_set_check, hand-written).
  identifierScheme               String?                       @map("identifier_scheme")
  /// Slice 3. Personal, S4. The normalised identifier; label sellers.seller-file.identifier.
  identifierCiphertext           String?                       @map("identifier_ciphertext")
  /// Slice 3. Personal (pseudonymous), S5: IdentifierIndex.of(market, scheme, normalised), 32
  /// bytes. The partial index (market_id, identifier_index) WHERE NOT NULL is hand-written.
  identifierIndex                Bytes?                        @map("identifier_index")
  /// Slice 5. The V1 pointer to the live approved revision of this seller (ADR-0009 decision 2),
  /// NULL until a revision is approved (moved by slice 7a-decide only). The composite foreign key
  /// below names (market, seller, revision), so the pointer can only name a revision of this
  /// seller; a file with an approved revision has a frozen draft.
  approvedRevisionId             String?                       @map("approved_revision_id") @db.Uuid
  /// Slice 7a-decide (Q-M2). The store name of the approved revision, copied in every unit that
  /// moves the pointer; NULL exactly while the pointer is NULL (CHECK, hand-written, with S7).
  publicStoreName                String?                       @map("public_store_name")
  /// Slice 7a-decide (D 3.2). The decision in flight around a call into `identity`:
  /// approve-requested | reject-requested | reapply-requested (CHECK). The four decision columns
  /// are all NULL or all set (CHECK); the partial index on (market_id, decision_intent_since) for
  /// the reconciliation job is hand-written.
  decisionIntent                 String?                       @map("decision_intent")
  /// Slice 7a-decide. The attempt that set the intent: only that attempt's second unit clears it.
  decisionAttemptId              String?                       @map("decision_attempt_id") @db.Uuid
  /// Slice 7a-decide. Revision N of the decision, a revision of this seller (composite FK).
  decisionRevisionId             String?                       @map("decision_revision_id") @db.Uuid
  /// Slice 7a-decide. When the intent was set; the reconciliation job reads intents older than 5 minutes.
  decisionIntentSince            DateTime?                     @map("decision_intent_since") @db.Timestamptz(6)
  /// Optimistic version of the aggregate (P 10); 1 at insert.
  version                        Int
  createdAt                      DateTime                      @map("created_at") @db.Timestamptz(6)
  approvedRevision               SellersBusinessFileRevision?  @relation("SellerFileApprovedRevision", fields: [marketId, sellerId, approvedRevisionId], references: [marketId, sellerId, id], onDelete: Restrict, onUpdate: Restrict)
  decisionRevision               SellersBusinessFileRevision?  @relation("SellerFileDecisionRevision", fields: [marketId, sellerId, decisionRevisionId], references: [marketId, sellerId, id], onDelete: Restrict, onUpdate: Restrict)
  revisions                      SellersBusinessFileRevision[] @relation("SellerFileRevisions")
  adminSettings                  SellersSellerAdminSettings?
  taxProfile                     SellersSellerTaxProfile?
  storeProfile                   SellersStoreProfile?
  registerChecks                 SellersRegisterCheck[]
  identifierClaim                SellersIdentifierClaim?
  adminFlags                     SellersAdminFlag[]

  /// The target of composite foreign keys, and the batch read of sellerSummaries (S3).
  @@unique([marketId, sellerId])
  /// The admin list's store-name prefix search as a range on the "C" key (data design A6, S6).
  @@index([marketId, storeNameKey])
  @@map("seller_files")
  @@schema("sellers")
}

/// A shop slug (sellers design 3.5; data design 3.5): held by one seller, or retired for good.
/// The seller id is a plain id with no foreign key (C4): a retired slug outlives the purge of
/// its file (Q-M3). The slug column is `COLLATE "C"` (S6), hand-written in the migration. The
/// CHECKs, the partial unique "one held slug per seller" and the column-level UPDATE grant are
/// hand-written too.
model SellersShopSlug {
  /// UUIDv7; the aggregate id of sellers.slug-changed.v1 in the outbox.
  id         String    @id @db.Uuid
  marketId   String    @map("market_id") @db.VarChar(8)
  tenantId   String    @map("tenant_id")
  /// Clear, public: a-z, 0-9 and single inner hyphens, 3 to 50 characters.
  slug       String
  sellerId   String    @map("seller_id") @db.Uuid
  /// held | retired.
  state      String
  /// True once held while its seller had an approved revision (Hassan M6); never set back.
  everPublic Boolean   @map("ever_public")
  heldAt     DateTime  @map("held_at") @db.Timestamptz(6)
  retiredAt  DateTime? @map("retired_at") @db.Timestamptz(6)
  /// Optimistic version (S1); 1 at insert.
  version    Int
  createdAt  DateTime  @map("created_at") @db.Timestamptz(6)

  /// Unique per Market, retired rows included, so a retired slug is never held again; the
  /// insert's P2002 is `slug.taken`. Also the slug prefix search and the public read (A7).
  @@unique([marketId, slug])
  @@map("shop_slugs")
  @@schema("sellers")
}

/// Rate counters of the sellers module (data design 3.11; D 6.5, 7.7; Hassan L10): one fixed
/// window per Market, kind and keyed subject hash, reserved before the work. No account id,
/// seller id or origin in clear. The kind list and the CHECKs are hand-written in the migration;
/// the hourly sellers.purge-expired deletes rows whose window started more than 48 hours ago.
model SellersRateCounter {
  marketId        String   @map("market_id") @db.VarChar(8)
  tenantId        String   @map("tenant_id")
  /// A closed list (CHECK); a new kind is a migration.
  kind            String
  /// HMAC-SHA-256 of the kind's subject under the sellers rate-counter key (32 bytes).
  keyHash         Bytes    @map("key_hash")
  /// Start of the fixed window, set at the first reservation; its length is the kind's, in code.
  windowStartedAt DateTime @map("window_started_at") @db.Timestamptz(6)
  /// Reservations in the window; never below 0.
  count           Int

  @@id([marketId, kind, keyHash])
  @@map("rate_counters")
  @@schema("sellers")
}

/// The admin's per-seller settings (data design 3.9): allowed product types, category proposals,
/// the AI switch. No column default (C2): the creating handler writes true, false, false, so a
/// missing row is a fault and never silently a default.
model SellersSellerAdminSettings {
  sellerId                            String            @id @map("seller_id") @db.Uuid
  marketId                            String            @map("market_id") @db.VarChar(8)
  tenantId                            String            @map("tenant_id")
  allProductTypesAllowed              Boolean           @map("all_product_types_allowed")
  allProductTypesChangedAt            DateTime?         @map("all_product_types_changed_at") @db.Timestamptz(6)
  allProductTypesChangedByAccountId   String?           @map("all_product_types_changed_by_account_id") @db.Uuid
  categoryProposalsAllowed            Boolean           @map("category_proposals_allowed")
  categoryProposalsChangedAt          DateTime?         @map("category_proposals_changed_at") @db.Timestamptz(6)
  categoryProposalsChangedByAccountId String?           @map("category_proposals_changed_by_account_id") @db.Uuid
  aiEnabled                           Boolean           @map("ai_enabled")
  aiEnabledChangedAt                  DateTime?         @map("ai_enabled_changed_at") @db.Timestamptz(6)
  aiEnabledChangedByAccountId         String?           @map("ai_enabled_changed_by_account_id") @db.Uuid
  version                             Int
  createdAt                           DateTime          @map("created_at") @db.Timestamptz(6)
  sellerFile                          SellersSellerFile @relation(fields: [marketId, sellerId], references: [marketId, sellerId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([marketId, sellerId])
  @@map("seller_admin_settings")
  @@schema("sellers")
}

/// The root of a seller's tax registration periods (data design 3.7; V2): it exists so that a
/// recorded period raises one version.
model SellersSellerTaxProfile {
  sellerId   String                         @id @map("seller_id") @db.Uuid
  marketId   String                         @map("market_id") @db.VarChar(8)
  tenantId   String                         @map("tenant_id")
  version    Int
  createdAt  DateTime                       @map("created_at") @db.Timestamptz(6)
  sellerFile SellersSellerFile              @relation(fields: [marketId, sellerId], references: [marketId, sellerId], onDelete: Restrict, onUpdate: Restrict)
  periods    SellersTaxRegistrationPeriod[]

  @@unique([marketId, sellerId])
  @@map("seller_tax_profiles")
  @@schema("sellers")
}

/// One period of a seller's indirect-tax registration (data design 3.7; sellers design 2.4 rule 4;
/// ADR-0009 V2). Half-open: valid_from inclusive, valid_to exclusive, NULL = open. The no-overlap
/// rule is `tax_registration_periods_no_overlap_excl` (EXCLUDE USING gist, hand-written in the
/// migration: Prisma does not model it) and the CHECKs and grants are hand-written too. The
/// application may only INSERT, close (UPDATE valid_to) and DELETE a period that has not started.
model SellersTaxRegistrationPeriod {
  id                       String                  @id @db.Uuid
  marketId                 String                  @map("market_id") @db.VarChar(8)
  tenantId                 String                  @map("tenant_id")
  sellerId                 String                  @map("seller_id") @db.Uuid
  /// Clear; the platform decides nothing from it (ADR-0007 decision 6).
  registeredForIndirectTax Boolean                 @map("registered_for_indirect_tax")
  /// The local date the person entered (or the recording instant's local date).
  effectiveFromLocal       DateTime                @map("effective_from_local") @db.Date
  /// IANA zone that turned the local date into valid_from (ADR-0005 decision 3).
  effectiveZone            String                  @map("effective_zone")
  validFrom                DateTime                @map("valid_from") @db.Timestamptz(6)
  validTo                  DateTime?               @map("valid_to") @db.Timestamptz(6)
  /// seller | admin.
  recordedByKind           String                  @map("recorded_by_kind")
  recordedByAccountId      String                  @map("recorded_by_account_id") @db.Uuid
  recordedAt               DateTime                @map("recorded_at") @db.Timestamptz(6)
  taxProfile               SellersSellerTaxProfile @relation(fields: [marketId, sellerId], references: [marketId, sellerId], onDelete: Restrict, onUpdate: Restrict)

  /// "As of an instant" (ADR-0007 decision 7), led by market_id (C7).
  @@index([marketId, sellerId, validFrom])
  @@map("tax_registration_periods")
  @@schema("sellers")
}

/// The latest register result for one file and one identifier value (data design 3.4, slice 4a;
/// sellers design 3.4, 7.7). One row per (file, value): results are never shared across sellers.
/// "Not performed" is the absence of a row. Outcome, flags and instants are results, kept in
/// clear (Q-M8); the register's raw answer is never kept. The CHECKs and the grants are
/// hand-written in the migration.
model SellersRegisterCheck {
  marketId                 String            @map("market_id") @db.VarChar(8)
  tenantId                 String            @map("tenant_id")
  sellerId                 String            @map("seller_id") @db.Uuid
  /// Personal (pseudonymous), S5: the file's IdentifierIndex for the value that was checked.
  identifierIndex          Bytes             @map("identifier_index")
  /// active | not-found | cancelled | unavailable (CHECK).
  outcome                  String
  /// Subset of business-name, indirect-tax-registration, postcode (CHECK); empty unless active.
  mismatches               String[]
  /// The first definite negative for this value; kept while later answers are `unavailable`.
  definiteNegativeAt       DateTime?         @map("definite_negative_at") @db.Timestamptz(6)
  /// Personal, Enc, label sellers.register-check.compared-values. Not written in slice 4a: the
  /// register's agreement is not reviewed yet (data design 3.4; sellers design 7.7).
  comparedValuesCiphertext String?           @map("compared_values_ciphertext")
  checkedAt                DateTime          @map("checked_at") @db.Timestamptz(6)
  /// seller | reviewer | job (CHECK).
  checkedByKind            String            @map("checked_by_kind")
  /// A plain id (C4); NULL exactly for the job.
  checkedByAccountId       String?           @map("checked_by_account_id") @db.Uuid
  /// Slice 5 (Hassan M1 residual): the `seller_files.version` the comparison read the draft at.
  /// An `active` result is current only while the file is still at this version. >= 1 (CHECK).
  comparedFileVersion      Int               @map("compared_file_version")
  sellerFile               SellersSellerFile @relation(fields: [marketId, sellerId], references: [marketId, sellerId], onDelete: Restrict, onUpdate: Restrict)

  @@id([marketId, sellerId, identifierIndex])
  @@map("register_checks")
  @@schema("sellers")
}

/// The root of a seller's public store profile (data design 3.8; V1), created empty. The
/// published-revision pointer arrives in slice 12 and the minimum order in slice 20.
model SellersStoreProfile {
  sellerId   String            @id @map("seller_id") @db.Uuid
  marketId   String            @map("market_id") @db.VarChar(8)
  tenantId   String            @map("tenant_id")
  version    Int
  createdAt  DateTime          @map("created_at") @db.Timestamptz(6)
  sellerFile SellersSellerFile @relation(fields: [marketId, sellerId], references: [marketId, sellerId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([marketId, sellerId])
  @@map("store_profiles")
  @@schema("sellers")
}

/// One revision of a seller's business file (data design 3.2; ADR-0009 V1): the frozen content a
/// reviewer decides on. Content never changes: the application role may update only the status
/// columns (column-level UPDATE grant, hand-written in the migration with every CHECK, the
/// partial unique indexes "one pending" and "one approved", and the reviewer-queue index).
model SellersBusinessFileRevision {
  id                   String              @id @db.Uuid
  marketId             String              @map("market_id") @db.VarChar(8)
  tenantId             String              @map("tenant_id")
  sellerId             String              @map("seller_id") @db.Uuid
  /// onboarding | identity-change (CHECK).
  kind                 String
  /// 1, 2, ... per seller (CHECK >= 1); unique per seller.
  revisionNo           Int                 @map("revision_no")
  /// pending | approved | rejected | withdrawn | superseded (CHECK).
  status               String
  /// seller | admin (CHECK).
  authorKind           String              @map("author_kind")
  /// A plain id (C4): a revision is only created from a person's submission.
  authorAccountId      String              @map("author_account_id") @db.Uuid
  /// Personal, Enc, label sellers.business-file-revision.content: the sorted-key JSON of the
  /// content, sealed under the seller's key. Never queried; the reviewer reads it whole.
  contentCiphertext    String              @map("content_ciphertext")
  /// The JSON shape of the content (CHECK >= 1), not the envelope version.
  contentSchemaVersion Int                 @map("content_schema_version") @db.SmallInt
  /// hmac-sha256:<64 hex> over the canonical content (CHECK), keyed by the seller's subject key.
  contentHash          String              @map("content_hash")
  /// Personal (pseudonymous), S5: the submitted identifier's index; NULL when none was given.
  identifierIndex      Bytes?              @map("identifier_index")
  /// Clear IANA zone and ServiceArea code of the operating address at submission.
  operatingTimezone    String              @map("operating_timezone")
  serviceAreaCode      String              @map("service_area_code")
  /// Clear IANA zone derived from the operating address only, copied at submit; NULL for a
  /// backfill revision (fail closed for the claim path).
  addressTimezone      String?             @map("address_timezone")
  /// Snapshot of the register check at submission (CHECKs: outcome list, mismatch subset).
  registerOutcome      String              @map("register_outcome")
  registerMismatches   String[]            @map("register_mismatches")
  registerCheckedAt    DateTime?           @map("register_checked_at") @db.Timestamptz(6)
  createdAt            DateTime            @map("created_at") @db.Timestamptz(6)
  statusChangedAt      DateTime            @map("status_changed_at") @db.Timestamptz(6)
  decidedAt            DateTime?           @map("decided_at") @db.Timestamptz(6)
  decidedByAccountId   String?             @map("decided_by_account_id") @db.Uuid
  identityDecisionId   String?             @map("identity_decision_id") @db.Uuid
  /// A code from the Market's reject reasons, never text (S8 pattern CHECK).
  rejectReasonCode     String?             @map("reject_reason_code")
  /// edited | cancelled | reapply-refused (CHECK).
  withdrawCause        String?             @map("withdraw_cause")
  /// seller | admin (CHECK).
  withdrawnByKind      String?             @map("withdrawn_by_kind")
  withdrawnAt          DateTime?           @map("withdrawn_at") @db.Timestamptz(6)
  sellerFile           SellersSellerFile   @relation("SellerFileRevisions", fields: [marketId, sellerId], references: [marketId, sellerId], onDelete: Restrict, onUpdate: Restrict)
  approvedFor          SellersSellerFile[] @relation("SellerFileApprovedRevision")
  decisionFor          SellersSellerFile[] @relation("SellerFileDecisionRevision")
  reviewChecks         SellersReviewCheck[]
  identifierClaims     SellersIdentifierClaim[]

  /// The seller's revision numbers; the latest-rejected probe reads it backwards (3.2).
  @@unique([marketId, sellerId, revisionNo])
  /// The target of the pointer foreign keys of seller_files (3.1, 3.2).
  @@unique([marketId, sellerId, id])
  @@map("business_file_revisions")
  @@schema("sellers")
}

/// A review check recorded on a revision (data design 3.3; slice 7a-decide, which builds what the
/// reviewer's approval guard reads). Slice 7a-decide records only `manual-register-check`, the
/// check that stands in for a register lookup the Market cannot make (D 3.4, AC 32); the codes a
/// Market lists in configuration join with the slice that configures them. Recorded again while
/// the revision is pending (an upsert on the key); "never after the decision" is the use case's.
/// The foreign key names the seller too, so a check can only sit on that seller's revision.
/// CHECKs and grants are hand-written in the migration.
model SellersReviewCheck {
  marketId                String                      @map("market_id") @db.VarChar(8)
  tenantId                String                      @map("tenant_id")
  sellerId                String                      @map("seller_id") @db.Uuid
  revisionId              String                      @map("revision_id") @db.Uuid
  /// S8 pattern; `manual-register-check` is the one code the design fixes.
  checkCode               String                      @map("check_code")
  /// done | not-applicable | not-done (CHECK). `not-done` sets a check back.
  result                  String
  /// active | not-found | cancelled: what the reviewer read in the register; set exactly for
  /// `manual-register-check` (CHECK).
  observedRegisterOutcome String?                     @map("observed_register_outcome")
  /// A plain id (C4).
  recordedByAccountId     String                      @map("recorded_by_account_id") @db.Uuid
  recordedAt              DateTime                    @map("recorded_at") @db.Timestamptz(6)
  revision                SellersBusinessFileRevision @relation(fields: [marketId, sellerId, revisionId], references: [marketId, sellerId, id], onDelete: Cascade, onUpdate: Restrict)

  @@id([marketId, revisionId, checkCode])
  @@map("review_checks")
  @@schema("sellers")
}

/// One approved or suspended seller per identifier value per Market (data design 3.6; D 3.6, AC 21;
/// slice 7a-decide). Taken in the first unit of an approval and released if `identity` refuses; a
/// move is a delete plus an insert, so the row is never updated. CHECKs and grants are hand-written.
model SellersIdentifierClaim {
  marketId        String                      @map("market_id") @db.VarChar(8)
  tenantId        String                      @map("tenant_id")
  /// Personal (pseudonymous), S5: the identifier index of the revision that took the claim.
  identifierIndex Bytes                       @map("identifier_index")
  sellerId        String                      @map("seller_id") @db.Uuid
  /// The revision that took the claim.
  revisionId      String                      @map("revision_id") @db.Uuid
  claimedAt       DateTime                    @map("claimed_at") @db.Timestamptz(6)
  /// S1; 1 at insert (never updated).
  version         Int
  createdAt       DateTime                    @map("created_at") @db.Timestamptz(6)
  sellerFile      SellersSellerFile           @relation(fields: [marketId, sellerId], references: [marketId, sellerId], onDelete: Restrict, onUpdate: Restrict)
  revision        SellersBusinessFileRevision @relation(fields: [marketId, sellerId, revisionId], references: [marketId, sellerId, id], onDelete: Restrict, onUpdate: Restrict)

  /// The second approval of one value fails here (AC 21).
  @@id([marketId, identifierIndex])
  /// One claim per seller.
  @@unique([marketId, sellerId])
  @@map("identifier_claims")
  @@schema("sellers")
}

/// A flag for an admin (data design 3.13; D 14.4 Q-M20; slice 7a-decide): ids, a code and instants.
/// The partial unique "one open flag per (Market, seller, code)", the open-flags index, the CHECKs
/// and the grants are hand-written in the migration.
model SellersAdminFlag {
  id                 String            @id @db.Uuid
  marketId           String            @map("market_id") @db.VarChar(8)
  tenantId           String            @map("tenant_id")
  sellerId           String            @map("seller_id") @db.Uuid
  /// identifier-claim-conflict (CHECK; `register-recheck` joins with slice 11).
  code               String
  raisedAt           DateTime          @map("raised_at") @db.Timestamptz(6)
  clearedAt          DateTime?         @map("cleared_at") @db.Timestamptz(6)
  /// A plain id (C4); set exactly when cleared (CHECK).
  clearedByAccountId String?           @map("cleared_by_account_id") @db.Uuid
  sellerFile         SellersSellerFile @relation(fields: [marketId, sellerId], references: [marketId, sellerId], onDelete: Restrict, onUpdate: Restrict)

  @@map("admin_flags")
  @@schema("sellers")
}
