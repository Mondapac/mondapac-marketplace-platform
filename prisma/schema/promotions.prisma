// The promotions module's tables (promotions package T1, discount engine and domain). Every model
// is named Promotions<Name> and mapped to its table with @@map. The CHECKs, the partial unique
// indexes and the grants are hand-written in the migration. Sellers, products, delivery zones and
// accounts (other modules) are plain ids and codes with no foreign key. Money is minor units
// (BigInt) in the Market's currency. A promotion's code is free text of the owner's choosing and
// is never copied into an audit row.

/// One promotion: its type, state, funding, schedule, reward and limits. The targets live in
/// `promotion_targets`, the counters of use in `promotion_usage`. The type, owner, currency and
/// code of a promotion never change after creation; everything else is changed by its owner (a
/// seller for its own, an admin for the platform's) and every change is audited.
model PromotionsPromotion {
  id                 String                     @id @db.Uuid
  marketId           String                     @map("market_id") @db.VarChar(8)
  tenantId           String                     @map("tenant_id")
  /// SELLER_SALE, CART_DISCOUNT, CART_CODE, FREE_SHIPPING, CO_FUNDED_CAMPAIGN, TIERED_CART,
  /// BUY_X_GET_Y, MULTI_BUY, BUNDLE, FLASH_SALE, BATCH_CODE, CUSTOMER_GROUP, STORE_FOLLOWER,
  /// REFERRAL or CASHBACK (CHECK). REFERRAL and CASHBACK give wallet credit, not a discount.
  type               String
  /// PENDING_APPROVAL, ACTIVE, PAUSED or REJECTED (CHECK).
  status             String
  name               String
  /// SELLER, PLATFORM or CO_FUNDED (CHECK).
  funding            String
  /// The platform's share of a CO_FUNDED promotion, 1 to 9999 basis points; null otherwise (CHECK).
  platformSplitBps   Int?                       @map("platform_split_bps") @db.SmallInt
  /// The owner seller (sellers); null for a platform promotion (CHECK ties it to the funding).
  ownerSellerId      String?                    @map("owner_seller_id") @db.Uuid
  combinable         Boolean
  /// Upper case; set if and only if the type is CART_CODE (CHECK). Unique per Market.
  code               String?
  startsAt           DateTime                   @map("starts_at") @db.Timestamptz(6)
  endsAt             DateTime?                  @map("ends_at") @db.Timestamptz(6)
  /// A test-mode promotion applies only to test orders. Platform money needs it until the Market
  /// confirms the tax ruling; the use case enforces this from the Market flag (no CHECK, since the
  /// rule depends on Market config).
  testMode           Boolean                    @map("test_mode")
  /// The platform's share is outside the commission cap; platform-funded or co-funded only (CHECK).
  specialCampaign    Boolean                    @map("special_campaign")
  /// An admin approved or reviewed this promotion as it is now.
  priorApproved      Boolean                    @map("prior_approved")
  /// ADMIN or SELLER while PAUSED; null otherwise (CHECK).
  pausedBy           String?                    @map("paused_by")
  currency           String                     @db.VarChar(3)
  /// PERCENT or FIXED (CHECK); PERCENT sets `rewardBps`, FIXED sets `rewardAmountMinor`.
  rewardKind         String                     @map("reward_kind")
  rewardBps          Int?                       @map("reward_bps")
  rewardAmountMinor  BigInt?                    @map("reward_amount_minor")
  capMinor           BigInt?                    @map("cap_minor")
  maxPerOrderMinor   BigInt?                    @map("max_per_order_minor")
  maxTotalUses       Int?                       @map("max_total_uses")
  maxUsesPerCustomer Int?                       @map("max_uses_per_customer")
  budgetMinor        BigInt?                    @map("budget_minor")
  minSpendMinor      BigInt?                    @map("min_spend_minor")
  /// BUY_X_GET_Y: units to buy; set if and only if the type is BUY_X_GET_Y (CHECK).
  buyQty             Int?                       @map("buy_qty") @db.SmallInt
  /// BUY_X_GET_Y: the cheapest units that get the reward per group.
  getQty             Int?                       @map("get_qty") @db.SmallInt
  /// MULTI_BUY: units in one group, 2 or more; its price is `rewardAmountMinor` (FIXED).
  groupQty           Int?                       @map("group_qty") @db.SmallInt
  /// BUY_X_GET_Y, MULTI_BUY or BUNDLE: the most groups or sets in one order; null for no limit.
  maxRepeatsPerOrder Int?                       @map("max_repeats_per_order") @db.SmallInt
  /// FLASH_SALE: the units the sale may sell in all, and the IANA zone its window was written in;
  /// both set if and only if the type is FLASH_SALE (CHECK), which also has an end.
  flashUnitLimit     Int?                       @map("flash_unit_limit")
  flashTimeZone      String?                    @map("flash_time_zone")
  /// CUSTOMER_GROUP: RETURNING_CUSTOMER or DELIVERY_ZONE (the zones are its ZONE targets); set if
  /// and only if the type is CUSTOMER_GROUP (CHECK).
  segmentKind        String?                    @map("segment_kind")
  /// RETURNING_CUSTOMER: whole days since the customer's last order (1 to 3650).
  segmentMinDays     Int?                       @map("segment_min_days") @db.SmallInt
  /// REFERRAL: the credit the new customer gets; `rewardAmountMinor` is the referrer's. Set if and
  /// only if the type is REFERRAL (CHECK).
  refereeRewardMinor BigInt?                    @map("referee_reward_minor")
  createdByAccountId String                     @map("created_by_account_id") @db.Uuid
  createdAt          DateTime                   @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                   @map("updated_at") @db.Timestamptz(6)
  targets            PromotionsTarget[]
  usage              PromotionsUsage?
  optIns             PromotionsCoFundingOptIn[]
  reviews            PromotionsReview[]
  tiers              PromotionsTier[]
  bundleItems        PromotionsBundleItem[]
  batchCodes         PromotionsBatchCode[]
  referrals          PromotionsReferral[]
  creditIssuances    PromotionsCreditIssuance[]

  /// The foreign-key target of the children.
  @@unique([marketId, id])
  /// A code is unique in a Market. NULL codes are distinct.
  @@unique([marketId, code])
  /// The live promotions of a Market (quote) and the admin list.
  @@index([marketId, status, startsAt])
  /// A seller's own promotions.
  @@index([marketId, ownerSellerId, createdAt(sort: Desc)])
  @@map("promotions")
  @@schema("promotions")
}

/// What a promotion is aimed at: product ids, seller ids or delivery zone codes. No row of a kind
/// means "any" of that kind. The targets of a promotion are replaced as a set when it is edited.
model PromotionsTarget {
  marketId    String              @map("market_id") @db.VarChar(8)
  tenantId    String              @map("tenant_id")
  promotionId String              @map("promotion_id") @db.Uuid
  /// PRODUCT, SELLER or ZONE (CHECK).
  kind        String
  /// A product or seller id, or a zone code.
  value       String
  promotion   PromotionsPromotion @relation(fields: [marketId, promotionId], references: [marketId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([marketId, promotionId, kind, value])
  @@map("promotion_targets")
  @@schema("promotions")
}

/// A tier of a TIERED_CART promotion: from this goods amount the tier's reward applies, and the
/// highest tier reached wins. The tiers of a promotion are replaced as a set when it is edited.
/// PERCENT sets `rewardBps`, FIXED sets `rewardAmountMinor` (CHECK). Rows exist for TIERED_CART
/// only (the use case writes them; a CHECK cannot look at another table).
model PromotionsTier {
  marketId          String              @map("market_id") @db.VarChar(8)
  tenantId          String              @map("tenant_id")
  promotionId       String              @map("promotion_id") @db.Uuid
  thresholdMinor    BigInt              @map("threshold_minor")
  rewardKind        String              @map("reward_kind")
  rewardBps         Int?                @map("reward_bps")
  rewardAmountMinor BigInt?             @map("reward_amount_minor")
  promotion         PromotionsPromotion @relation(fields: [marketId, promotionId], references: [marketId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([marketId, promotionId, thresholdMinor])
  @@map("promotion_tiers")
  @@schema("promotions")
}

/// An item of the set of a BUNDLE promotion: a product and the units of it in one set. Replaced as
/// a set when the promotion is edited. The products are also the promotion's PRODUCT targets.
model PromotionsBundleItem {
  marketId    String              @map("market_id") @db.VarChar(8)
  tenantId    String              @map("tenant_id")
  promotionId String              @map("promotion_id") @db.Uuid
  productId   String              @map("product_id") @db.Uuid
  quantity    Int                 @db.SmallInt
  promotion   PromotionsPromotion @relation(fields: [marketId, promotionId], references: [marketId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([marketId, promotionId, productId])
  @@map("promotion_bundle_items")
  @@schema("promotions")
}

/// A generated single-use code of a BATCH_CODE promotion. Only the HMAC-SHA256 hash (keyed by PROMOTIONS_CODE_PEPPER) of the code is
/// stored (the code is a bearer credential: it is shown once, in the CSV that generating returns).
/// A code is unique in a Market. `usedAt` is set when an order redeems it (package T2); the quote
/// treats a used code as not applicable. Never deleted.
model PromotionsBatchCode {
  marketId    String              @map("market_id") @db.VarChar(8)
  tenantId    String              @map("tenant_id")
  codeHash    String              @map("code_hash")
  promotionId String              @map("promotion_id") @db.Uuid
  /// The generating call that made the code (to tell batches of one promotion apart).
  batchId     String              @map("batch_id") @db.Uuid
  createdAt   DateTime            @map("created_at") @db.Timestamptz(6)
  usedAt      DateTime?           @map("used_at") @db.Timestamptz(6)
  promotion   PromotionsPromotion @relation(fields: [marketId, promotionId], references: [marketId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([marketId, codeHash])
  /// Counting and listing the codes of one promotion.
  @@index([marketId, promotionId])
  @@map("promotion_batch_codes")
  @@schema("promotions")
}

/// How much a promotion has been used. One row per promotion, made with it, all zero. Package T2
/// (budget reservation) keeps the counters; this package only reads them. The money columns are
/// financial data: a Viewer's answer carries `usesCount` only.
model PromotionsUsage {
  marketId           String              @map("market_id") @db.VarChar(8)
  tenantId           String              @map("tenant_id")
  promotionId        String              @map("promotion_id") @db.Uuid
  usesCount          Int                 @map("uses_count")
  spentMinor         BigInt              @map("spent_minor")
  sellerShareMinor   BigInt              @map("seller_share_minor")
  platformShareMinor BigInt              @map("platform_share_minor")
  updatedAt          DateTime            @map("updated_at") @db.Timestamptz(6)
  promotion          PromotionsPromotion @relation(fields: [marketId, promotionId], references: [marketId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([marketId, promotionId])
  @@map("promotion_usage")
  @@schema("promotions")
}

/// A seller's opt-in to a co-funded campaign, for its own products only. Withdrawing sets
/// `withdrawnAt`; opting in again clears it. Without a live opt-in a seller's products are not in
/// the campaign.
model PromotionsCoFundingOptIn {
  marketId           String              @map("market_id") @db.VarChar(8)
  tenantId           String              @map("tenant_id")
  promotionId        String              @map("promotion_id") @db.Uuid
  sellerId           String              @map("seller_id") @db.Uuid
  optedInAt          DateTime            @map("opted_in_at") @db.Timestamptz(6)
  withdrawnAt        DateTime?           @map("withdrawn_at") @db.Timestamptz(6)
  decidedByAccountId String              @map("decided_by_account_id") @db.Uuid
  promotion          PromotionsPromotion @relation(fields: [marketId, promotionId], references: [marketId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([marketId, promotionId, sellerId])
  @@map("co_funding_opt_ins")
  @@schema("promotions")
}

/// The admin review queue of seller promotions. A promotion that needs prior approval waits here
/// (PENDING_APPROVAL); one that went live is reviewed afterwards. At most one OPEN entry per
/// promotion (a partial unique index in the migration).
model PromotionsReview {
  id                 String              @id @db.Uuid
  marketId           String              @map("market_id") @db.VarChar(8)
  tenantId           String              @map("tenant_id")
  promotionId        String              @map("promotion_id") @db.Uuid
  sellerId           String              @map("seller_id") @db.Uuid
  /// NEW_SELLER, HIGH_DISCOUNT or POST_REVIEW (CHECK); POST_REVIEW is a promotion that went live.
  reason             String
  /// OPEN, APPROVED or REJECTED (CHECK).
  status             String
  openedAt           DateTime            @map("opened_at") @db.Timestamptz(6)
  decidedAt          DateTime?           @map("decided_at") @db.Timestamptz(6)
  decidedByAccountId String?             @map("decided_by_account_id") @db.Uuid
  promotion          PromotionsPromotion @relation(fields: [marketId, promotionId], references: [marketId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([marketId, id])
  /// The open queue, oldest first.
  @@index([marketId, status, openedAt])
  @@map("promotion_reviews")
  @@schema("promotions")
}

/// The first-order discount of a Market, edited by an admin. No row means the Market's defaults
/// from config (and none in config means off). The discount is platform-funded.
model PromotionsFirstOrderSetting {
  marketId           String   @map("market_id") @db.VarChar(8)
  tenantId           String   @map("tenant_id")
  enabled            Boolean
  /// PERCENT or FIXED (CHECK); PERCENT sets `percentBps`, FIXED sets `amountMinor`.
  kind               String
  percentBps         Int?     @map("percent_bps")
  amountMinor        BigInt?  @map("amount_minor")
  capMinor           BigInt?  @map("cap_minor")
  minSpendMinor      BigInt   @map("min_spend_minor")
  monthlyBudgetMinor BigInt   @map("monthly_budget_minor")
  updatedAt          DateTime @map("updated_at") @db.Timestamptz(6)
  updatedByAccountId String   @map("updated_by_account_id") @db.Uuid

  @@id([marketId])
  @@map("first_order_settings")
  @@schema("promotions")
}

/// The free-shipping threshold of one delivery zone. A zone without a row uses the Market's
/// default from config. The row has its own id so that an audit row can name it.
model PromotionsFreeShippingThreshold {
  id                 String   @id @db.Uuid
  marketId           String   @map("market_id") @db.VarChar(8)
  tenantId           String   @map("tenant_id")
  zoneCode           String   @map("zone_code")
  thresholdMinor     BigInt   @map("threshold_minor")
  updatedAt          DateTime @map("updated_at") @db.Timestamptz(6)
  updatedByAccountId String   @map("updated_by_account_id") @db.Uuid

  /// One threshold per zone in a Market.
  @@unique([marketId, zoneCode])
  @@map("free_shipping_thresholds")
  @@schema("promotions")
}

/// The runtime switch of promotions in one Market. No row means `off`. Set by an admin.
model PromotionsMarketSetting {
  marketId           String   @map("market_id") @db.VarChar(8)
  tenantId           String   @map("tenant_id")
  /// off or active (CHECK).
  status             String
  updatedAt          DateTime @map("updated_at") @db.Timestamptz(6)
  updatedByAccountId String   @map("updated_by_account_id") @db.Uuid

  @@id([marketId])
  @@map("market_settings")
  @@schema("promotions")
}

/// A customer's referral code (phase 3). The code itself is derived from the pepper and the
/// account and is never stored; only its HMAC hash is, to find the referrer when a new customer
/// types it. One code per customer in a Market. Never deleted.
model PromotionsReferralCode {
  marketId  String   @map("market_id") @db.VarChar(8)
  tenantId  String   @map("tenant_id")
  accountId String   @map("account_id") @db.Uuid
  codeHash  String   @map("code_hash")
  createdAt DateTime @map("created_at") @db.Timestamptz(6)

  @@id([marketId, accountId])
  /// A code is unique in a Market; the lookup by what the new customer typed.
  @@unique([marketId, codeHash])
  @@map("referral_codes")
  @@schema("promotions")
}

/// A new customer who applied a referrer's code. At most one per referred customer in a Market.
/// PENDING until the referred customer's first qualifying order is delivered; then QUALIFIED
/// (the two credits are issued), or REJECTED (an abuse check failed) or EXPIRED (no qualifying
/// order in time). Never deleted.
model PromotionsReferral {
  id                      String              @id @db.Uuid
  marketId                String              @map("market_id") @db.VarChar(8)
  tenantId                String              @map("tenant_id")
  /// The REFERRAL promotion in force when the code was applied; its terms pay the credits.
  promotionId             String              @map("promotion_id") @db.Uuid
  referrerAccountId       String              @map("referrer_account_id") @db.Uuid
  refereeAccountId        String              @map("referee_account_id") @db.Uuid
  /// PENDING, QUALIFIED, REJECTED or EXPIRED (CHECK).
  status                  String
  /// Why a referral was rejected: SAME_HOUSEHOLD, SAME_PAYMENT, CAP_REACHED or BUDGET_EXHAUSTED (CHECK); null otherwise.
  rejectReason            String?             @map("reject_reason")
  createdAt               DateTime            @map("created_at") @db.Timestamptz(6)
  expiresAt               DateTime            @map("expires_at") @db.Timestamptz(6)
  decidedAt               DateTime?           @map("decided_at") @db.Timestamptz(6)
  /// The delivered seller order that qualified the referral (ids only).
  qualifyingOrderId       String?             @map("qualifying_order_id") @db.Uuid
  qualifyingSellerOrderId String?             @map("qualifying_seller_order_id") @db.Uuid
  promotion               PromotionsPromotion @relation(fields: [marketId, promotionId], references: [marketId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([marketId, id])
  /// A customer is referred once in a Market.
  @@unique([marketId, refereeAccountId])
  /// A referrer's referrals by state (the per-referrer cap).
  @@index([marketId, referrerAccountId, status])
  @@map("referrals")
  @@schema("promotions")
}

/// One wallet credit that a REFERRAL or CASHBACK promotion owes or has paid. The row is made
/// PENDING in the unit that reserves the promotion's budget; the wallet is called with the row's
/// idempotency key; the row then becomes GRANTED (with the wallet journal id). A credit for a test
/// order is only RECORDED (the intended credit; the wallet is not called). FAILED: the wallet
/// refused for good (its code is kept) and the budget is freed. One credit per source, so an
/// event delivered twice owes the customer once. Never deleted.
model PromotionsCreditIssuance {
  id                 String              @id @db.Uuid
  marketId           String              @map("market_id") @db.VarChar(8)
  tenantId           String              @map("tenant_id")
  promotionId        String              @map("promotion_id") @db.Uuid
  /// CASHBACK, REFERRER_REWARD or REFEREE_REWARD (CHECK).
  kind               String
  recipientAccountId String              @map("recipient_account_id") @db.Uuid
  /// The order that earned the credit (cashback: the delivered order; referral: the qualifying one).
  orderId            String?             @map("order_id") @db.Uuid
  /// SELLER_ORDER (cashback) or REFERRAL (the two referral credits) (CHECK), and its id.
  sourceKind         String              @map("source_kind")
  sourceId           String              @map("source_id") @db.Uuid
  amountMinor        BigInt              @map("amount_minor")
  currency           String              @db.VarChar(3)
  /// PENDING, GRANTED, RECORDED or FAILED (CHECK).
  status             String
  /// The wallet's refusal code when FAILED.
  failureCode        String?             @map("failure_code")
  /// The wallet journal that holds the credit, once GRANTED.
  walletJournalId    String?             @map("wallet_journal_id") @db.Uuid
  idempotencyKey     String              @map("idempotency_key")
  createdAt          DateTime            @map("created_at") @db.Timestamptz(6)
  settledAt          DateTime?           @map("settled_at") @db.Timestamptz(6)
  promotion          PromotionsPromotion @relation(fields: [marketId, promotionId], references: [marketId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([marketId, id])
  /// One credit of a kind per source: the event handler's idempotency.
  @@unique([marketId, kind, sourceId])
  @@unique([marketId, idempotencyKey])
  /// The budget of a promotion: the sum of its PENDING and GRANTED credits.
  @@index([marketId, promotionId, status])
  /// What an order has been credited (the cashback cap is per order).
  @@index([marketId, orderId])
  /// What a customer has received from a promotion (the per-customer limit).
  @@index([marketId, promotionId, recipientAccountId])
  @@map("credit_issuances")
  @@schema("promotions")
}

/// Promotions' inbox (P 6.4): one row per consumed event and handler, so a repeated delivery of
/// `ordering.seller-order-delivered.v1` changes nothing. Insert-only.
model PromotionsInbox {
  eventId     String   @map("event_id") @db.Uuid
  /// The subscriber's name, "promotions.<handler>".
  handler     String
  marketId    String   @map("market_id") @db.VarChar(8)
  tenantId    String   @map("tenant_id")
  processedAt DateTime @map("processed_at") @db.Timestamptz(6)

  @@id([eventId, handler])
  @@map("inbox")
  @@schema("promotions")
}
