// The notifications module's tables (support contact, speed mode). Every model is named
// Notifications<Name> and mapped to its table with @@map. The CHECKs and the grants are
// hand-written in the migration.

/// One version of a Market's support email address. Insert-only: the current address is the row
/// with the highest version, and the rows before it are the change history (who, when, before).
model NotificationsSupportContact {
  marketId      String   @map("market_id") @db.VarChar(8)
  /// 1 for the first admin change, +1 for each later one. The primary key refuses two admins
  /// saving from the same version: the second one is told to reload.
  version       Int
  tenantId      String   @map("tenant_id")
  email         String   @db.VarChar(254)
  /// The address before this change; null when the Market default (config) was the first value.
  previousEmail String?  @map("previous_email") @db.VarChar(254)
  changedAt     DateTime @map("changed_at") @db.Timestamptz(6)
  /// The admin account that made the change (a plain id, no foreign key).
  changedBy     String   @map("changed_by") @db.Uuid

  @@id([marketId, version])
  @@map("support_contacts")
  @@schema("notifications")
}

/// Events notifications' subscribers have handled (ADR-0006 decision 5): `runOnce` inserts
/// (event_id, handler) in the handler's own unit and skips the work when the row exists. Written
/// only by platform/persistence/outbox/. The CHECKs and the grants are hand-written in the migration.
model NotificationsInbox {
  eventId     String   @map("event_id") @db.Uuid
  /// The subscriber's name, "notifications.<handler>".
  handler     String
  marketId    String   @map("market_id") @db.VarChar(8)
  tenantId    String   @map("tenant_id")
  processedAt DateTime @map("processed_at") @db.Timestamptz(6)

  @@id([eventId, handler])
  @@map("inbox")
  @@schema("notifications")
}

/// One in-app notice (in-app notifications package 1). Addressed to an audience, not to each
/// person: a `seller` notice is shown to every member of that seller who holds the permission its
/// kind needs, checked when it is read. No text is stored: the panel renders `kind` and `params`
/// (ids and counts only, never a name, an address or an email). Rows leave after the retention
/// period, and the oldest leave once a seller has more than the cap. The CHECKs and the grants are
/// hand-written in the migration.
model NotificationsInAppNotice {
  marketId  String   @map("market_id") @db.VarChar(8)
  /// A UUIDv7, so the id sorts by creation time (the list's cursor).
  id        String   @db.Uuid
  tenantId  String   @map("tenant_id")
  /// `seller` today; `admin` joins with the admin notices.
  audience  String
  /// Set if and only if the audience is `seller` (a plain id, no foreign key).
  sellerId  String?  @map("seller_id") @db.Uuid
  /// What happened, for example `seller.order-paid`.
  kind      String   @db.VarChar(64)
  params    Json     @db.JsonB
  createdAt DateTime @map("created_at") @db.Timestamptz(6)

  reads NotificationsInAppNoticeRead[]

  @@id([marketId, id])
  @@index([marketId, sellerId, id(sort: Desc)])
  @@index([marketId, createdAt])
  @@map("in_app_notices")
  @@schema("notifications")
}

/// That one account has read one notice. Insert-only; it goes with its notice.
model NotificationsInAppNoticeRead {
  marketId  String   @map("market_id") @db.VarChar(8)
  noticeId  String   @map("notice_id") @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  tenantId  String   @map("tenant_id")
  readAt    DateTime @map("read_at") @db.Timestamptz(6)

  notice NotificationsInAppNotice @relation(fields: [marketId, noticeId], references: [marketId, id], onDelete: Cascade, onUpdate: Restrict)

  @@id([marketId, noticeId, accountId])
  @@map("in_app_notice_reads")
  @@schema("notifications")
}
