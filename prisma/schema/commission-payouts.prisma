// The commission-payouts module's tables (Phase 5 package 5, simplified for speed mode). Every
// model is named CommissionPayouts<Name> and mapped to its table with @@map. The CHECKs, the
// insert-only guard and the grants are hand-written in the migration. Money is minor units
// (BigInt) plus a currency; a rate is a whole number of basis points (1500 = 15 %).

/// A seller's own commission rate, set by an admin; it replaces the Market rate (Market config)
/// for orders placed after the change. A seller without a row is on the Market rate.
model CommissionPayoutsSellerCommissionRate {
  marketId  String   @map("market_id") @db.VarChar(8)
  sellerId  String   @map("seller_id") @db.Uuid
  tenantId  String   @map("tenant_id")
  /// 0 to 3000 basis points (CHECK).
  rateBps   Int      @map("rate_bps")
  updatedAt DateTime @map("updated_at") @db.Timestamptz(6)
  /// The admin account that last set it (a plain id, no foreign key).
  updatedBy String   @map("updated_by") @db.Uuid

  @@id([marketId, sellerId])
  @@map("seller_commission_rates")
  @@schema("commission_payouts")
}

/// The seller ledger: one row per money fact of a seller. `sale` and `shipping` are credits and
/// `commission` a debit; their reversals after a refund are the opposite: `refund-sale` and
/// `refund-shipping` are debits, `refund-commission` a credit. `dispute-debit` is a debit and
/// `dispute-reinstate` a credit (only allowed by the CHECK so far). Insert-only: a trigger refuses
/// UPDATE, DELETE and TRUNCATE and the application role holds only SELECT and INSERT. A
/// hand-written unique index on (market_id, seller_order_id, kind, order_line_id, source_id)
/// NULLS NOT DISTINCT stops a fact being written twice.
model CommissionPayoutsLedgerEntry {
  id            String   @id @db.Uuid
  marketId      String   @map("market_id") @db.VarChar(8)
  tenantId      String   @map("tenant_id")
  sellerId      String   @map("seller_id") @db.Uuid
  /// ordering ids (plain, no foreign key across schemas).
  orderId       String   @map("order_id") @db.Uuid
  sellerOrderId String   @map("seller_order_id") @db.Uuid
  /// Null for `shipping`, `refund-shipping` and the dispute kinds only (CHECK).
  orderLineId   String?  @map("order_line_id") @db.Uuid
  /// sale, shipping, commission, refund-sale, refund-shipping, refund-commission, dispute-debit
  /// or dispute-reinstate (CHECK).
  kind          String
  /// Minor units of `currency`, never negative (CHECK); the kind gives the direction.
  amount        BigInt
  currency      String   @db.VarChar(3)
  /// `commission` and `refund-commission` only: the rate frozen on the order line and the base
  /// (line amount without GST; for a reversal, the part of the base it reverses).
  rateBps       Int?     @map("rate_bps")
  baseAmount    BigInt?  @map("base_amount")
  /// The refund (or dispute) a reversal row comes from, a plain id; null for the three original
  /// kinds and not null for every other kind (CHECK).
  sourceId      String?  @map("source_id") @db.Uuid
  /// When the fact happened (the payment confirmed the order).
  occurredAt    DateTime @map("occurred_at") @db.Timestamptz(6)
  recordedAt    DateTime @map("recorded_at") @db.Timestamptz(6)

  /// One row per fact; the migration creates it NULLS NOT DISTINCT (a shipping row has no line, an
  /// original row has no source).
  @@unique([marketId, sellerOrderId, kind, orderLineId, sourceId], map: "ledger_entries_fact_key")
  @@index([marketId, sellerId, recordedAt(sort: Desc), id(sort: Desc)])
  @@index([marketId, sellerOrderId])
  @@map("ledger_entries")
  @@schema("commission_payouts")
}

/// Events commission-payouts' subscribers have handled (ADR-0006 decision 5): `runOnce` inserts
/// (event_id, handler) in the handler's own unit and skips the work when the row exists. Written
/// only by platform/persistence/outbox/. The CHECKs and the grants are hand-written in the
/// migration.
model CommissionPayoutsInbox {
  eventId     String   @map("event_id") @db.Uuid
  /// The subscriber's name, "commission-payouts.<handler>".
  handler     String
  marketId    String   @map("market_id") @db.VarChar(8)
  tenantId    String   @map("tenant_id")
  processedAt DateTime @map("processed_at") @db.Timestamptz(6)

  @@id([eventId, handler])
  @@map("inbox")
  @@schema("commission_payouts")
}

/// A seller's own payout terms (package 6b), set by an admin; every nullable field that is null
/// falls back to the Market's value (Market config `commissionPayouts.payoutTerms`). At least one
/// field is set (CHECK). `version` is the optimistic-concurrency token of an admin edit. The hold
/// bounds (7 to 60 days) are CHECKs, the same numbers as the code constants; the first-payout rule
/// is Market config only and is never overridden.
model CommissionPayoutsPayoutTermsOverride {
  marketId            String   @map("market_id") @db.VarChar(8)
  sellerId            String   @map("seller_id") @db.Uuid
  tenantId            String   @map("tenant_id")
  /// ISO weekday bitmask, bit 0 = Monday (1 to 127, CHECK); null = the Market's weekdays.
  scheduleWeekdays    Int?     @map("schedule_weekdays") @db.SmallInt
  /// Minute of the seller's local day, 0 to 1439 (CHECK); null = the Market's local time.
  localMinute         Int?     @map("local_minute") @db.SmallInt
  holdDaysCarrier     Int?     @map("hold_days_carrier") @db.SmallInt
  holdDaysSellerClick Int?     @map("hold_days_seller_click") @db.SmallInt
  /// Minor units of the Market currency, at least 1 (CHECK).
  minimumMinor        BigInt?  @map("minimum_minor")
  /// AUTO or MANUAL (CHECK).
  approvalMode        String?  @map("approval_mode")
  version             Int
  updatedAt           DateTime @map("updated_at") @db.Timestamptz(6)
  /// The admin account that last wrote it (a plain id, no foreign key).
  updatedBy           String   @map("updated_by") @db.Uuid

  @@id([marketId, sellerId])
  @@map("payout_terms_overrides")
  @@schema("commission_payouts")
}

/// The anchor of a seller order's payout eligibility (package 6b): when it was delivered, who
/// confirmed it (the carrier, or the seller's click) and the instant its money becomes eligible
/// (delivered_at + the hold days then in force). Written once; a trigger refuses any UPDATE and
/// DELETE, and a CHECK ties `eligible_at` to `delivered_at` and the frozen hold days.
model CommissionPayoutsEligibilityAnchor {
  marketId        String   @map("market_id") @db.VarChar(8)
  sellerOrderId   String   @map("seller_order_id") @db.Uuid
  tenantId        String   @map("tenant_id")
  sellerId        String   @map("seller_id") @db.Uuid
  orderId         String   @map("order_id") @db.Uuid
  deliveredAt     DateTime @map("delivered_at") @db.Timestamptz(6)
  /// carrier or seller-click (CHECK).
  anchorSource    String   @map("anchor_source")
  /// 7 to 60 (CHECK); the days added to `delivered_at`.
  holdDaysApplied Int      @map("hold_days_applied") @db.SmallInt
  eligibleAt      DateTime @map("eligible_at") @db.Timestamptz(6)
  recordedAt      DateTime @map("recorded_at") @db.Timestamptz(6)

  @@id([marketId, sellerOrderId])
  @@index([marketId, sellerId, eligibleAt])
  @@map("eligibility_anchors")
  @@schema("commission_payouts")
}

/// A hold on a seller's payouts, for the whole seller or one of its seller orders (package 6b).
/// Insert and release only: a trigger refuses every UPDATE except the one that sets the three
/// release columns once, and every DELETE. The CHECKs, the active-hold indexes and the grants are
/// hand-written in the migration.
model CommissionPayoutsPayoutHold {
  id            String    @id @db.Uuid
  marketId      String    @map("market_id") @db.VarChar(8)
  tenantId      String    @map("tenant_id")
  sellerId      String    @map("seller_id") @db.Uuid
  /// Null = the whole seller; set = that seller order only.
  sellerOrderId String?   @map("seller_order_id") @db.Uuid
  /// seller-suspended, refund-pending, dispute, admin-review or bank-change (CHECK).
  reason        String
  /// admin or system (CHECK).
  origin        String
  /// The thing that caused it: identity's decision id, a refund or dispute id, or (admin) the hold's
  /// own id. A system hold is unique per (market, reason, source, scope) (partial unique index in the migration): a repeated event places nothing twice.
  sourceRef     String    @map("source_ref") @db.Uuid
  /// The admin account that placed it; null for a system hold.
  placedBy      String?   @map("placed_by") @db.Uuid
  placedAt      DateTime  @map("placed_at") @db.Timestamptz(6)
  releasedAt    DateTime? @map("released_at") @db.Timestamptz(6)
  /// The admin account that released it; null while active (a system release is a later package).
  releasedBy    String?   @map("released_by") @db.Uuid
  /// A code from the closed list in the CHECK.
  releaseReason String?   @map("release_reason")

  @@index([marketId, sellerId, placedAt(sort: Desc), id(sort: Desc)], map: "payout_holds_seller_placed_idx")
  @@map("payout_holds")
  @@schema("commission_payouts")
}

/// A snapshot of a payments dispute (package 8b), refreshed from `disputeOf` on every
/// `payments.dispute-changed.v1`. It holds no card, buyer or evidence data. The state only moves
/// forward (a trigger: identity columns never change, the money flags and `closed` only go from
/// false to true, the outcome is set once, the synced version never falls); `bucket` is the admin
/// list's bucket, recomputed by the application with every sync and decision. No DELETE.
model CommissionPayoutsDisputeCase {
  marketId          String    @map("market_id") @db.VarChar(8)
  disputeId         String    @map("dispute_id") @db.Uuid
  tenantId          String    @map("tenant_id")
  orderId           String    @map("order_id") @db.Uuid
  /// Stripe's dispute id (dp_... or du_...), for the Dashboard link the panel builds.
  providerDisputeId String    @map("provider_dispute_id")
  amountMinor       BigInt    @map("amount_minor")
  currency          String    @db.Char(3)
  /// Stripe's status, copied from payments (CHECK).
  status            String
  inquiry           Boolean
  closed            Boolean
  /// won or lost once Stripe closes a chargeback (CHECK).
  outcome           String?
  /// Stripe's reason code; admin-only, never shown to the seller.
  reason            String
  evidenceDueBy     DateTime? @map("evidence_due_by") @db.Timestamptz(6)
  fundsWithdrawn    Boolean   @map("funds_withdrawn")
  fundsWithdrawnAt  DateTime? @map("funds_withdrawn_at") @db.Timestamptz(6)
  fundsReinstated   Boolean   @map("funds_reinstated")
  fundsReinstatedAt DateTime? @map("funds_reinstated_at") @db.Timestamptz(6)
  openedAt          DateTime  @map("opened_at") @db.Timestamptz(6)
  /// When this module first saw the case closed; null while open.
  closedAt          DateTime? @map("closed_at") @db.Timestamptz(6)
  /// needs-response, under-review, decision-needed, won or closed (CHECK).
  bucket            String
  /// The payments version the snapshot came from; an older read never replaces a newer one.
  lastSyncedVersion Int       @map("last_synced_version")
  createdAt         DateTime  @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @map("updated_at") @db.Timestamptz(6)

  @@id([marketId, disputeId])
  @@index([marketId, closed, evidenceDueBy], map: "dispute_cases_closed_due_idx")
  @@index([marketId, bucket, openedAt(sort: Desc), disputeId(sort: Desc)], map: "dispute_cases_bucket_idx")
  @@map("dispute_cases")
  @@schema("commission_payouts")
}

/// An admin's decision on who bears a lost chargeback, per seller order (package 8b). Insert-only.
/// `platform` bears it (no ledger row; no amount) or `seller` repays `amount` (a `dispute-debit`
/// row, written in the same unit). A later `platform` row with `supersedes` set reverses a seller
/// decision after the bank returned the money (a `dispute-reinstate` row).
model CommissionPayoutsDisputeDecision {
  id            String   @id @db.Uuid
  marketId      String   @map("market_id") @db.VarChar(8)
  tenantId      String   @map("tenant_id")
  disputeId     String   @map("dispute_id") @db.Uuid
  sellerOrderId String   @map("seller_order_id") @db.Uuid
  sellerId      String   @map("seller_id") @db.Uuid
  /// platform or seller (CHECK).
  bearer        String
  /// Minor units, set only when the seller bears it (CHECK).
  amountMinor   BigInt?  @map("amount_minor")
  currency      String?  @db.Char(3)
  /// no-delivery-proof, not-as-described, card-fraud-not-seller or other (CHECK).
  reasonCode    String   @map("reason_code")
  /// The admin account (a plain id, no foreign key).
  decidedBy     String   @map("decided_by") @db.Uuid
  decidedAt     DateTime @map("decided_at") @db.Timestamptz(6)
  /// The seller decision this one reverses; null for a first decision.
  supersedes    String?  @db.Uuid

  @@index([marketId, disputeId])
  @@index([marketId, sellerId])
  @@map("dispute_decisions")
  @@schema("commission_payouts")
}

/// Commission-payouts' outbox: `commission-payouts.seller-order-disputed.v1`.
model CommissionPayoutsOutbox {
  /// UUIDv7 stamped by the outbox writer.
  eventId          String    @id @map("event_id") @db.Uuid
  /// "commission-payouts.<subject>-<verb>.v<N>"; the CHECK refuses another module's type.
  type             String
  occurredAt       DateTime  @map("occurred_at") @db.Timestamptz(6)
  marketId         String    @map("market_id") @db.VarChar(8)
  tenantId         String    @map("tenant_id")
  aggregateType    String    @map("aggregate_type")
  aggregateId      String    @map("aggregate_id") @db.Uuid
  aggregateVersion Int       @map("aggregate_version")
  correlationId    String    @map("correlation_id")
  causationId      String?   @map("causation_id") @db.Uuid
  payload          Json      @db.JsonB
  /// Set by the relay; the only column that changes.
  publishedAt      DateTime? @map("published_at") @db.Timestamptz(6)

  @@unique([marketId, aggregateId, aggregateVersion])
  @@map("outbox")
  @@schema("commission_payouts")
}
