// The shipping module's tables (Phase 5 package 4, SHP-01, simplified for speed mode). Every model
// is named Shipping<Name> and mapped to its table with @@map. The CHECKs and the grants are
// hand-written in the migration. Money is minor units (BigInt) plus a currency.

/// A seller order handed to the Market's real-time carrier (SHP-02/03, the `real_time_delivery`
/// FulfillmentStrategy), stored once the carrier confirmed it. No personal data: the carrier holds
/// the two stops. `progress` only moves forward; the CHECKs are hand-written in the migration.
model ShippingCarrierBooking {
  id               String   @id @db.Uuid
  marketId         String   @map("market_id") @db.VarChar(8)
  tenantId         String   @map("tenant_id")
  /// One booking per seller order: also the carrier's `externalReference`.
  sellerOrderId    String   @map("seller_order_id") @db.Uuid
  /// Plain ids of ordering and sellers (no foreign key across schemas).
  orderId          String   @map("order_id") @db.Uuid
  sellerId         String   @map("seller_id") @db.Uuid
  /// The fleet that booked it (mondapac_drive | uber_direct | zoom2u | auspost | fake_test, CHECK).
  fleet            String
  /// The fleet's own id of the delivery: the tracking reference.
  carrierReference String   @map("carrier_reference")
  /// booked | picked-up | delivered | exception | cancelled (CHECK).
  progress         String
  /// The carrier's last status code as received, for an admin.
  carrierStatus    String   @map("carrier_status")
  /// Raised by each change; the aggregate version of its event.
  version          Int
  createdAt        DateTime @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @map("updated_at") @db.Timestamptz(6)

  @@unique([marketId, sellerOrderId])
  @@unique([marketId, fleet, carrierReference])
  @@map("carrier_bookings")
  @@schema("shipping")
}

/// A carrier webhook event already taken, by the carrier's event id: a repeat changes nothing.
/// Insert-only; nothing of the event's body is kept. `carrier` holds the fleet code.
model ShippingCarrierEvent {
  marketId   String   @map("market_id") @db.VarChar(8)
  tenantId   String   @map("tenant_id")
  carrier    String
  eventId    String   @map("event_id") @db.Uuid
  receivedAt DateTime @map("received_at") @db.Timestamptz(6)

  @@id([marketId, carrier, eventId])
  @@map("carrier_events")
  @@schema("shipping")
}

/// Shipping's outbox: `shipping.carrier-delivery-progressed.v1`.
model ShippingOutbox {
  /// UUIDv7 stamped by the outbox writer.
  eventId          String    @id @map("event_id") @db.Uuid
  /// "shipping.<subject>-<verb>.v<N>"; the CHECK refuses another module's type.
  type             String
  /// The instant the use case took from Clock (UTC).
  occurredAt       DateTime  @map("occurred_at") @db.Timestamptz(6)
  /// Market of the unit that wrote the event (ADR-0003); stamped by the writer.
  marketId         String    @map("market_id") @db.VarChar(8)
  /// Tenant seam (ADR-0001); stamped by the writer, no database default.
  tenantId         String    @map("tenant_id")
  aggregateType    String    @map("aggregate_type")
  aggregateId      String    @map("aggregate_id") @db.Uuid
  /// The aggregate's version after the change; unique per aggregate (P 10).
  aggregateVersion Int       @map("aggregate_version")
  correlationId    String    @map("correlation_id")
  /// The consumed event that caused this one, or null.
  causationId      String?   @map("causation_id") @db.Uuid
  payload          Json      @db.JsonB
  /// Set by the relay when the event was handed to the bus; the only column that changes.
  publishedAt      DateTime? @map("published_at") @db.Timestamptz(6)

  /// No two events of one aggregate share a version (I7); led by market_id (data design C7).
  @@unique([marketId, aggregateId, aggregateVersion])
  @@map("outbox")
  @@schema("shipping")
}

/// A fleet-selection model (delivery models, package 3): a named rule an admin defines to rank the
/// fleets that can carry a seller order. `kind` is cheapest | weighted | fixed_priority; `rule` is
/// the kind's settings (weights, or the ordered fleet list), checked by the application and by
/// CHECKs. Models are created and edited, never deleted; `version` rises with each edit.
model ShippingFleetSelectionModel {
  id        String   @id @db.Uuid
  marketId  String   @map("market_id") @db.VarChar(8)
  tenantId  String   @map("tenant_id")
  name      String
  kind      String
  rule      Json     @db.JsonB
  version   Int
  createdAt DateTime @map("created_at") @db.Timestamptz(6)
  /// Admin accounts (plain ids, no foreign key).
  createdBy String   @map("created_by") @db.Uuid
  updatedAt DateTime @map("updated_at") @db.Timestamptz(6)
  updatedBy String   @map("updated_by") @db.Uuid

  assignments ShippingFleetSelectionAssignment[]

  @@unique([marketId, id])
  @@map("fleet_selection_models")
  @@schema("shipping")
}

/// The active model per Market and delivery method. A null `model_id` (or no row) means the
/// built-in default order. Rows are never deleted.
model ShippingFleetSelectionAssignment {
  marketId  String   @map("market_id") @db.VarChar(8)
  tenantId  String   @map("tenant_id")
  /// instant | same_day | scheduled (CHECK).
  method    String
  modelId   String?  @map("model_id") @db.Uuid
  updatedAt DateTime @map("updated_at") @db.Timestamptz(6)
  updatedBy String   @map("updated_by") @db.Uuid

  model ShippingFleetSelectionModel? @relation(fields: [marketId, modelId], references: [marketId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([marketId, method])
  @@map("fleet_selection_assignments")
  @@schema("shipping")
}

/// The admin-set reliability score (0 to 100) of a fleet in a Market, an input of the `weighted`
/// kind. A computed score from delivery history replaces it later. No row: the neutral default.
model ShippingFleetReliability {
  marketId  String   @map("market_id") @db.VarChar(8)
  tenantId  String   @map("tenant_id")
  fleet     String
  score     Int
  updatedAt DateTime @map("updated_at") @db.Timestamptz(6)
  updatedBy String   @map("updated_by") @db.Uuid

  @@id([marketId, fleet])
  @@map("fleet_reliability")
  @@schema("shipping")
}

/// A booking the router is making (or made without learning the answer) for a seller order, so a
/// repeat after a lost answer goes to the same fleet, and never to a second fleet. Written before
/// the fleet is called; removed with the booking row, or when the fleet answers that nothing was
/// booked. A row left behind means the order may already be booked there.
model ShippingFleetBookingAttempt {
  marketId      String   @map("market_id") @db.VarChar(8)
  tenantId      String   @map("tenant_id")
  sellerOrderId String   @map("seller_order_id") @db.Uuid
  fleet         String
  attemptedAt   DateTime @map("attempted_at") @db.Timestamptz(6)

  @@id([marketId, sellerOrderId])
  @@map("fleet_booking_attempts")
  @@schema("shipping")
}

/// The delivery settings of a Market (delivery models, package 4): which methods are on, the
/// same-day cut-off, the scheduled days ahead and window length, and the margin on a fleet's
/// quote. One row per Market; no row means the defaults of the domain (every method on, 12:00,
/// 7 days, 120 minutes, no margin). `version` rises with each save (optimistic concurrency).
/// Value ranges are CHECKs in the migration. Rows are never deleted.
model ShippingDeliverySettings {
  marketId               String   @id @map("market_id") @db.VarChar(8)
  tenantId               String   @map("tenant_id")
  pickupEnabled          Boolean  @map("pickup_enabled")
  instantEnabled         Boolean  @map("instant_enabled")
  sameDayEnabled         Boolean  @map("same_day_enabled")
  scheduledEnabled       Boolean  @map("scheduled_enabled")
  /// Minutes after local midnight, 0 to 1439 (CHECK).
  sameDayCutoffMinutes   Int      @map("same_day_cutoff_minutes")
  scheduledDaysAhead     Int      @map("scheduled_days_ahead")
  scheduledWindowMinutes Int      @map("scheduled_window_minutes")
  /// none | percent | fixed (CHECK); the amount column of the kind is set, the other is null.
  marginKind             String   @map("margin_kind")
  marginBasisPoints      Int?     @map("margin_basis_points")
  /// Minor units of the Market currency.
  marginFixedMinor       Int?     @map("margin_fixed_minor")
  /// 1 (none), 5, 10, 50 or 100 minor units, rounded up (CHECK).
  roundingStepMinor      Int      @map("rounding_step_minor")
  version                Int
  updatedAt              DateTime @map("updated_at") @db.Timestamptz(6)
  /// The admin account that last saved it (a plain id, no foreign key).
  updatedBy              String   @map("updated_by") @db.Uuid

  @@map("delivery_settings")
  @@schema("shipping")
}

/// The delivery methods an admin took away from a seller (for example one without the capacity
/// for instant delivery). No row, or an empty list, means the seller supports every method the
/// Market has on. The list holds what is NOT supported, so a method the Market switches on later
/// is also open to sellers that never opted out. Rows are never deleted.
model ShippingSellerDeliveryMethods {
  marketId    String   @map("market_id") @db.VarChar(8)
  sellerId    String   @map("seller_id") @db.Uuid
  tenantId    String   @map("tenant_id")
  /// Subset of pickup, instant, same_day, scheduled (CHECK); the domain stores each once.
  unsupported String[]
  updatedAt   DateTime @map("updated_at") @db.Timestamptz(6)
  /// The admin account that last set it (a plain id, no foreign key).
  updatedBy   String   @map("updated_by") @db.Uuid

  @@id([marketId, sellerId])
  @@map("seller_delivery_methods")
  @@schema("shipping")
}

/// A delivery price quoted to a buyer at checkout (delivery models, package 5): the fleet the
/// router chose, the fleet's quote, the platform's margin and what the buyer pays, for one seller,
/// one delivery method and one saved drop-off (its postcode). The checkout charges a stored quote,
/// never a price sent by the client; a quote is reused while it is fresh (10 minutes, and never past
/// the fleet's own expiry) and asked again after. Insert-only; a buyer's expired quotes are removed
/// when the buyer asks for new ones. No personal data: the postcode of an address and plain ids.
model ShippingDeliveryQuote {
  id              String    @id @db.Uuid
  marketId        String    @map("market_id") @db.VarChar(8)
  tenantId        String    @map("tenant_id")
  /// The customer account the quote was made for (a plain id, no foreign key).
  accountId       String    @map("account_id") @db.Uuid
  sellerId        String    @map("seller_id") @db.Uuid
  /// instant | same_day | scheduled (CHECK); a pickup is free and has no quote.
  method          String
  dropoffPostcode String    @map("dropoff_postcode") @db.VarChar(16)
  /// The fleet that quoted (mondapac_drive | uber_direct | zoom2u | auspost | fake_test, CHECK).
  fleet           String
  /// Minor units of `currency`: the fleet's price, the platform's margin, and what the buyer pays
  /// (`total` = `quote_amount` + `margin_amount`, CHECK).
  quoteAmount     BigInt    @map("quote_amount")
  marginAmount    BigInt    @map("margin_amount")
  totalAmount     BigInt    @map("total_amount")
  currency        String    @db.VarChar(3)
  etaMinutes      Int?      @map("eta_minutes")
  quotedAt        DateTime  @map("quoted_at") @db.Timestamptz(6)
  /// The fleet's own expiry when it gave one, else null.
  fleetExpiresAt  DateTime? @map("fleet_expires_at") @db.Timestamptz(6)
  /// When the quote stops being charged: 10 minutes after `quoted_at`, or the fleet's expiry if
  /// that is earlier.
  validUntil      DateTime  @map("valid_until") @db.Timestamptz(6)

  @@unique([marketId, id])
  @@index([marketId, accountId, sellerId, method, quotedAt])
  @@map("delivery_quotes")
  @@schema("shipping")
}

/// A fee a fleet charged the platform for a delivery (cancel, waiting, return), as the fleet
/// reported it (delivery models, package 5). The buyer is never charged these; the ledger only
/// records what the platform paid. Insert-only; `external_ref` is the fleet's own id of the fee (or
/// a stable key the adapter derives), so a repeated report records once.
model ShippingFleetFee {
  id            String   @id @db.Uuid
  marketId      String   @map("market_id") @db.VarChar(8)
  tenantId      String   @map("tenant_id")
  fleet         String
  /// Plain ids of the seller order and its order (no foreign key across schemas).
  sellerOrderId String   @map("seller_order_id") @db.Uuid
  /// cancel | waiting | return | other (CHECK).
  reason        String
  /// Minor units of `currency`, above zero (CHECK).
  amount        BigInt
  currency      String   @db.VarChar(3)
  externalRef   String   @map("external_ref")
  occurredAt    DateTime @map("occurred_at") @db.Timestamptz(6)
  recordedAt    DateTime @map("recorded_at") @db.Timestamptz(6)

  @@unique([marketId, fleet, externalRef])
  @@index([marketId, sellerOrderId])
  @@map("fleet_fees")
  @@schema("shipping")
}

/// A booking the router gave to another fleet than the one quoted and charged: what the buyer was
/// charged for the fleet, what the booked fleet costs, and how much of the difference the platform
/// absorbs (up to the Market's cap). A difference above the cap is flagged for an admin
/// (`over_cap`). One row per seller order; the buyer is never charged more after payment.
model ShippingDeliveryFallback {
  marketId      String   @map("market_id") @db.VarChar(8)
  tenantId      String   @map("tenant_id")
  sellerOrderId String   @map("seller_order_id") @db.Uuid
  chargedFleet  String   @map("charged_fleet")
  bookedFleet   String   @map("booked_fleet")
  /// Minor units of `currency`. `difference` = booked price - charged fleet quote, never below
  /// zero: the platform absorbs it, because the buyer has paid and the delivery goes ahead. Both
  /// are null (and `over_cap` is set) when the booked fleet's price could not be read. `over_cap`
  /// says the difference passed `cap_minor`, the Market's cap at the time, so an admin looks.
  chargedQuote  BigInt   @map("charged_quote")
  bookedPrice   BigInt?  @map("booked_price")
  difference    BigInt?
  capMinor      Int      @map("cap_minor")
  overCap       Boolean  @map("over_cap")
  currency      String   @db.VarChar(3)
  recordedAt    DateTime @map("recorded_at") @db.Timestamptz(6)

  @@id([marketId, sellerOrderId])
  @@map("delivery_fallbacks")
  @@schema("shipping")
}
