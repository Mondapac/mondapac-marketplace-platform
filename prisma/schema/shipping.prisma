// The shipping module's tables (Phase 5 package 4, SHP-01, simplified for speed mode). Every model
// is named Shipping<Name> and mapped to its table with @@map. The CHECKs and the grants are
// hand-written in the migration. Money is minor units (BigInt) plus a currency.

/// The flat shipping fee of a seller: one fee per seller order, set by an admin. A seller with no
/// row cannot be bought from. Zero is a valid fee (free shipping). Rows are never deleted.
model ShippingSellerFlatFee {
  marketId  String   @map("market_id") @db.VarChar(8)
  sellerId  String   @map("seller_id") @db.Uuid
  tenantId  String   @map("tenant_id")
  /// Minor units of `currency`, 0 to 100000 (CHECK).
  amount    BigInt
  currency  String   @db.VarChar(3)
  updatedAt DateTime @map("updated_at") @db.Timestamptz(6)
  /// The admin account that last set it (a plain id, no foreign key).
  updatedBy String   @map("updated_by") @db.Uuid

  @@id([marketId, sellerId])
  @@map("seller_flat_fees")
  @@schema("shipping")
}

/// A seller order handed to the Market's real-time carrier (SHP-02/03, the `real_time_delivery`
/// FulfillmentStrategy), stored once the carrier confirmed it. No personal data: the carrier holds
/// the two stops. `progress` only moves forward; the CHECKs are hand-written in the migration.
model ShippingCarrierBooking {
  id               String   @id @db.Uuid
  marketId         String   @map("market_id") @db.VarChar(8)
  tenantId         String   @map("tenant_id")
  /// One booking per seller order: also the carrier's `externalReference`.
  sellerOrderId    String   @map("seller_order_id") @db.Uuid
  /// Plain ids of ordering and sellers (no foreign key across schemas).
  orderId          String   @map("order_id") @db.Uuid
  sellerId         String   @map("seller_id") @db.Uuid
  /// The fleet that booked it (mondapac_drive | uber_direct | zoom2u | auspost | fake_test, CHECK).
  fleet            String
  /// The fleet's own id of the delivery: the tracking reference.
  carrierReference String   @map("carrier_reference")
  /// booked | picked-up | delivered | exception | cancelled (CHECK).
  progress         String
  /// The carrier's last status code as received, for an admin.
  carrierStatus    String   @map("carrier_status")
  /// Raised by each change; the aggregate version of its event.
  version          Int
  /// A link the buyer can follow, only when the fleet gave one and it is https (CHECK).
  trackingUrl      String?  @map("tracking_url")
  /// When the fleet reported that proof of delivery exists. Only the instant: never the photo, the
  /// signature image or the recipient's name.
  podRecordedAt    DateTime? @map("pod_recorded_at") @db.Timestamptz(6)
  /// When the status poll last asked the fleet (null: never). Orders the poll fairly.
  polledAt         DateTime? @map("polled_at") @db.Timestamptz(6)
  createdAt        DateTime @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @map("updated_at") @db.Timestamptz(6)

  @@unique([marketId, sellerOrderId])
  @@unique([marketId, fleet, carrierReference])
  @@map("carrier_bookings")
  @@schema("shipping")
}

/// A carrier webhook event already taken, by the carrier's event id: a repeat changes nothing.
/// Insert-only; nothing of the event's body is kept. `carrier` holds the fleet code.
model ShippingCarrierEvent {
  marketId   String   @map("market_id") @db.VarChar(8)
  tenantId   String   @map("tenant_id")
  carrier    String
  eventId    String   @map("event_id") @db.Uuid
  receivedAt DateTime @map("received_at") @db.Timestamptz(6)

  @@id([marketId, carrier, eventId])
  @@map("carrier_events")
  @@schema("shipping")
}

/// Shipping's outbox: `shipping.carrier-delivery-progressed.v1`.
model ShippingOutbox {
  /// UUIDv7 stamped by the outbox writer.
  eventId          String    @id @map("event_id") @db.Uuid
  /// "shipping.<subject>-<verb>.v<N>"; the CHECK refuses another module's type.
  type             String
  /// The instant the use case took from Clock (UTC).
  occurredAt       DateTime  @map("occurred_at") @db.Timestamptz(6)
  /// Market of the unit that wrote the event (ADR-0003); stamped by the writer.
  marketId         String    @map("market_id") @db.VarChar(8)
  /// Tenant seam (ADR-0001); stamped by the writer, no database default.
  tenantId         String    @map("tenant_id")
  aggregateType    String    @map("aggregate_type")
  aggregateId      String    @map("aggregate_id") @db.Uuid
  /// The aggregate's version after the change; unique per aggregate (P 10).
  aggregateVersion Int       @map("aggregate_version")
  correlationId    String    @map("correlation_id")
  /// The consumed event that caused this one, or null.
  causationId      String?   @map("causation_id") @db.Uuid
  payload          Json      @db.JsonB
  /// Set by the relay when the event was handed to the bus; the only column that changes.
  publishedAt      DateTime? @map("published_at") @db.Timestamptz(6)

  /// No two events of one aggregate share a version (I7); led by market_id (data design C7).
  @@unique([marketId, aggregateId, aggregateVersion])
  @@map("outbox")
  @@schema("shipping")
}

/// A fleet-selection model (delivery models, package 3): a named rule an admin defines to rank the
/// fleets that can carry a seller order. `kind` is cheapest | weighted | fixed_priority; `rule` is
/// the kind's settings (weights, or the ordered fleet list), checked by the application and by
/// CHECKs. Models are created and edited, never deleted; `version` rises with each edit.
model ShippingFleetSelectionModel {
  id        String   @id @db.Uuid
  marketId  String   @map("market_id") @db.VarChar(8)
  tenantId  String   @map("tenant_id")
  name      String
  kind      String
  rule      Json     @db.JsonB
  version   Int
  createdAt DateTime @map("created_at") @db.Timestamptz(6)
  /// Admin accounts (plain ids, no foreign key).
  createdBy String   @map("created_by") @db.Uuid
  updatedAt DateTime @map("updated_at") @db.Timestamptz(6)
  updatedBy String   @map("updated_by") @db.Uuid

  assignments ShippingFleetSelectionAssignment[]

  @@unique([marketId, id])
  @@map("fleet_selection_models")
  @@schema("shipping")
}

/// The active model per Market and delivery method. A null `model_id` (or no row) means the
/// built-in default order. Rows are never deleted.
model ShippingFleetSelectionAssignment {
  marketId  String   @map("market_id") @db.VarChar(8)
  tenantId  String   @map("tenant_id")
  /// instant | same_day | scheduled (CHECK).
  method    String
  modelId   String?  @map("model_id") @db.Uuid
  updatedAt DateTime @map("updated_at") @db.Timestamptz(6)
  updatedBy String   @map("updated_by") @db.Uuid

  model ShippingFleetSelectionModel? @relation(fields: [marketId, modelId], references: [marketId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([marketId, method])
  @@map("fleet_selection_assignments")
  @@schema("shipping")
}

/// The admin-set reliability score (0 to 100) of a fleet in a Market, an input of the `weighted`
/// kind. A computed score from delivery history replaces it later. No row: the neutral default.
model ShippingFleetReliability {
  marketId  String   @map("market_id") @db.VarChar(8)
  tenantId  String   @map("tenant_id")
  fleet     String
  score     Int
  updatedAt DateTime @map("updated_at") @db.Timestamptz(6)
  updatedBy String   @map("updated_by") @db.Uuid

  @@id([marketId, fleet])
  @@map("fleet_reliability")
  @@schema("shipping")
}

/// A booking the router is making (or made without learning the answer) for a seller order, so a
/// repeat after a lost answer goes to the same fleet, and never to a second fleet. Written before
/// the fleet is called; removed with the booking row, or when the fleet answers that nothing was
/// booked. A row left behind means the order may already be booked there.
model ShippingFleetBookingAttempt {
  marketId      String   @map("market_id") @db.VarChar(8)
  tenantId      String   @map("tenant_id")
  sellerOrderId String   @map("seller_order_id") @db.Uuid
  fleet         String
  attemptedAt   DateTime @map("attempted_at") @db.Timestamptz(6)

  @@id([marketId, sellerOrderId])
  @@map("fleet_booking_attempts")
  @@schema("shipping")
}
