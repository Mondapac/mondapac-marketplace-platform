// The settings module's tables (admin-editable Market settings, ADR-0026). Every model is named
// Settings<Name> and mapped to its table with @@map. The CHECKs, the triggers and the grants are
// hand-written in the migration.

/// The current value of one setting in one Market. A missing row means the setting's default.
model SettingsMarketSetting {
  marketId           String   @map("market_id") @db.VarChar(8)
  tenantId           String   @map("tenant_id")
  /// The setting's code, declared in code (domain/definitions.ts), e.g. "list-paging".
  code               String
  value              String
  /// 1 for the first admin change, +1 for each later one. A stale edit is refused.
  version            Int
  updatedAt          DateTime @map("updated_at") @db.Timestamptz(6)
  updatedByAccountId String   @map("updated_by_account_id") @db.Uuid

  @@id([marketId, code])
  @@map("market_settings")
  @@schema("settings")
}

/// One row per change, insert-only: the history of a setting (who, when, before, after).
model SettingsMarketSettingHistory {
  marketId           String   @map("market_id") @db.VarChar(8)
  tenantId           String   @map("tenant_id")
  code               String
  version            Int
  /// The value before this change; null when the default was in force.
  previousValue      String?  @map("previous_value")
  value              String
  changedAt          DateTime @map("changed_at") @db.Timestamptz(6)
  changedByAccountId String   @map("changed_by_account_id") @db.Uuid
  /// The admin's reason, 1 to 500 trimmed characters, when the change carried one (always for an
  /// emergency stop); kept whether or not the area is reviewed. CHECK in the migration.
  note               String?

  @@id([marketId, code, version])
  @@map("market_setting_history")
  @@schema("settings")
}

/// settings' outbox (AI Gateway G6e2): the in-house auto-rollback event the admin bell notice
/// follows. Codes only (task type, stage, reason), never a model's text. Every outbox of every
/// module has exactly these fields.
model SettingsOutbox {
  /// UUIDv7 stamped by the outbox writer.
  eventId          String    @id @map("event_id") @db.Uuid
  /// "settings.<subject>-<verb>.v<N>"; the CHECK refuses another module's type.
  type             String
  /// The instant the use case took from Clock (UTC).
  occurredAt       DateTime  @map("occurred_at") @db.Timestamptz(6)
  /// Market of the unit that wrote the event (ADR-0003); stamped by the writer.
  marketId         String    @map("market_id") @db.VarChar(8)
  /// Tenant seam (ADR-0001); stamped by the writer, no database default.
  tenantId         String    @map("tenant_id")
  aggregateType    String    @map("aggregate_type")
  aggregateId      String    @map("aggregate_id") @db.Uuid
  /// The aggregate's version after the change; unique per aggregate (P 10).
  aggregateVersion Int       @map("aggregate_version")
  correlationId    String    @map("correlation_id")
  /// The consumed event that caused this one, or null.
  causationId      String?   @map("causation_id") @db.Uuid
  payload          Json      @db.JsonB
  /// Set by the relay when the event was handed to the bus; the only column that changes.
  publishedAt      DateTime? @map("published_at") @db.Timestamptz(6)

  /// No two events of one aggregate share a version (I7); led by market_id (data design C7).
  @@unique([marketId, aggregateId, aggregateVersion])
  @@map("outbox")
  @@schema("settings")
}
