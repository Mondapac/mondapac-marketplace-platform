// Shared Prisma configuration (ADR-0004). Models live in one file per module next to
// this one; each module owns exactly one PostgreSQL schema and no relation may cross
// schemas.

generator client {
  provider            = "prisma-client"
  output              = "../../apps/api/src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

// The model map of the market guard and the "model to owning module" rule (platform
// persistence design, section 9): written on every `prisma generate`, beside the client.
generator modelMap {
  provider = "node scripts/generate-model-map.mjs"
  output   = "../../apps/api/src/generated/model-map.ts"
}

datasource db {
  provider = "postgresql"
  schemas  = ["assistant", "blog", "cart", "catalog", "certification", "commission_payouts", "customers", "engagement", "identity", "inventory", "legal", "notifications", "ordering", "payments", "platform", "pricing", "promotions", "reviews", "search", "sellers", "shipping", "storefront", "tax", "wallet"]
}
