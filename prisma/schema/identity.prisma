// The identity module (schema "identity"). Physical design: docs/design/data/identity.md;
// every model is named Identity<Name> (its C9) and mapped to its table with @@map.

/// Events of the identity module (ADR-0006 decisions 1 and 2; data design 3.1, PM1). Written
/// only by the platform OutboxWriter in the unit of the state change, read and marked only by
/// the relay (platform/persistence/outbox/; platform persistence design 9, the named
/// exception). Every outbox of every module has exactly these fields. The CHECKs, the partial
/// claim index and the grants (published_at is the only column the application may update)
/// are hand-written in the migration. Payloads hold identifiers, codes and permission keys
/// only (P 5.3); no personal data in any column.
model IdentityOutbox {
  /// UUIDv7 stamped by the outbox writer.
  eventId          String    @id @map("event_id") @db.Uuid
  /// "identity.<subject>-<verb>.v<N>"; the CHECK refuses another module's type.
  type             String
  /// The instant the use case took from Clock (UTC).
  occurredAt       DateTime  @map("occurred_at") @db.Timestamptz(6)
  /// Market of the unit that wrote the event (ADR-0003); stamped by the writer.
  marketId         String    @map("market_id") @db.VarChar(8)
  /// Tenant seam (ADR-0001); stamped by the writer, no database default.
  tenantId         String    @map("tenant_id")
  aggregateType    String    @map("aggregate_type")
  aggregateId      String    @map("aggregate_id") @db.Uuid
  /// The aggregate's version after the change; unique per aggregate (P 10).
  aggregateVersion Int       @map("aggregate_version")
  correlationId    String    @map("correlation_id")
  /// The consumed event that caused this one, or null.
  causationId      String?   @map("causation_id") @db.Uuid
  payload          Json      @db.JsonB
  /// Set by the relay when the event was handed to the bus; the only column that changes.
  publishedAt      DateTime? @map("published_at") @db.Timestamptz(6)

  /// No two events of one aggregate share a version (I7); led by market_id (data design C7).
  @@unique([marketId, aggregateId, aggregateVersion])
  @@map("outbox")
  @@schema("identity")
}

/// An account of one population in one Market (identity design 2.1; data design 3.3). There is
/// no global user: the same address may hold a customer, a seller-side and an admin account,
/// and accounts in other Markets. Email and display name are personal data, kept plain (D 11.2
/// option A); the account id is also the subject id of its data key (platform.subject_keys).
/// The CHECKs, the partial index and the grants are hand-written in the migration.
model IdentityAccount {
  /// UUIDv7 from the IdGenerator; the subject of the account's data key.
  id                      String                      @id @db.Uuid
  /// Market of the account (ADR-0003); never changes.
  marketId                String                      @map("market_id") @db.VarChar(8)
  /// Tenant seam (ADR-0001); supplied by the repository, no database default.
  tenantId                String                      @map("tenant_id")
  /// customer | seller | admin; never changes.
  population              String
  /// Personal. As typed, trimmed.
  email                   String
  /// Personal. Trimmed, NFC, lower-cased: the uniqueness and lookup value.
  emailNormalized         String                      @map("email_normalized")
  /// Personal. NULL only for a customer (accounts_display_name_required_check; data design 11.5).
  displayName             String?                     @map("display_name")
  /// active | disabled.
  status                  String
  /// NULL while the email is unverified.
  emailVerifiedAt         DateTime?                   @map("email_verified_at") @db.Timestamptz(6)
  /// The last "you already have an account" notice (D 6.7).
  existingAccountNoticeAt DateTime?                   @map("existing_account_notice_at") @db.Timestamptz(6)
  /// The latest sign-up: the anchor of the 7-day purge (M5).
  signedUpAt              DateTime                    @map("signed_up_at") @db.Timestamptz(6)
  /// Optimistic version of the aggregate (P 10); 1 at insert.
  version                 Int
  createdAt               DateTime                    @map("created_at") @db.Timestamptz(6)
  passwordCredential      IdentityPasswordCredential?
  sessions                IdentitySession[]
  oneTimeLinks            IdentityOneTimeLink[]

  /// ADR-0018 decision 3: one account per Market, population and normalised email.
  @@unique([marketId, population, emailNormalized])
  /// The target of composite foreign keys (data design C3).
  @@unique([marketId, id])
  @@map("accounts")
  @@schema("identity")
}

/// The password credential of an account (data design 3.3): a table of its own, so a query on
/// accounts can never return a hash. One per account; removed only with its account.
model IdentityPasswordCredential {
  marketId     String          @map("market_id") @db.VarChar(8)
  tenantId     String          @map("tenant_id")
  accountId    String          @map("account_id") @db.Uuid
  /// A PHC string (argon2id); never the password.
  passwordHash String          @map("password_hash")
  changedAt    DateTime        @map("changed_at") @db.Timestamptz(6)
  account      IdentityAccount @relation(fields: [marketId, accountId], references: [marketId, id], onDelete: Cascade, onUpdate: Restrict)

  @@id([marketId, accountId])
  @@map("password_credentials")
  @@schema("identity")
}

/// A session of one account on one transport (identity design 3.5, 6.1, 6.2; data design 3.4).
/// Only the SHA-256 of the token is stored (ADR-0018 decision 2); the token itself never is. Not
/// versioned (M1): it changes only by single guarded statements (revocation, the once-a-minute
/// last_seen_at write). Expiry is decided at read time from Clock, never by a job. The CHECKs,
/// the partial seller index and the grants are hand-written in the migration.
model IdentitySession {
  /// UUIDv7; the sessionId of the ActorContext, never the token.
  id                 String          @id @db.Uuid
  marketId           String          @map("market_id") @db.VarChar(8)
  tenantId           String          @map("tenant_id")
  accountId          String          @map("account_id") @db.Uuid
  /// Copy of the account's population, fixed at creation.
  population         String
  /// Copy of the active membership's seller (seller population only); its foreign key arrives
  /// with seller_access in slice 5.
  sellerId           String?         @map("seller_id") @db.Uuid
  /// SHA-256 of the token (32 bytes).
  tokenHash          Bytes           @map("token_hash")
  /// cookie | bearer: a session is refused on the other transport.
  transport          String
  createdAt          DateTime        @map("created_at") @db.Timestamptz(6)
  /// Written at most once a minute; in no index, so the update can stay HOT.
  lastSeenAt         DateTime        @map("last_seen_at") @db.Timestamptz(6)
  /// Fixed at creation from the population's policy (M2).
  idleTimeoutSeconds Int             @map("idle_timeout_seconds")
  /// Fixed at creation; never extended.
  absoluteExpiresAt  DateTime        @map("absolute_expires_at") @db.Timestamptz(6)
  revokedAt          DateTime?       @map("revoked_at") @db.Timestamptz(6)
  /// A code (sign-out, password-changed, ...), set with revoked_at.
  revokedReason      String?         @map("revoked_reason")
  account            IdentityAccount @relation(fields: [marketId, accountId], references: [marketId, id], onDelete: Cascade, onUpdate: Restrict)

  /// The per-request read of the Authenticator.
  @@unique([marketId, tokenHash])
  /// Revocation of every session of an account.
  @@index([marketId, accountId])
  /// identity.purge-expired: rows 30 days past their absolute expiry.
  @@index([marketId, absoluteExpiresAt])
  @@map("sessions")
  @@schema("identity")
}

/// A throttle counter (identity design 6.8; data design 3.5): a fixed window with a block
/// instant (M11), keyed by an HMAC-SHA-256 under the stack's throttle secret. No address and
/// no email is stored, only keyed hashes, also for unknown addresses. Transient: purged 48
/// hours after its window started unless blocked.
model IdentitySignInThrottle {
  marketId        String    @map("market_id") @db.VarChar(8)
  tenantId        String    @map("tenant_id")
  /// The counter: a closed list in the CHECK; a new kind is a migration.
  kind            String
  /// HMAC-SHA-256 of what the kind counts (32 bytes).
  keyHash         Bytes     @map("key_hash")
  /// HMAC-SHA-256 of (Market, population, normalised email); NULL only for the origin kinds,
  /// so a password reset clears every counter of an address.
  accountKey      Bytes?    @map("account_key")
  windowStartedAt DateTime  @map("window_started_at") @db.Timestamptz(6)
  /// Reserved and failed attempts in the window.
  attempts        Int
  /// Set by a failure that reaches the threshold.
  blockedUntil    DateTime? @map("blocked_until") @db.Timestamptz(6)

  @@id([marketId, kind, keyHash])
  /// Clearing every counter of an address at a password reset.
  @@index([marketId, accountKey])
  @@map("sign_in_throttles")
  @@schema("identity")
}

/// One sign-in attempt of any population (identity design 10.2; data design 3.6, I8):
/// append-only for the application by privilege (no UPDATE), kept 90 days with the full
/// client address (H3), then deleted by identity.purge-expired. Never the typed email.
model IdentitySignInRecord {
  /// UUIDv7.
  id            String   @id @db.Uuid
  marketId      String   @map("market_id") @db.VarChar(8)
  tenantId      String   @map("tenant_id")
  /// The sign-in page that was used.
  population    String
  /// Plain id (C4); NULL for an unknown address.
  accountId     String?  @map("account_id") @db.Uuid
  /// The outcome code of identity design 6.3.
  outcome       String
  occurredAt    DateTime @map("occurred_at") @db.Timestamptz(6)
  /// Personal: the client address, the only place in the database that stores one.
  origin        String   @db.Inet
  /// Plain id; set on success.
  sessionId     String?  @map("session_id") @db.Uuid
  correlationId String   @map("correlation_id")

  /// The retention purge, one day of occurred_at per statement.
  @@index([marketId, occurredAt])
  @@map("sign_in_records")
  @@schema("identity")
}

/// A one-time link of an account for one purpose (identity design 3.7, 6.6; data design 3.7):
/// one row per account and purpose, reused by every new request (the hash, the instants and
/// consumed_at are reset and the version raised), so at most one link is usable (AC 19). Only
/// the SHA-256 of the token is stored, and only after the mail was sent: a requested row has no
/// token yet. Single use is one conditional update. The CHECKs and the grants are hand-written
/// in the migration.
model IdentityOneTimeLink {
  /// UUIDv7; the linkId of identity.one-time-link-requested.v1.
  id          String          @id @db.Uuid
  marketId    String          @map("market_id") @db.VarChar(8)
  tenantId    String          @map("tenant_id")
  accountId   String          @map("account_id") @db.Uuid
  /// verify-email | reset-password | enrol-second-factor | confirm-second-factor-reset.
  purpose     String
  /// The latest request.
  requestedAt DateTime        @map("requested_at") @db.Timestamptz(6)
  /// SHA-256 of the token (32 bytes); NULL while requested.
  tokenHash   Bytes?          @map("token_hash")
  /// Set with the hash by the mail handler; the lifetime counts from here.
  issuedAt    DateTime?       @map("issued_at") @db.Timestamptz(6)
  expiresAt   DateTime?       @map("expires_at") @db.Timestamptz(6)
  consumedAt  DateTime?       @map("consumed_at") @db.Timestamptz(6)
  /// Optimistic version of the aggregate (P 10); 1 at insert.
  version     Int
  account     IdentityAccount @relation(fields: [marketId, accountId], references: [marketId, id], onDelete: Cascade, onUpdate: Restrict)

  /// One row per account and purpose (M8): at most one usable link (AC 19).
  @@unique([marketId, accountId, purpose])
  /// The lookup when a token is presented; NULLs do not collide.
  @@unique([marketId, tokenHash])
  @@map("one_time_links")
  @@schema("identity")
}

/// Events identity's subscribers have handled (ADR-0006 decision 5; data design 3.8, PM4):
/// `runOnce` inserts (event_id, handler) in the handler's own unit and skips the work when the
/// row exists. Written only by platform/persistence/outbox/ (platform persistence design 9, the
/// named exception). The CHECKs and the grants are hand-written in the migration.
model IdentityInbox {
  eventId     String   @map("event_id") @db.Uuid
  /// The subscriber's name, "identity.<handler>".
  handler     String
  marketId    String   @map("market_id") @db.VarChar(8)
  tenantId    String   @map("tenant_id")
  processedAt DateTime @map("processed_at") @db.Timestamptz(6)

  @@id([eventId, handler])
  @@map("inbox")
  @@schema("identity")
}
