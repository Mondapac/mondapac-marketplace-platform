// The catalog module (schema "catalog"). Physical design: docs/design/data/catalog.md; every
// model is named Catalog<Name> (its CA2) and mapped to its table with @@map. Slice 1 creates the
// outbox, the inbox, the product root, its variant registry and the product-code counter; later
// slices add columns and tables, each in its own migration (data design 8.1).

/// Events of the catalog module (ADR-0006 decisions 1 and 2; data design 3.26, PM1). Written only
/// by the platform OutboxWriter in the unit of the state change, read and marked only by the
/// relay (platform/persistence/outbox/). Every outbox of every module has exactly these fields.
/// The CHECKs, the partial claim index and the grants are hand-written in the migration.
/// Payloads hold ids, codes, booleans and instants only (P 5.3); no personal data in any column.
model CatalogOutbox {
  /// UUIDv7 stamped by the outbox writer.
  eventId          String    @id @map("event_id") @db.Uuid
  /// "catalog.<subject>-<verb>.v<N>"; the CHECK refuses another module's type.
  type             String
  /// The instant the use case took from Clock (UTC).
  occurredAt       DateTime  @map("occurred_at") @db.Timestamptz(6)
  /// Market of the unit that wrote the event (ADR-0003); stamped by the writer.
  marketId         String    @map("market_id") @db.VarChar(8)
  /// Tenant seam (ADR-0001); stamped by the writer, no database default.
  tenantId         String    @map("tenant_id")
  aggregateType    String    @map("aggregate_type")
  aggregateId      String    @map("aggregate_id") @db.Uuid
  /// The aggregate's version after the change; unique per aggregate (P 10).
  aggregateVersion Int       @map("aggregate_version")
  correlationId    String    @map("correlation_id")
  /// The consumed event that caused this one, or null.
  causationId      String?   @map("causation_id") @db.Uuid
  payload          Json      @db.JsonB
  /// Set by the relay when the event was handed to the bus; the only column that changes.
  publishedAt      DateTime? @map("published_at") @db.Timestamptz(6)

  /// No two events of one aggregate share a version (I7); led by market_id (data design C7).
  @@unique([marketId, aggregateId, aggregateVersion])
  @@map("outbox")
  @@schema("catalog")
}

/// Events catalog's subscribers have handled (ADR-0006 decision 5; data design 3.26, PM4):
/// `runOnce` inserts (event_id, handler) in the handler's own unit and skips the work when the
/// row exists. Written only by platform/persistence/outbox/. The CHECKs and the grants are
/// hand-written in the migration.
model CatalogInbox {
  eventId     String   @map("event_id") @db.Uuid
  /// The subscriber's name, "catalog.<handler>".
  handler     String
  marketId    String   @map("market_id") @db.VarChar(8)
  tenantId    String   @map("tenant_id")
  processedAt DateTime @map("processed_at") @db.Timestamptz(6)

  @@id([eventId, handler])
  @@map("inbox")
  @@schema("catalog")
}

/// The product root (catalog design 2.1; data design 3.1). Slice 1 holds the lifecycle, scope,
/// owner and type columns; the revision pointers arrive in slice 4, the takedown and claim-text
/// flags in slices 13 and 18. Type, family, product code and creator never change (column
/// grants). The CHECKs, the case-sensitive product-code collation and the grants are
/// hand-written in the migration.
model CatalogProduct {
  id                   String                  @id @db.Uuid
  marketId             String                  @map("market_id") @db.VarChar(8)
  tenantId             String                  @map("tenant_id")
  /// PLATFORM | SELLER (ADR-0010).
  scope                String
  /// The owning seller of a SELLER product; null for PLATFORM (CHECK products_owner_check).
  ownerSellerId        String?                 @map("owner_seller_id") @db.Uuid
  /// The seller who created it; never updated, so the origin survives promotion.
  createdBySellerId    String?                 @map("created_by_seller_id") @db.Uuid
  typeCode             String                  @map("type_code")
  /// single | options: the handler's variantModel; the target of the variant foreign key.
  variantModel         String                  @map("variant_model")
  familyCode           String                  @map("family_code")
  /// Minted from product_code_counters, never from input. Collation "C" is set in the migration.
  productCode          String                  @map("product_code")
  /// draft | discarded | unpublished | published | matched | withdrawn | retired.
  status               String
  discardedAt          DateTime?               @map("discarded_at") @db.Timestamptz(6)
  ownBrand             Boolean                 @map("own_brand")
  matchedIntoProductId String?                 @map("matched_into_product_id") @db.Uuid
  promotedAt           DateTime?               @map("promoted_at") @db.Timestamptz(6)
  retiredAt            DateTime?               @map("retired_at") @db.Timestamptz(6)
  withdrawnAt          DateTime?               @map("withdrawn_at") @db.Timestamptz(6)
  /// Every save of the root.
  lastChangedAt        DateTime                @map("last_changed_at") @db.Timestamptz(6)
  /// Optimistic version of the aggregate (P 10); 1 at insert.
  version              Int
  createdAt            DateTime                @map("created_at") @db.Timestamptz(6)
  variants             CatalogProductVariant[]
  matchedInto          CatalogProduct?         @relation("ProductMatch", fields: [marketId, matchedIntoProductId], references: [marketId, id], onDelete: Restrict, onUpdate: Restrict)
  duplicates           CatalogProduct[]        @relation("ProductMatch")

  /// The target of composite foreign keys (C3).
  @@unique([marketId, id])
  /// The target of the variant foreign key, which carries the variant model.
  @@unique([marketId, id, variantModel])
  /// One code per Market (D 17.1).
  @@unique([marketId, productCode])
  @@map("products")
  @@schema("catalog")
}

/// The variant registry of a product (catalog design 2.3 M-1; data design 3.2). A variant id is
/// minted by the server, never reused and never revived: the guard trigger allows only
/// proposed to published, proposed to retired and published to retired, and refuses every
/// DELETE. The CHECKs, the single-variant partial unique and the trigger are hand-written.
model CatalogProductVariant {
  id           String         @id @db.Uuid
  marketId     String         @map("market_id") @db.VarChar(8)
  tenantId     String         @map("tenant_id")
  productId    String         @map("product_id") @db.Uuid
  /// A copy bound by the foreign key to the product's variant model.
  variantModel String         @map("variant_model")
  /// proposed | published | retired.
  state        String
  createdAt    DateTime       @map("created_at") @db.Timestamptz(6)
  publishedAt  DateTime?      @map("published_at") @db.Timestamptz(6)
  retiredAt    DateTime?      @map("retired_at") @db.Timestamptz(6)
  product      CatalogProduct @relation(fields: [marketId, productId, variantModel], references: [marketId, id, variantModel], onDelete: Restrict, onUpdate: Restrict)

  @@unique([marketId, id])
  /// The count path of the variant limit and the target of a same-product foreign key (3.10).
  @@unique([marketId, productId, id])
  @@map("product_variants")
  @@schema("catalog")
}

/// The next product-code value of a Market (data design 3.3): one row per Market, taken with a
/// single incrementing UPDATE whose row lock is held to commit. The first creation upserts it.
model CatalogProductCodeCounter {
  marketId  String @id @map("market_id") @db.VarChar(8)
  tenantId  String @map("tenant_id")
  nextValue BigInt @map("next_value")

  @@map("product_code_counters")
  @@schema("catalog")
}
