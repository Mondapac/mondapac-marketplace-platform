// The catalog module (schema "catalog"). Physical design: docs/design/data/catalog.md; every
// model is named Catalog<Name> (its CA2) and mapped to its table with @@map. Slice 1 creates the
// outbox, the inbox, the product root, its variant registry and the product-code counter; later
// slices add columns and tables, each in its own migration (data design 8.1).

/// Events of the catalog module (ADR-0006 decisions 1 and 2; data design 3.26, PM1). Written only
/// by the platform OutboxWriter in the unit of the state change, read and marked only by the
/// relay (platform/persistence/outbox/). Every outbox of every module has exactly these fields.
/// The CHECKs, the partial claim index and the grants are hand-written in the migration.
/// Payloads hold ids, codes, booleans and instants only (P 5.3); no personal data in any column.
model CatalogOutbox {
  /// UUIDv7 stamped by the outbox writer.
  eventId          String    @id @map("event_id") @db.Uuid
  /// "catalog.<subject>-<verb>.v<N>"; the CHECK refuses another module's type.
  type             String
  /// The instant the use case took from Clock (UTC).
  occurredAt       DateTime  @map("occurred_at") @db.Timestamptz(6)
  /// Market of the unit that wrote the event (ADR-0003); stamped by the writer.
  marketId         String    @map("market_id") @db.VarChar(8)
  /// Tenant seam (ADR-0001); stamped by the writer, no database default.
  tenantId         String    @map("tenant_id")
  aggregateType    String    @map("aggregate_type")
  aggregateId      String    @map("aggregate_id") @db.Uuid
  /// The aggregate's version after the change; unique per aggregate (P 10).
  aggregateVersion Int       @map("aggregate_version")
  correlationId    String    @map("correlation_id")
  /// The consumed event that caused this one, or null.
  causationId      String?   @map("causation_id") @db.Uuid
  payload          Json      @db.JsonB
  /// Set by the relay when the event was handed to the bus; the only column that changes.
  publishedAt      DateTime? @map("published_at") @db.Timestamptz(6)

  /// No two events of one aggregate share a version (I7); led by market_id (data design C7).
  @@unique([marketId, aggregateId, aggregateVersion])
  @@map("outbox")
  @@schema("catalog")
}

/// Events catalog's subscribers have handled (ADR-0006 decision 5; data design 3.26, PM4):
/// `runOnce` inserts (event_id, handler) in the handler's own unit and skips the work when the
/// row exists. Written only by platform/persistence/outbox/. The CHECKs and the grants are
/// hand-written in the migration.
model CatalogInbox {
  eventId     String   @map("event_id") @db.Uuid
  /// The subscriber's name, "catalog.<handler>".
  handler     String
  marketId    String   @map("market_id") @db.VarChar(8)
  tenantId    String   @map("tenant_id")
  processedAt DateTime @map("processed_at") @db.Timestamptz(6)

  @@id([eventId, handler])
  @@map("inbox")
  @@schema("catalog")
}

/// The product root (catalog design 2.1; data design 3.1). Slice 1 holds the lifecycle, scope,
/// owner and type columns; the revision pointers arrive in slice 4, the takedown and claim-text
/// flags in slices 13 and 18. Type, family, product code and creator never change (column
/// grants). The CHECKs, the case-sensitive product-code collation and the grants are
/// hand-written in the migration.
model CatalogProduct {
  id                   String                     @id @db.Uuid
  marketId             String                     @map("market_id") @db.VarChar(8)
  tenantId             String                     @map("tenant_id")
  /// PLATFORM | SELLER (ADR-0010).
  scope                String
  /// The owning seller of a SELLER product; null for PLATFORM (CHECK products_owner_check).
  ownerSellerId        String?                    @map("owner_seller_id") @db.Uuid
  /// The seller who created it; never updated, so the origin survives promotion.
  createdBySellerId    String?                    @map("created_by_seller_id") @db.Uuid
  typeCode             String                     @map("type_code")
  /// single | options: the handler's variantModel; the target of the variant foreign key.
  variantModel         String                     @map("variant_model")
  familyCode           String                     @map("family_code")
  /// Minted from product_code_counters, never from input. Collation "C" is set in the migration.
  productCode          String                     @map("product_code")
  /// draft | discarded | unpublished | published | matched | withdrawn | retired.
  status               String
  discardedAt          DateTime?                  @map("discarded_at") @db.Timestamptz(6)
  ownBrand             Boolean                    @map("own_brand")
  matchedIntoProductId String?                    @map("matched_into_product_id") @db.Uuid
  promotedAt           DateTime?                  @map("promoted_at") @db.Timestamptz(6)
  retiredAt            DateTime?                  @map("retired_at") @db.Timestamptz(6)
  withdrawnAt          DateTime?                  @map("withdrawn_at") @db.Timestamptz(6)
  /// The published revision (V1 pointer); only a revision of this product (CE4). Null until first publish.
  publishedRevisionId  String?                    @map("published_revision_id") @db.Uuid
  /// The one pending revision (VER-01), a single column so the rule holds by construction.
  pendingRevisionId    String?                    @map("pending_revision_id") @db.Uuid
  /// Queue sort key, written with the pending pointer in the same statement.
  pendingSubmittedAt   DateTime?                  @map("pending_submitted_at") @db.Timestamptz(6)
  /// Every save of the root.
  lastChangedAt        DateTime                   @map("last_changed_at") @db.Timestamptz(6)
  /// Optimistic version of the aggregate (P 10); 1 at insert.
  version              Int
  createdAt            DateTime                   @map("created_at") @db.Timestamptz(6)
  variants             CatalogProductVariant[]
  matchedInto          CatalogProduct?            @relation("ProductMatch", fields: [marketId, matchedIntoProductId], references: [marketId, id], onDelete: Restrict, onUpdate: Restrict)
  duplicates           CatalogProduct[]           @relation("ProductMatch")
  revisions            CatalogProductRevision[]   @relation("ProductRevisions")
  publishedRevision    CatalogProductRevision?    @relation("ProductPublished", fields: [marketId, id, publishedRevisionId], references: [marketId, productId, id], onDelete: Restrict, onUpdate: Restrict)
  pendingRevision      CatalogProductRevision?    @relation("ProductPending", fields: [marketId, id, pendingRevisionId], references: [marketId, productId, id], onDelete: Restrict, onUpdate: Restrict)
  workingCopy          CatalogProductWorkingCopy?
  offers               CatalogOffer[]

  /// The target of composite foreign keys (C3).
  @@unique([marketId, id])
  /// The target of the variant foreign key, which carries the variant model.
  @@unique([marketId, id, variantModel])
  /// One code per Market (D 17.1).
  @@unique([marketId, productCode])
  /// The seller's own product list (own-products.list): keyset by id within one owner.
  @@index([marketId, ownerSellerId, id], map: "products_market_id_owner_seller_id_id_idx")
  @@map("products")
  @@schema("catalog")
}

/// The variant registry of a product (catalog design 2.3 M-1; data design 3.2). A variant id is
/// minted by the server, never reused and never revived: the guard trigger allows only
/// proposed to published, proposed to retired and published to retired, and refuses every
/// DELETE. The CHECKs, the single-variant partial unique and the trigger are hand-written.
model CatalogProductVariant {
  id               String                          @id @db.Uuid
  marketId         String                          @map("market_id") @db.VarChar(8)
  tenantId         String                          @map("tenant_id")
  productId        String                          @map("product_id") @db.Uuid
  /// A copy bound by the foreign key to the product's variant model.
  variantModel     String                          @map("variant_model")
  /// proposed | published | retired.
  state            String
  createdAt        DateTime                        @map("created_at") @db.Timestamptz(6)
  publishedAt      DateTime?                       @map("published_at") @db.Timestamptz(6)
  retiredAt        DateTime?                       @map("retired_at") @db.Timestamptz(6)
  product          CatalogProduct                  @relation(fields: [marketId, productId, variantModel], references: [marketId, id, variantModel], onDelete: Restrict, onUpdate: Restrict)
  revisionVariants CatalogProductRevisionVariant[]

  @@unique([marketId, id])
  /// The count path of the variant limit and the target of a same-product foreign key (3.10).
  @@unique([marketId, productId, id])
  @@map("product_variants")
  @@schema("catalog")
}

/// The next product-code value of a Market (data design 3.3): one row per Market, taken with a
/// single incrementing UPDATE whose row lock is held to commit. The first creation upserts it.
model CatalogProductCodeCounter {
  marketId  String @id @map("market_id") @db.VarChar(8)
  tenantId  String @map("tenant_id")
  nextValue BigInt @map("next_value")

  @@map("product_code_counters")
  @@schema("catalog")
}

/// The version of a Market's platform category tree (data design 3.4): one row per Market. Every
/// structural change raises it with a guarded `updateMany ... where version`, which serialises
/// edits (two moves that would form a cycle together cannot both commit) and keys the in-process
/// copy of the tree. The CHECKs and the grants are hand-written in the migration.
model CatalogCategoryTree {
  marketId String @id @map("market_id") @db.VarChar(8)
  tenantId String @map("tenant_id")
  version  Int

  @@map("category_trees")
  @@schema("catalog")
}

/// A node of the platform category tree (catalog design 2.1, 4.6; data design 3.4). Name and
/// parent live in insert-only revisions; this root holds the lifecycle, the slug and the pointer
/// to the current revision. The CHECKs, the no-cycle trigger and the grants are hand-written.
model CatalogPlatformCategory {
  id                  String                            @id @db.Uuid
  marketId            String                            @map("market_id") @db.VarChar(8)
  tenantId            String                            @map("tenant_id")
  /// Null for a root of the tree; never equal to the id (CHECK).
  parentId            String?                           @map("parent_id") @db.Uuid
  /// Optional Vertical root marker (CA4); only on a root (CHECK).
  verticalRootCode    String?                           @map("vertical_root_code")
  /// Case-sensitive collation "C" is set in the migration; unique per Market.
  slug                String
  /// active | merged | archived.
  status              String
  mergedIntoId        String?                           @map("merged_into_id") @db.Uuid
  /// The current revision; null only inside the creating unit (Q-K10).
  publishedRevisionId String?                           @map("published_revision_id") @db.Uuid
  /// seed | admin; never updated.
  createdByKind       String                            @map("created_by_kind")
  version             Int
  createdAt           DateTime                          @map("created_at") @db.Timestamptz(6)
  parent              CatalogPlatformCategory?          @relation("CategoryParent", fields: [marketId, parentId], references: [marketId, id], onDelete: Restrict, onUpdate: Restrict)
  children            CatalogPlatformCategory[]         @relation("CategoryParent")
  mergedInto          CatalogPlatformCategory?          @relation("CategoryMerge", fields: [marketId, mergedIntoId], references: [marketId, id], onDelete: Restrict, onUpdate: Restrict)
  mergedFrom          CatalogPlatformCategory[]         @relation("CategoryMerge")
  revisions           CatalogPlatformCategoryRevision[] @relation("CategoryRevisions")
  publishedRevision   CatalogPlatformCategoryRevision?  @relation("CategoryPublished", fields: [marketId, id, publishedRevisionId], references: [marketId, categoryId, id], onDelete: Restrict, onUpdate: Restrict)
  productRevisions    CatalogProductRevisionCategory[]

  @@unique([marketId, id])
  /// One slug per Market (D 17.1).
  @@unique([marketId, slug])
  /// The child lists of the tree editor.
  @@index([marketId, parentId])
  @@map("platform_categories")
  @@schema("catalog")
}

/// A revision of a category's name and parent (V1, insert-only: CA3). The parent has no foreign
/// key: history may name an archived id (C4).
model CatalogPlatformCategoryRevision {
  id              String                                @id @db.Uuid
  marketId        String                                @map("market_id") @db.VarChar(8)
  tenantId        String                                @map("tenant_id")
  categoryId      String                                @map("category_id") @db.Uuid
  revisionNo      Int                                   @map("revision_no")
  parentId        String?                               @map("parent_id") @db.Uuid
  /// created | renamed | moved | merged | archived.
  changeKind      String                                @map("change_kind")
  /// seed | admin.
  authorKind      String                                @map("author_kind")
  /// Null exactly when the author is the seed.
  authorAccountId String?                               @map("author_account_id") @db.Uuid
  createdAt       DateTime                              @map("created_at") @db.Timestamptz(6)
  category        CatalogPlatformCategory               @relation("CategoryRevisions", fields: [marketId, categoryId], references: [marketId, id], onDelete: Restrict, onUpdate: Restrict)
  published       CatalogPlatformCategory[]             @relation("CategoryPublished")
  names           CatalogPlatformCategoryRevisionName[]

  @@unique([marketId, categoryId, revisionNo])
  /// The target of the category's published-revision pointer and of the name rows.
  @@unique([marketId, categoryId, id])
  @@unique([marketId, id])
  @@map("platform_category_revisions")
  @@schema("catalog")
}

/// The name of a revision in one locale (a row per locale: CA6; insert-only).
model CatalogPlatformCategoryRevisionName {
  marketId   String                          @map("market_id") @db.VarChar(8)
  tenantId   String                          @map("tenant_id")
  revisionId String                          @map("revision_id") @db.Uuid
  locale     String
  name       String
  revision   CatalogPlatformCategoryRevision @relation(fields: [marketId, revisionId], references: [marketId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([marketId, revisionId, locale])
  @@map("platform_category_revision_names")
  @@schema("catalog")
}

/// An attribute a product can carry (catalog design 3.3; data design 3.5): the code, data type and
/// localizable flag never change; name, bounds, options and the `material` flag live in
/// insert-only revisions. The CHECKs and the grants are hand-written in the migration. The
/// archive request column and its two-person triggers arrive with slice 21.
model CatalogAttributeDefinition {
  id                  String                               @id @db.Uuid
  marketId            String                               @map("market_id") @db.VarChar(8)
  tenantId            String                               @map("tenant_id")
  /// Unique per Market, never updated (CA4).
  code                String
  /// text | long-text | integer | decimal | boolean | select | multi-select | date.
  dataType            String                               @map("data_type")
  localizable         Boolean
  /// active | archived.
  status              String
  /// The current revision; null only inside the creating unit (Q-K10).
  publishedRevisionId String?                              @map("published_revision_id") @db.Uuid
  /// seed | admin; never updated.
  createdByKind       String                               @map("created_by_kind")
  version             Int
  createdAt           DateTime                             @map("created_at") @db.Timestamptz(6)
  revisions           CatalogAttributeDefinitionRevision[] @relation("DefinitionRevisions")
  publishedRevision   CatalogAttributeDefinitionRevision?  @relation("DefinitionPublished", fields: [marketId, id, publishedRevisionId], references: [marketId, definitionId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([marketId, id])
  @@unique([marketId, code])
  @@map("attribute_definitions")
  @@schema("catalog")
}

/// A revision of a definition (V1, insert-only: CA3). `material` is set by people or the seed,
/// never by a machine (ADR-0012 decision 3).
model CatalogAttributeDefinitionRevision {
  id                  String                                     @id @db.Uuid
  marketId            String                                     @map("market_id") @db.VarChar(8)
  tenantId            String                                     @map("tenant_id")
  definitionId        String                                     @map("definition_id") @db.Uuid
  revisionNo          Int                                        @map("revision_no")
  material            Boolean
  isVariantOption     Boolean                                    @map("is_variant_option")
  /// Object with maxLength, min, max.
  bounds              Json                                       @db.JsonB
  /// Locale to name (CA6).
  names               Json                                       @db.JsonB
  /// seed | admin.
  authorKind          String                                     @map("author_kind")
  /// Null exactly when the author is the seed.
  authorAccountId     String?                                    @map("author_account_id") @db.Uuid
  /// Slice 21: the confirmed request that allowed clearing `material`; its foreign key arrives there.
  relaxationRequestId String?                                    @map("relaxation_request_id") @db.Uuid
  createdAt           DateTime                                   @map("created_at") @db.Timestamptz(6)
  definition          CatalogAttributeDefinition                 @relation("DefinitionRevisions", fields: [marketId, definitionId], references: [marketId, id], onDelete: Restrict, onUpdate: Restrict)
  published           CatalogAttributeDefinition[]               @relation("DefinitionPublished")
  options             CatalogAttributeDefinitionRevisionOption[]

  @@unique([marketId, definitionId, revisionNo])
  /// The target of the definition's published-revision pointer.
  @@unique([marketId, definitionId, id])
  @@unique([marketId, id])
  @@map("attribute_definition_revisions")
  @@schema("catalog")
}

/// An option of a select definition at one revision; deactivated, never deleted (insert-only).
model CatalogAttributeDefinitionRevisionOption {
  marketId   String                             @map("market_id") @db.VarChar(8)
  tenantId   String                             @map("tenant_id")
  revisionId String                             @map("revision_id") @db.Uuid
  optionCode String                             @map("option_code")
  /// Locale to label (CA6).
  labels     Json                               @db.JsonB
  active     Boolean
  position   Int                                @db.SmallInt
  revision   CatalogAttributeDefinitionRevision @relation(fields: [marketId, revisionId], references: [marketId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([marketId, revisionId, optionCode])
  @@map("attribute_definition_revision_options")
  @@schema("catalog")
}

/// A family: the groups of attributes a product type offers (catalog design 2.1; data design 3.5).
model CatalogAttributeFamily {
  id                  String                           @id @db.Uuid
  marketId            String                           @map("market_id") @db.VarChar(8)
  tenantId            String                           @map("tenant_id")
  code                String
  /// active | archived.
  status              String
  publishedRevisionId String?                          @map("published_revision_id") @db.Uuid
  /// seed | admin; never updated.
  createdByKind       String                           @map("created_by_kind")
  version             Int
  createdAt           DateTime                         @map("created_at") @db.Timestamptz(6)
  revisions           CatalogAttributeFamilyRevision[] @relation("FamilyRevisions")
  publishedRevision   CatalogAttributeFamilyRevision?  @relation("FamilyPublished", fields: [marketId, id, publishedRevisionId], references: [marketId, familyId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([marketId, id])
  @@unique([marketId, code])
  @@map("attribute_families")
  @@schema("catalog")
}

/// A revision of a family (V1, insert-only): the groups as a document, because a revision is
/// read whole and never queried inside.
model CatalogAttributeFamilyRevision {
  id                  String                   @id @db.Uuid
  marketId            String                   @map("market_id") @db.VarChar(8)
  tenantId            String                   @map("tenant_id")
  familyId            String                   @map("family_id") @db.Uuid
  revisionNo          Int                      @map("revision_no")
  /// Array of { groupCode, attributes: [{ code, required, isVariantOption }] }.
  groups              Json                     @db.JsonB
  /// seed | admin.
  authorKind          String                   @map("author_kind")
  authorAccountId     String?                  @map("author_account_id") @db.Uuid
  /// Slice 21: the confirmed request that allowed removing a material attribute.
  relaxationRequestId String?                  @map("relaxation_request_id") @db.Uuid
  createdAt           DateTime                 @map("created_at") @db.Timestamptz(6)
  family              CatalogAttributeFamily   @relation("FamilyRevisions", fields: [marketId, familyId], references: [marketId, id], onDelete: Restrict, onUpdate: Restrict)
  published           CatalogAttributeFamily[] @relation("FamilyPublished")
  productRevisions    CatalogProductRevision[]

  @@unique([marketId, familyId, revisionNo])
  @@unique([marketId, familyId, id])
  @@unique([marketId, id])
  @@map("attribute_family_revisions")
  @@schema("catalog")
}

/// The working copy of a product (catalog design 2.3 M-2; data design 3.6): the incomplete draft,
/// one row per product, mutable. Nothing queries inside `content`; a submit validates and freezes
/// it into revision rows. Deleted explicitly when a draft is discarded or pruned (10.1).
model CatalogProductWorkingCopy {
  marketId             String                  @map("market_id") @db.VarChar(8)
  tenantId             String                  @map("tenant_id")
  productId            String                  @map("product_id") @db.Uuid
  /// Texts, attribute values, variant drafts naming registry ids, category ids, tax category,
  /// image ids with alt text. An object (CHECK).
  content              Json                    @db.JsonB
  contentSchemaVersion Int                     @map("content_schema_version") @db.SmallInt
  /// The published revision it was started from; a revision of the same product.
  baseRevisionId       String?                 @map("base_revision_id") @db.Uuid
  lastSavedAt          DateTime                @map("last_saved_at") @db.Timestamptz(6)
  lastSavedByAccountId String                  @map("last_saved_by_account_id") @db.Uuid
  product              CatalogProduct          @relation(fields: [marketId, productId], references: [marketId, id], onDelete: Cascade, onUpdate: Restrict)
  baseRevision         CatalogProductRevision? @relation(fields: [marketId, productId, baseRevisionId], references: [marketId, productId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([marketId, productId])
  /// The prune job's range (A22).
  @@index([marketId, lastSavedAt, productId], map: "product_working_copies_market_id_last_saved_at_idx")
  @@map("product_working_copies")
  @@schema("catalog")
}

/// A frozen revision of a product (V1; data design 3.7). Insert-only (CA3). Status is derived
/// from the product's two pointers and the decision row.
model CatalogProductRevision {
  id                     String                           @id @db.Uuid
  marketId               String                           @map("market_id") @db.VarChar(8)
  tenantId               String                           @map("tenant_id")
  productId              String                           @map("product_id") @db.Uuid
  revisionNo             Int                              @map("revision_no")
  /// submission | revert | tax-override.
  revisionKind           String                           @map("revision_kind")
  /// The published revision it was built on; same product.
  baseRevisionId         String?                          @map("base_revision_id") @db.Uuid
  revertedFromRevisionId String?                          @map("reverted_from_revision_id") @db.Uuid
  /// Schema ref: the family revision, with the definition revisions below.
  familyRevisionId       String                           @map("family_revision_id") @db.Uuid
  definitionRevisionIds  String[]                         @map("definition_revision_ids") @db.Uuid
  taxCategoryCode        String                           @map("tax_category_code")
  attributeValues        Json                             @map("attribute_values") @db.JsonB
  /// Per field typed | ai-unchanged | ai-edited, server-built; no text.
  fieldProvenance        Json?                            @map("field_provenance") @db.JsonB
  sensitive              Boolean
  sensitiveReasons       String[]                         @map("sensitive_reasons")
  contentSchemaVersion   Int                              @map("content_schema_version") @db.SmallInt
  /// `sha256:` and 64 hex digits (ContentHash).
  contentHash            String                           @map("content_hash")
  /// seller | admin.
  authorKind             String                           @map("author_kind")
  authorAccountId        String                           @map("author_account_id") @db.Uuid
  /// Acting-as (IMP-06): the admin behind a seller-authored revision.
  actingAdminAccountId   String?                          @map("acting_admin_account_id") @db.Uuid
  submittedAt            DateTime                         @map("submitted_at") @db.Timestamptz(6)
  product                CatalogProduct                   @relation("ProductRevisions", fields: [marketId, productId], references: [marketId, id], onDelete: Restrict, onUpdate: Restrict)
  baseRevision           CatalogProductRevision?          @relation("RevisionBase", fields: [marketId, productId, baseRevisionId], references: [marketId, productId, id], onDelete: Restrict, onUpdate: Restrict)
  basedOnThis            CatalogProductRevision[]         @relation("RevisionBase")
  revertedFrom           CatalogProductRevision?          @relation("RevisionRevertedFrom", fields: [marketId, productId, revertedFromRevisionId], references: [marketId, productId, id], onDelete: Restrict, onUpdate: Restrict)
  revertedBy             CatalogProductRevision[]         @relation("RevisionRevertedFrom")
  familyRevision         CatalogAttributeFamilyRevision   @relation(fields: [marketId, familyRevisionId], references: [marketId, id], onDelete: Restrict, onUpdate: Restrict)
  publishedOf            CatalogProduct[]                 @relation("ProductPublished")
  pendingOf              CatalogProduct[]                 @relation("ProductPending")
  workingCopies          CatalogProductWorkingCopy[]
  texts                  CatalogProductRevisionText[]
  categories             CatalogProductRevisionCategory[]
  variants               CatalogProductRevisionVariant[]
  decision               CatalogProductRevisionDecision?

  @@unique([marketId, productId, revisionNo])
  @@unique([marketId, id])
  /// The target of the pointers and of every child (same-product foreign keys).
  @@unique([marketId, productId, id])
  @@map("product_revisions")
  @@schema("catalog")
}

/// The texts of a revision per locale (data design 3.8). Insert-only.
model CatalogProductRevisionText {
  marketId         String                 @map("market_id") @db.VarChar(8)
  tenantId         String                 @map("tenant_id")
  revisionId       String                 @map("revision_id") @db.Uuid
  locale           String
  name             String
  shortDescription String?                @map("short_description")
  description      String?
  revision         CatalogProductRevision @relation(fields: [marketId, revisionId], references: [marketId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([marketId, revisionId, locale])
  @@map("product_revision_texts")
  @@schema("catalog")
}

/// The platform categories a revision names (data design 3.9). Insert-only.
model CatalogProductRevisionCategory {
  marketId   String                  @map("market_id") @db.VarChar(8)
  tenantId   String                  @map("tenant_id")
  revisionId String                  @map("revision_id") @db.Uuid
  categoryId String                  @map("category_id") @db.Uuid
  /// Order as entered.
  position   Int                     @db.SmallInt
  revision   CatalogProductRevision  @relation(fields: [marketId, revisionId], references: [marketId, id], onDelete: Restrict, onUpdate: Restrict)
  category   CatalogPlatformCategory @relation(fields: [marketId, categoryId], references: [marketId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([marketId, revisionId, categoryId])
  /// The category re-ask and the impact count (A9, A10).
  @@index([marketId, categoryId, revisionId])
  @@map("product_revision_categories")
  @@schema("catalog")
}

/// The variants a revision carries (data design 3.10): only variants of its own product.
/// Insert-only; the not-retired trigger refuses a retired variant.
model CatalogProductRevisionVariant {
  marketId     String                 @map("market_id") @db.VarChar(8)
  tenantId     String                 @map("tenant_id")
  revisionId   String                 @map("revision_id") @db.Uuid
  variantId    String                 @map("variant_id") @db.Uuid
  productId    String                 @map("product_id") @db.Uuid
  position     Int                    @db.SmallInt
  /// The canonical string of the option values, built by the handler; unique per revision.
  optionKey    String                 @map("option_key")
  optionValues Json                   @map("option_values") @db.JsonB
  /// Locale to label (CA6).
  labels       Json                   @db.JsonB
  revision     CatalogProductRevision @relation(fields: [marketId, productId, revisionId], references: [marketId, productId, id], onDelete: Restrict, onUpdate: Restrict)
  variant      CatalogProductVariant  @relation(fields: [marketId, productId, variantId], references: [marketId, productId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([marketId, revisionId, variantId])
  @@unique([marketId, revisionId, optionKey])
  @@map("product_revision_variants")
  @@schema("catalog")
}

/// The one terminal outcome of a revision (data design 3.12). Insert-only. The check columns are
/// created now and stay empty arrays until slice 10 fills them.
model CatalogProductRevisionDecision {
  marketId             String                 @map("market_id") @db.VarChar(8)
  tenantId             String                 @map("tenant_id")
  revisionId           String                 @map("revision_id") @db.Uuid
  /// published | changes-requested | superseded.
  outcome              String
  /// reviewed | auto | admin-authored; set exactly when outcome is published.
  publishKind          String?                @map("publish_kind")
  approvalRequiredRead Boolean?               @map("approval_required_read")
  /// resubmitted | withdrawn | promoted | matched; set exactly when superseded.
  supersededCause      String?                @map("superseded_cause")
  reasonCode           String?                @map("reason_code")
  /// The reviewer's optional words; never copied to events, audit or logs (VER-13).
  reasonText           String?                @map("reason_text")
  requiredChecks       String[]               @map("required_checks")
  confirmedChecks      String[]               @map("confirmed_checks")
  /// admin | seller | system.
  decidedByKind        String                 @map("decided_by_kind")
  decidedByAccountId   String?                @map("decided_by_account_id") @db.Uuid
  productVersion       Int                    @map("product_version")
  decidedAt            DateTime               @map("decided_at") @db.Timestamptz(6)
  revision             CatalogProductRevision @relation(fields: [marketId, revisionId], references: [marketId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([marketId, revisionId])
  @@map("product_revision_decisions")
  @@schema("catalog")
}

/// Fixed-window counters of the catalog use cases (data design 3.26): the sellers shape, keyed by
/// an HMAC under this module's rate-counter key. The kind list is a CHECK.
model CatalogRateCounter {
  marketId        String   @map("market_id") @db.VarChar(8)
  tenantId        String   @map("tenant_id")
  kind            String
  keyHash         Bytes    @map("key_hash")
  windowStartedAt DateTime @map("window_started_at") @db.Timestamptz(6)
  count           Int

  @@id([marketId, kind, keyHash])
  @@map("rate_counters")
  @@schema("catalog")
}

/// The Offer root (catalog design 2.3 M-3, M-5; data design 3.13): one seller's terms for one
/// product. Never physically deleted (Q-K2): a discarded draft's Offer becomes `deleted`. The
/// seller never changes (no column grant). The CHECKs (status, handling, attestation pair,
/// `listed` against the causes, SKU), the case-sensitive SKU collation, the two partial uniques,
/// the two partial indexes and the grants are hand-written in the migration. The shelf column
/// (`shelf_category_id`) arrives with seller categories in slice 23.
model CatalogOffer {
  id                          String                @id @db.Uuid
  marketId                    String                @map("market_id") @db.VarChar(8)
  tenantId                    String                @map("tenant_id")
  /// Never updated (no column grant; PRC 2.3).
  sellerId                    String                @map("seller_id") @db.Uuid
  /// Changed only by a CAT-45 match (the Offer moves, D 4.5).
  productId                   String                @map("product_id") @db.Uuid
  /// 1 to 64 printable ASCII characters, no space (CHECK); collation "C" is set in the migration.
  /// Unique per seller among non-deleted Offers.
  sellerSku                   String                @map("seller_sku")
  /// A Market `conditions` code (CA4).
  conditionCode               String                @map("condition_code")
  /// Locale to text, an object (CHECK, CA6); nothing queries inside it.
  description                 Json                  @db.JsonB
  /// SEALED_ORIGINAL | REPACKED | PREPARED | FRESH; null only while `draft` or `deleted`.
  handling                    String?
  /// Both or neither (CHECK); written only by own-offer.record-attestation.
  attestationRecordedAt       DateTime?             @map("attestation_recorded_at") @db.Timestamptz(6)
  attestationAccountId        String?               @map("attestation_account_id") @db.Uuid
  /// draft | pending-first-publish | changes-needed | published | deleted.
  status                      String
  /// The stored off-sale causes (M-5): type-not-allowed, product-retired, product-not-listed,
  /// tag-suspended, description-claim-text.
  offSaleTypeNotAllowed       Boolean               @map("off_sale_type_not_allowed")
  offSaleProductRetired       Boolean               @map("off_sale_product_retired")
  offSaleProductNotListed     Boolean               @map("off_sale_product_not_listed")
  offSaleTagSuspended         Boolean               @map("off_sale_tag_suspended")
  offSaleDescriptionClaimText Boolean               @map("off_sale_description_claim_text")
  /// Exactly `status = 'published'` and no cause (CHECK offers_listed_check).
  listed                      Boolean
  /// The last submit for review; required while `pending-first-publish` (CHECK); queue sort key.
  submittedAt                 DateTime?             @map("submitted_at") @db.Timestamptz(6)
  firstPublishedAt            DateTime?             @map("first_published_at") @db.Timestamptz(6)
  /// Set exactly when `status = 'deleted'` (CHECK).
  deletedAt                   DateTime?             @map("deleted_at") @db.Timestamptz(6)
  /// Optimistic version of the aggregate (P 10); 1 at insert.
  version                     Int
  createdAt                   DateTime              @map("created_at") @db.Timestamptz(6)
  product                     CatalogProduct        @relation(fields: [marketId, productId], references: [marketId, id], onDelete: Restrict, onUpdate: Restrict)
  history                     CatalogOfferHistory[]

  /// The target of composite foreign keys (C3); the A1 batch read.
  @@unique([marketId, id])
  /// The target of the same-seller tag foreign key (3.15).
  @@unique([marketId, id, sellerId])
  @@map("offers")
  @@schema("catalog")
}

/// The history of an Offer (V4; data design 3.14): one row per Offer change, with a snapshot of
/// the Offer after it. Insert-only (CA3): SELECT and INSERT for the application, and triggers
/// refuse UPDATE, DELETE and TRUNCATE for every role. A tag-only change has no row here.
model CatalogOfferHistory {
  id                   String       @id @db.Uuid
  marketId             String       @map("market_id") @db.VarChar(8)
  tenantId             String       @map("tenant_id")
  offerId              String       @map("offer_id") @db.Uuid
  /// The Offer's version after the change; unique per Offer.
  offerVersion         Int          @map("offer_version")
  /// created | edited | submitted | publication-approved | changes-requested | published |
  /// handling-changed | attestation-recorded | attestation-withdrawn | causes-changed | moved |
  /// shelf-cleared | deleted.
  changeKind           String       @map("change_kind")
  /// Field ids (D 6.2) of the change, no values; may be empty.
  changedFields        String[]     @map("changed_fields")
  // Snapshot after the change.
  productId            String       @map("product_id") @db.Uuid
  status               String
  /// Collation "C" is set in the migration.
  sellerSku            String       @map("seller_sku")
  conditionCode        String       @map("condition_code")
  description          Json         @db.JsonB
  handling             String?
  attestationRecorded  Boolean      @map("attestation_recorded")
  /// Always null until seller categories (slice 23); no foreign key (a snapshot).
  shelfCategoryId      String?      @map("shelf_category_id") @db.Uuid
  listed               Boolean
  /// The cause codes set after the change (a subset of the five).
  offSaleCauses        String[]     @map("off_sale_causes")
  /// seller | admin | system.
  actorKind            String       @map("actor_kind")
  /// Null exactly for the system actor (CHECK).
  actorAccountId       String?      @map("actor_account_id") @db.Uuid
  /// Acting-as (IMP-06): the admin behind a seller's change.
  actingAdminAccountId String?      @map("acting_admin_account_id") @db.Uuid
  occurredAt           DateTime     @map("occurred_at") @db.Timestamptz(6)
  offer                CatalogOffer @relation(fields: [marketId, offerId], references: [marketId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([marketId, offerId, offerVersion])
  /// The history read (A17).
  @@index([marketId, offerId, occurredAt])
  @@map("offer_history")
  @@schema("catalog")
}
