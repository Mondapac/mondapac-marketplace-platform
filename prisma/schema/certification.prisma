// The certification module (schema "certification"). Physical design:
// docs/design/data/certification.md; every model is named Certification<Name> (its CE2) and
// mapped to its table with @@map. Migration 1 (slice 1) creates the outbox, the inbox, the type
// root and its revisions, the issuers, the seller certificate root, its submissions and their
// decision rows; migration 2 (slice 2) adds the texts, claim terms, issuer contact channels, relaxation proposals
// and platform subjects; later migrations add the other tables (data design 9.1). Every CHECK, the
// partial indexes, the append-only triggers and the grants are hand-written in the migration.

/// Events of the certification module (ADR-0006 decisions 1 and 2; data design 3.19, PM1).
/// Written only by the platform OutboxWriter in the unit of the state change, read and marked
/// only by the relay (platform/persistence/outbox/). Every outbox of every module has exactly
/// these fields. Payloads hold ids, codes and enums only (D 8.3); no personal data in any column.
model CertificationOutbox {
  /// UUIDv7 stamped by the outbox writer.
  eventId          String    @id @map("event_id") @db.Uuid
  /// "certification.<subject>-<verb>.v<N>"; the CHECK refuses another module's type.
  type             String
  /// The instant the use case took from Clock (UTC).
  occurredAt       DateTime  @map("occurred_at") @db.Timestamptz(6)
  /// Market of the unit that wrote the event (ADR-0003); stamped by the writer.
  marketId         String    @map("market_id") @db.VarChar(8)
  /// Tenant seam (ADR-0001); stamped by the writer, no database default.
  tenantId         String    @map("tenant_id")
  aggregateType    String    @map("aggregate_type")
  aggregateId      String    @map("aggregate_id") @db.Uuid
  /// The aggregate's version after the change; unique per aggregate (P 10).
  aggregateVersion Int       @map("aggregate_version")
  correlationId    String    @map("correlation_id")
  /// The consumed event that caused this one, or null.
  causationId      String?   @map("causation_id") @db.Uuid
  payload          Json      @db.JsonB
  /// Set by the relay when the event was handed to the bus; the only column that changes.
  publishedAt      DateTime? @map("published_at") @db.Timestamptz(6)

  /// No two events of one aggregate share a version (I7); led by market_id (data design C7).
  @@unique([marketId, aggregateId, aggregateVersion])
  @@map("outbox")
  @@schema("certification")
}

/// Events certification's subscribers have handled (ADR-0006 decision 5; data design 3.19, PM4):
/// `runOnce` inserts (event_id, handler) in the handler's own unit and skips the work when the
/// row exists. Written only by platform/persistence/outbox/.
model CertificationInbox {
  eventId     String   @map("event_id") @db.Uuid
  /// The subscriber's name, "certification.<handler>".
  handler     String
  marketId    String   @map("market_id") @db.VarChar(8)
  tenantId    String   @map("tenant_id")
  processedAt DateTime @map("processed_at") @db.Timestamptz(6)

  @@id([eventId, handler])
  @@map("inbox")
  @@schema("certification")
}

/// A certification type (halal, kosher, ...): the root of the V1 pair with its revisions (data
/// design 3.1). `code` and `verificationMode` never change after the insert (H1): they are not in
/// the column-level UPDATE grant. Never deleted (CERT-03).
model CertificationType {
  id                  String                              @id @db.Uuid
  marketId            String                              @map("market_id") @db.VarChar(8)
  tenantId            String                              @map("tenant_id")
  /// Unique per Market; CHECK ^[a-z][a-z0-9-]{1,31}$.
  code                String
  /// THIRD_PARTY_DOCUMENT | SELF_DECLARATION; immutable (D 16.1 item 4).
  verificationMode    String                              @map("verification_mode")
  /// active | inactive (CERT-03).
  status              String
  /// The published revision (V1 pointer); only a revision of this type. Null only inside the
  /// creating unit; a null read by evaluateClaims is type-unknown (fail closed).
  publishedRevisionId String?                             @map("published_revision_id") @db.Uuid
  /// Optimistic version of the aggregate (CE1); 1 at insert.
  version             Int
  createdAt           DateTime                            @map("created_at") @db.Timestamptz(6)
  revisions           CertificationTypeRevision[]         @relation("TypeRevisions")
  publishedRevision   CertificationTypeRevision?          @relation("TypePublished", fields: [marketId, id, publishedRevisionId], references: [marketId, typeId, id], onDelete: Restrict, onUpdate: Restrict)
  issuers             CertificationIssuer[]
  certificates        CertificationSellerCertification[]
  documents           CertificationUploadedDocument[]
  issuerRequests      CertificationIssuerRequest[]
  claimBasisPolicy    CertificationClaimBasisPolicy?
  productCertificates CertificationProductCertification[]

  /// The target of composite foreign keys (C3).
  @@unique([marketId, id])
  /// The target of the revision foreign key, which carries the verification mode (H1).
  @@unique([marketId, id, verificationMode])
  /// One code per Market (CERT-01).
  @@unique([marketId, code])
  @@map("certification_types")
  @@schema("certification")
}

/// The settings of a type at one revision (data design 3.2). Insert-only (CE3): a save is a new
/// row. The texts, claim terms and the change reason arrive with migration 2.
model CertificationTypeRevision {
  id                         String                                       @id @db.Uuid
  marketId                   String                                       @map("market_id") @db.VarChar(8)
  tenantId                   String                                       @map("tenant_id")
  typeId                     String                                       @map("type_id") @db.Uuid
  /// 1, 2, ...; unique per type.
  revisionNo                 Int                                          @map("revision_no")
  /// A copy bound by the foreign key: a revision never carries another mode than its type.
  verificationMode           String                                       @map("verification_mode")
  requiresIssuerRegistry     Boolean                                      @map("requires_issuer_registry")
  requiresDocument           Boolean                                      @map("requires_document")
  requiresExpiry             Boolean                                      @map("requires_expiry")
  /// SELLER_REQUIRED | NOT_APPLICABLE; never SELLER_OR_MANUFACTURER (brief s5, AC 4).
  defaultBasis               String                                       @map("default_basis")
  autoApproveSelfDeclaration Boolean                                      @map("auto_approve_self_declaration")
  /// A design-system icon key (ADR-0017), never an uploaded file.
  badgeIconKey               String                                       @map("badge_icon_key")
  /// Optional admin text, a ciphertext under its own destroyable subject key (CE8); never in a
  /// content hash, an event, a log or a model input.
  changeReasonCiphertext     String?                                      @map("change_reason_ciphertext")
  authorAccountId            String                                       @map("author_account_id") @db.Uuid
  createdAt                  DateTime                                     @map("created_at") @db.Timestamptz(6)
  type                       CertificationType                            @relation("TypeRevisions", fields: [marketId, typeId, verificationMode], references: [marketId, id, verificationMode], onDelete: Restrict, onUpdate: Restrict)
  publishedOf                CertificationType[]                          @relation("TypePublished")
  submissions                CertificationSellerCertificationSubmission[]
  texts                      CertificationTypeRevisionText[]
  productRevisions           CertificationProductCertificationRevision[]

  @@unique([marketId, id])
  /// The target of the published pointer and of the submission foreign key (CE4).
  @@unique([marketId, typeId, id])
  @@unique([marketId, typeId, revisionNo])
  @@map("certification_type_revisions")
  @@schema("certification")
}

/// The registry of issuers of a type (data design 3.7). Never deleted (CERT-04). Only the
/// contact channels (issuer_contact_channels) arrive with migration 2.
model CertificationIssuer {
  id                        String                                       @id @db.Uuid
  marketId                  String                                       @map("market_id") @db.VarChar(8)
  tenantId                  String                                       @map("tenant_id")
  typeId                    String                                       @map("type_id") @db.Uuid
  /// Public (on the badge); CHECK 1 to 200 characters.
  displayName               String                                       @map("display_name")
  /// NFKC, case-folded, whitespace-collapsed by the application; collation "C" is set in the
  /// migration. Unique per type.
  displayNameKey            String                                       @map("display_name_key")
  accreditationNumber       String?                                      @map("accreditation_number")
  /// proposed | active | closed-to-new | derecognised.
  state                     String
  /// Encrypted under the Market's platform subject (CE7). Never active without one.
  expertReferenceCiphertext String?                                      @map("expert_reference_ciphertext")
  stateChangedAt            DateTime                                     @map("state_changed_at") @db.Timestamptz(6)
  /// admin | seed
  stateChangedByKind        String                                       @map("state_changed_by_kind")
  stateChangedByAccountId   String?                                      @map("state_changed_by_account_id") @db.Uuid
  version                   Int
  createdAt                 DateTime                                     @map("created_at") @db.Timestamptz(6)
  type                      CertificationType                            @relation(fields: [marketId, typeId], references: [marketId, id], onDelete: Restrict, onUpdate: Restrict)
  submissions               CertificationSellerCertificationSubmission[]
  draftOf                   CertificationSellerCertification[]           @relation("CertificateDraftIssuer")
  channels                  CertificationIssuerContactChannel[]
  issuerRequests            CertificationIssuerRequest[]
  productDraftOf            CertificationProductCertification[]          @relation("ProductCertificateDraftIssuer")
  productRevisions          CertificationProductCertificationRevision[]

  @@unique([marketId, id])
  /// The target of every issuer foreign key, which carries the type (CE4).
  @@unique([marketId, id, typeId])
  @@unique([marketId, typeId, displayNameKey])
  @@map("issuers")
  @@schema("certification")
}

/// One seller's certificate of one type: the root of the V1 pair with its submissions (data
/// design 3.4). Slice-1 columns only; the draft columns arrive with the slice that writes them.
model CertificationSellerCertification {
  id                   String                                       @id @db.Uuid
  marketId             String                                       @map("market_id") @db.VarChar(8)
  tenantId             String                                       @map("tenant_id")
  /// Minted by identity; also the subject of the seller's key (D 10.1). No foreign key (C4).
  sellerId             String                                       @map("seller_id") @db.Uuid
  typeId               String                                       @map("type_id") @db.Uuid
  /// draft | in-review | approved | changes-needed | declined | expired | revoked (D 3.1).
  status               String
  /// The one pending submission; a single column, so "at most one pending" holds by construction.
  pendingSubmissionId  String?                                      @map("pending_submission_id") @db.Uuid
  /// The approved submission (V1 pointer); only a submission of this certificate.
  approvedSubmissionId String?                                      @map("approved_submission_id") @db.Uuid
  /// Denormalised copy of the approved decision's boundary, for the expiry job's index only;
  /// evaluateClaims reads the decision row, never this column.
  approvedBoundaryAt   DateTime?                                    @map("approved_boundary_at") @db.Timestamptz(6)
  statusChangedAt      DateTime                                     @map("status_changed_at") @db.Timestamptz(6)
  lastChangedAt        DateTime                                     @map("last_changed_at") @db.Timestamptz(6)
  /// The seller's working copy (data design 3.4, draft columns). Only an issuer of the same type
  /// and Market (AC 11); its state is checked at submit.
  draftIssuerId        String?                                      @map("draft_issuer_id") @db.Uuid
  /// Personal, encrypted under the seller's key (label certification.seller-certification.draft-certificate-number).
  draftCertificateNumberCiphertext String?                          @map("draft_certificate_number_ciphertext")
  draftIssueDate       DateTime?                                    @map("draft_issue_date") @db.Date
  draftExpiryDate      DateTime?                                    @map("draft_expiry_date") @db.Date
  /// The seller's own tick (R14).
  draftSelfDeclared    Boolean?                                     @map("draft_self_declared")
  draftSelfDeclarationNoteCiphertext String?                        @map("draft_self_declaration_note_ciphertext")
  version              Int
  createdAt            DateTime                                     @map("created_at") @db.Timestamptz(6)
  draftIssuer          CertificationIssuer?                         @relation("CertificateDraftIssuer", fields: [marketId, draftIssuerId, typeId], references: [marketId, id, typeId], onDelete: Restrict, onUpdate: Restrict)
  draftDocuments       CertificationSellerDraftDocument[]
  history              CertificationSellerCertificationHistory[]
  type                 CertificationType                            @relation(fields: [marketId, typeId], references: [marketId, id], onDelete: Restrict, onUpdate: Restrict)
  submissions          CertificationSellerCertificationSubmission[] @relation("CertificateSubmissions")
  pendingSubmission    CertificationSellerCertificationSubmission?  @relation("CertificatePending", fields: [marketId, id, pendingSubmissionId], references: [marketId, sellerCertificationId, id], onDelete: Restrict, onUpdate: Restrict)
  approvedSubmission   CertificationSellerCertificationSubmission?  @relation("CertificateApproved", fields: [marketId, id, approvedSubmissionId], references: [marketId, sellerCertificationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([marketId, id])
  /// The target of the type foreign keys of later tables (CE4).
  @@unique([marketId, id, typeId])
  /// The target of the submission foreign key, which carries the type and the seller, so a
  /// submission's seller is its certificate's and the certificate's seller never moves (Hassan M-1).
  @@unique([marketId, id, typeId, sellerId], map: "seller_certifications_market_id_id_type_id_seller_id_key")
  /// The seller's own list (every status, terminal ones included).
  /// Serves the keyset order of the list (created_at DESC, id DESC) exactly.
  @@index([marketId, sellerId, createdAt, id])
  @@map("seller_certifications")
  @@schema("certification")
}

/// The content a seller submitted for review (data design 3.5). Insert-only (CE3). Its status
/// is derived: pending = the root's pending pointer; approved, changes-requested, declined and
/// withdrawn = its decision row.
model CertificationSellerCertificationSubmission {
  id                           String                             @id @db.Uuid
  marketId                     String                             @map("market_id") @db.VarChar(8)
  tenantId                     String                             @map("tenant_id")
  sellerCertificationId        String                             @map("seller_certification_id") @db.Uuid
  /// Copies bound by the foreign keys (type) and by the use case (seller).
  sellerId                     String                             @map("seller_id") @db.Uuid
  typeId                       String                             @map("type_id") @db.Uuid
  /// The type revision in force at submission (D 2.1).
  typeRevisionId               String                             @map("type_revision_id") @db.Uuid
  submissionNo                 Int                                @map("submission_no")
  /// initial | resubmission | renewal
  kind                         String
  issuerId                     String?                            @map("issuer_id") @db.Uuid
  certificateNumberCiphertext  String?                            @map("certificate_number_ciphertext")
  issueDate                    DateTime?                          @map("issue_date") @db.Date
  expiryDate                   DateTime?                          @map("expiry_date") @db.Date
  selfDeclared                 Boolean?                           @map("self_declared")
  selfDeclarationNoteCiphertext String?                           @map("self_declaration_note_ciphertext")
  contentSchemaVersion         Int                                @map("content_schema_version") @db.SmallInt
  /// "hmac-sha256:<64 hex>" from SubjectKeyService.hmac (D 10.2).
  contentHash                  String                             @map("content_hash")
  /// The seller's IANA zone at submission (CE6).
  submittedZone                String                             @map("submitted_zone")
  submittedAt                  DateTime                           @map("submitted_at") @db.Timestamptz(6)
  submittedByAccountId         String                             @map("submitted_by_account_id") @db.Uuid
  certificate                  CertificationSellerCertification   @relation("CertificateSubmissions", fields: [marketId, sellerCertificationId, typeId, sellerId], references: [marketId, id, typeId, sellerId], onDelete: Restrict, onUpdate: Restrict)
  typeRevision                 CertificationTypeRevision          @relation(fields: [marketId, typeId, typeRevisionId], references: [marketId, typeId, id], onDelete: Restrict, onUpdate: Restrict)
  issuer                       CertificationIssuer?               @relation(fields: [marketId, issuerId, typeId], references: [marketId, id, typeId], onDelete: Restrict, onUpdate: Restrict)
  pendingOf                    CertificationSellerCertification[] @relation("CertificatePending")
  approvedOf                   CertificationSellerCertification[] @relation("CertificateApproved")
  decision                     CertificationSellerSubmissionDecision?
  documents                    CertificationSubmissionDocument[]
  history                      CertificationSellerCertificationHistory[]
  reviewChecks                 CertificationReviewCheck[]
  scopeReadings                CertificationScopeReading[]
  issuerConfirmations          CertificationIssuerConfirmation[]
  numberIndexRows              CertificationCertificateNumberIndex[]

  @@unique([marketId, id])
  /// The target of the pointer foreign keys of the root (CE4).
  @@unique([marketId, sellerCertificationId, id], map: "seller_certification_submissions_market_id_cert_id_id_key")
  @@unique([marketId, sellerCertificationId, submissionNo], map: "seller_certification_submissions_market_id_cert_id_no_key")
  /// The target of the issuer confirmation foreign key (migration with slice 7).
  @@unique([marketId, id, issuerId])
  /// The target of the number index's foreign key (slice 7): a row names its submission's seller.
  @@unique([marketId, id, sellerId], map: "seller_cert_submissions_id_seller_key")
  /// The target of the document-link foreign key, which carries the type and the seller, so a
  /// submission can only hold its own seller's files of its own type (PR 382, database-designer 4).
  @@unique([marketId, id, typeId, sellerId], map: "seller_cert_submissions_id_type_seller_key")
  @@map("seller_certification_submissions")
  @@schema("certification")
}

/// One terminal outcome per submission (data design 3.6, V4): approved, changes-requested,
/// declined or withdrawn. Insert-only (CE3). evaluateClaims reads the approved row.
model CertificationSellerSubmissionDecision {
  marketId             String                                     @map("market_id") @db.VarChar(8)
  tenantId             String                                     @map("tenant_id")
  submissionId         String                                     @map("submission_id") @db.Uuid
  /// approved | changes-requested | declined | withdrawn
  outcome              String
  /// The seller's zone at approval (T2); set exactly on an approval.
  approvedZone         String?                                    @map("approved_zone")
  /// 00:00 of the day after the expiry date in approvedZone (D 2.4 rule 2).
  expiryBoundaryAt     DateTime?                                  @map("expiry_boundary_at") @db.Timestamptz(6)
  reasonCode           String?                                    @map("reason_code")
  reasonTextCiphertext String?                                    @map("reason_text_ciphertext")
  /// edited | cancelled | revoked; set exactly on a withdrawal.
  withdrawCause        String?                                    @map("withdraw_cause")
  /// seller | admin | system
  actorKind            String                                     @map("actor_kind")
  actorAccountId       String?                                    @map("actor_account_id") @db.Uuid
  decidedAt            DateTime                                   @map("decided_at") @db.Timestamptz(6)
  submission           CertificationSellerCertificationSubmission @relation(fields: [marketId, submissionId], references: [marketId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([marketId, submissionId])
  @@map("seller_submission_decisions")
  @@schema("certification")
}

/// The public name and description of a type revision in one locale (data design 3.3). Insert-only
/// (CE3). Membership of the locale in the Market's supportedLocales is the aggregate's rule.
model CertificationTypeRevisionText {
  marketId            String                    @map("market_id") @db.VarChar(8)
  tenantId            String                    @map("tenant_id")
  typeRevisionId      String                    @map("type_revision_id") @db.Uuid
  /// BCP 47 shape, CHECKed.
  locale              String
  name                String
  customerDescription String                    @map("customer_description")
  revision            CertificationTypeRevision @relation(fields: [marketId, typeRevisionId], references: [marketId, id], onDelete: Restrict, onUpdate: Restrict)
  terms               CertificationClaimTerm[]

  @@id([marketId, typeRevisionId, locale])
  @@map("type_revision_texts")
  @@schema("certification")
}

/// A claim phrase a revision names in a locale (data design 3.3): human-written (R10), stored as
/// written; the matcher normalises in code. Insert-only (CE3). No regular expression column.
model CertificationClaimTerm {
  marketId       String                        @map("market_id") @db.VarChar(8)
  tenantId       String                        @map("tenant_id")
  typeRevisionId String                        @map("type_revision_id") @db.Uuid
  locale         String
  phrase         String
  text           CertificationTypeRevisionText @relation(fields: [marketId, typeRevisionId, locale], references: [marketId, typeRevisionId, locale], onDelete: Restrict, onUpdate: Restrict)

  @@id([marketId, typeRevisionId, locale, phrase])
  @@map("claim_terms")
  @@schema("certification")
}

/// A registered contact channel of an issuer (data design 3.7): a channel that a confirmation
/// names is retired, never deleted or rewritten.
model CertificationIssuerContactChannel {
  id                   String                                   @id @db.Uuid
  marketId             String                                   @map("market_id") @db.VarChar(8)
  tenantId             String                                   @map("tenant_id")
  issuerId             String                                   @map("issuer_id") @db.Uuid
  /// email-domain | phone | web-page
  kind                 String
  value                String
  retiredAt            DateTime?                                @map("retired_at") @db.Timestamptz(6)
  createdAt            DateTime                                 @map("created_at") @db.Timestamptz(6)
  issuer               CertificationIssuer                      @relation(fields: [marketId, issuerId], references: [marketId, id], onDelete: Restrict, onUpdate: Restrict)
  confirmations        CertificationIssuerConfirmation[]
  productConfirmations CertificationProductIssuerConfirmation[]

  @@unique([marketId, id])
  /// The target of the confirmation foreign key (migration with slice 7).
  @@unique([marketId, issuerId, id])
  @@map("issuer_contact_channels")
  @@schema("certification")
}

/// A pending relaxation that needs a second admin (data design 3.20, D 7.6): a type revision, a
/// claim policy revision, or the reactivation of an issuer or a type. One pending proposal per
/// subject. The subject is a type, policy or issuer id: three possible parents, so no foreign key
/// (C4). The content never changes after the insert; only the decision columns do.
model CertificationRelaxationProposal {
  id                                 String    @id @db.Uuid
  marketId                           String    @map("market_id") @db.VarChar(8)
  tenantId                           String    @map("tenant_id")
  /// type-revision | claim-policy-revision | issuer-reactivation | type-reactivation
  subjectKind                        String    @map("subject_kind")
  subjectId                          String    @map("subject_id") @db.Uuid
  basedOnRevisionId                  String?   @map("based_on_revision_id") @db.Uuid
  proposedRevisionId                 String?   @map("proposed_revision_id") @db.Uuid
  /// Issuer reactivation only: the new expert reference, under the platform key (CE7).
  proposedExpertReferenceCiphertext  String?   @map("proposed_expert_reference_ciphertext")
  /// pending | approved | rejected | withdrawn | superseded
  state                              String
  proposerAccountId                  String    @map("proposer_account_id") @db.Uuid
  proposedAt                         DateTime  @map("proposed_at") @db.Timestamptz(6)
  /// A second admin: never the proposer (H1).
  decidedByAccountId                 String?   @map("decided_by_account_id") @db.Uuid
  decidedAt                          DateTime? @map("decided_at") @db.Timestamptz(6)
  changeReasonCiphertext             String?   @map("change_reason_ciphertext")
  version                            Int
  createdAt                          DateTime  @map("created_at") @db.Timestamptz(6)

  @@unique([marketId, id])
  @@map("relaxation_proposals")
  @@schema("certification")
}

/// The Market's platform subject for platform-key encryption (data design 3.22, CE7): one row per
/// Market, never updated or deleted. The id is an opaque random UUIDv7, not the Market code.
model CertificationPlatformSubject {
  marketId  String   @id @map("market_id") @db.VarChar(8)
  tenantId  String   @map("tenant_id")
  subjectId String   @map("subject_id") @db.Uuid
  createdAt DateTime @map("created_at") @db.Timestamptz(6)

  @@map("platform_subjects")
  @@schema("certification")
}

/// One uploaded file (data design 3.9, simplified for the first release, the same decision as the
/// catalog photos): the bytes live in the object store, encrypted with a random per-file AES-256-GCM
/// key whose envelope (wrapped under the owner's subject key) is `data_key_envelope`. There is no
/// scanner, no sandbox, no preview and no evidence bucket, so `evidence_key`, `retain_until` and
/// `promoted_at` are not created. A refused file is never stored; the `received`, `scanning` and
/// `refused` values stay in the CHECK so a scanner can be added later. A set-once trigger keeps the
/// identity of the row fixed. The client's file name is never stored.
model CertificationUploadedDocument {
  id              String                             @id @db.Uuid
  marketId        String                             @map("market_id") @db.VarChar(8)
  tenantId        String                             @map("tenant_id")
  /// The seller for seller files; NULL for admin-recorded manufacturer files (later).
  ownerSellerId   String?                            @map("owner_seller_id") @db.Uuid
  /// seller-certificate | issuer-request | product-certificate
  purpose         String
  typeId          String?                            @map("type_id") @db.Uuid
  /// received | scanning | clean | refused
  state           String
  refusalCode     String?                            @map("refusal_code")
  /// Found by inspection of the content, never the client's.
  mediaType       String?                            @map("media_type")
  /// Plaintext size in bytes.
  byteSize        BigInt                             @map("byte_size")
  pageCount       Int?                               @map("page_count") @db.SmallInt
  /// The per-file data key wrapped under the owner's subject key (label certification.document.data-key).
  dataKeyEnvelope String                             @map("data_key_envelope")
  /// Key of the encrypted object (`certification/<sellerId>/<documentId>`).
  objectKey       String                             @map("object_key")
  /// SHA-256 of the stored (encrypted) bytes, recorded when the file became clean.
  cleanSha256     Bytes?                             @map("clean_sha256")
  version         Int
  createdAt       DateTime                           @map("created_at") @db.Timestamptz(6)
  type            CertificationType?                 @relation(fields: [marketId, typeId], references: [marketId, id], onDelete: Restrict, onUpdate: Restrict)
  draftLinks      CertificationSellerDraftDocument[]
  submissionLinks CertificationSubmissionDocument[]
  indexRows       CertificationDocumentIndex[]
  requestLinks    CertificationIssuerRequestDocument[]

  @@unique([marketId, id])
  /// The target of the document index's foreign key (slice 7): a row names its file's owner.
  @@unique([marketId, id, ownerSellerId], map: "uploaded_documents_market_id_id_owner_seller_id_key")
  /// The target of the draft link's foreign key: the link names the owner and the type.
  @@unique([marketId, id, typeId, ownerSellerId], map: "uploaded_documents_market_id_id_type_id_owner_seller_id_key")
  @@unique([marketId, objectKey])
  @@index([marketId, ownerSellerId, createdAt])
  @@map("uploaded_documents")
  @@schema("certification")
}

/// Bytes of draft files a seller holds (data design 3.12). The limit is Market configuration, so it
/// is no CHECK: the upload reserves with one guarded statement.
model CertificationSellerDraftQuota {
  marketId   String   @map("market_id") @db.VarChar(8)
  tenantId   String   @map("tenant_id")
  sellerId   String   @map("seller_id") @db.Uuid
  draftBytes BigInt   @map("draft_bytes")
  updatedAt  DateTime @map("updated_at") @db.Timestamptz(6)

  @@id([marketId, sellerId])
  @@map("seller_draft_quotas")
  @@schema("certification")
}

/// Fixed-window counters of the seller-side limits (data design 3.12; SL-data 3.11): keyed HMAC
/// subject under this module's rate-counter key, so no account or seller id is stored in clear.
model CertificationRateCounter {
  marketId        String   @map("market_id") @db.VarChar(8)
  tenantId        String   @map("tenant_id")
  kind            String
  keyHash         Bytes    @map("key_hash")
  windowStartedAt DateTime @map("window_started_at") @db.Timestamptz(6)
  count           Int

  @@id([marketId, kind, keyHash])
  @@map("rate_counters")
  @@schema("certification")
}

/// The files of a certificate's draft (data design 3.11). Mutable: the seller adds and removes
/// files. The foreign keys bind the file's owner and type to the certificate's.
model CertificationSellerDraftDocument {
  marketId              String                           @map("market_id") @db.VarChar(8)
  tenantId              String                           @map("tenant_id")
  sellerCertificationId String                           @map("seller_certification_id") @db.Uuid
  typeId                String                           @map("type_id") @db.Uuid
  sellerId              String                           @map("seller_id") @db.Uuid
  documentId            String                           @map("document_id") @db.Uuid
  position              Int                              @db.SmallInt
  certificate           CertificationSellerCertification @relation(fields: [marketId, sellerCertificationId, typeId, sellerId], references: [marketId, id, typeId, sellerId], onDelete: Restrict, onUpdate: Restrict)
  document              CertificationUploadedDocument    @relation(fields: [marketId, documentId, typeId, sellerId], references: [marketId, id, typeId, ownerSellerId], onDelete: Restrict, onUpdate: Restrict)

  @@id([marketId, sellerCertificationId, documentId])
  /// A file belongs to at most one draft.
  @@unique([marketId, documentId])
  /// A backstop for the draft order: no two files at one position.
  @@unique([marketId, sellerCertificationId, position], map: "seller_cert_draft_documents_position_key")
  @@map("seller_certification_draft_documents")
  @@schema("certification")
}

/// The files a submission holds (data design 3.11). Insert-only (CE3). A resubmission that keeps a
/// file links the same document row. The count limit (10) is request validation.
model CertificationSubmissionDocument {
  marketId     String                                     @map("market_id") @db.VarChar(8)
  tenantId     String                                     @map("tenant_id")
  submissionId String                                     @map("submission_id") @db.Uuid
  documentId   String                                     @map("document_id") @db.Uuid
  /// Copies bound by the two composite foreign keys below: the submission's and the file's own.
  typeId       String                                     @map("type_id") @db.Uuid
  sellerId     String                                     @map("seller_id") @db.Uuid
  position     Int                                        @db.SmallInt
  submission   CertificationSellerCertificationSubmission @relation(fields: [marketId, submissionId, typeId, sellerId], references: [marketId, id, typeId, sellerId], map: "seller_submission_documents_submission_fkey", onDelete: Restrict, onUpdate: Restrict)
  document     CertificationUploadedDocument              @relation(fields: [marketId, documentId, typeId, sellerId], references: [marketId, id, typeId, ownerSellerId], map: "seller_submission_documents_document_fkey", onDelete: Restrict, onUpdate: Restrict)

  @@id([marketId, submissionId, documentId])
  @@unique([marketId, submissionId, position])
  @@index([marketId, documentId])
  @@map("seller_submission_documents")
  @@schema("certification")
}

/// The status history of a certificate (data design 3.13; V4, CERT-17). Insert-only (CE3). The
/// first row is written at the first submission; creating a draft writes none, so a never-submitted
/// record can be deleted.
model CertificationSellerCertificationHistory {
  id                    String                                      @id @db.Uuid
  marketId              String                                      @map("market_id") @db.VarChar(8)
  tenantId              String                                      @map("tenant_id")
  sellerCertificationId String                                      @map("seller_certification_id") @db.Uuid
  fromStatus            String?                                     @map("from_status")
  toStatus              String                                      @map("to_status")
  submissionId          String?                                     @map("submission_id") @db.Uuid
  /// seller | admin | system
  actorKind             String                                      @map("actor_kind")
  actorAccountId        String?                                     @map("actor_account_id") @db.Uuid
  reasonCode            String?                                     @map("reason_code")
  noteCiphertext        String?                                     @map("note_ciphertext")
  occurredAt            DateTime                                    @map("occurred_at") @db.Timestamptz(6)
  certificate           CertificationSellerCertification            @relation(fields: [marketId, sellerCertificationId], references: [marketId, id], onDelete: Restrict, onUpdate: Restrict, map: "seller_certification_history_certificate_fkey")
  submission            CertificationSellerCertificationSubmission? @relation(fields: [marketId, sellerCertificationId, submissionId], references: [marketId, sellerCertificationId, id], onDelete: Restrict, onUpdate: Restrict, map: "seller_certification_history_submission_fkey")

  @@unique([marketId, id])
  @@index([marketId, sellerCertificationId, occurredAt])
  @@map("seller_certification_history")
  @@schema("certification")
}

/// One recorded review check (data design 3.10, slice 7; V4). Insert-only (CE3): a re-recording is
/// a new row and the latest row per (submission, check code) counts. `check_code` is a code of the
/// Market's `reviewChecks` (checked by the use case, not a CHECK).
model CertificationReviewCheck {
  id                  String                                     @id @db.Uuid
  marketId            String                                     @map("market_id") @db.VarChar(8)
  tenantId            String                                     @map("tenant_id")
  submissionId        String                                     @map("submission_id") @db.Uuid
  checkCode           String                                     @map("check_code")
  /// done | problem | not-applicable
  result              String
  recordedByAccountId String                                     @map("recorded_by_account_id") @db.Uuid
  recordedAt          DateTime                                   @map("recorded_at") @db.Timestamptz(6)
  submission          CertificationSellerCertificationSubmission @relation(fields: [marketId, submissionId], references: [marketId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([marketId, id])
  /// The approval guard reads the latest row per code over this index.
  @@index([marketId, submissionId, checkCode, recordedAt(sort: Desc)])
  @@map("submission_review_checks")
  @@schema("certification")
}

/// The location and scope as read by the reviewer (data design 3.10, D 3.2 rule 5): two encrypted
/// texts under the seller's key. Insert-only (CE3); the latest row per submission counts.
model CertificationScopeReading {
  id                  String                                     @id @db.Uuid
  marketId            String                                     @map("market_id") @db.VarChar(8)
  tenantId            String                                     @map("tenant_id")
  submissionId        String                                     @map("submission_id") @db.Uuid
  locationCiphertext  String                                     @map("location_ciphertext")
  scopeCiphertext     String                                     @map("scope_ciphertext")
  recordedByAccountId String                                     @map("recorded_by_account_id") @db.Uuid
  recordedAt          DateTime                                   @map("recorded_at") @db.Timestamptz(6)
  submission          CertificationSellerCertificationSubmission @relation(fields: [marketId, submissionId], references: [marketId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([marketId, id])
  @@index([marketId, submissionId, recordedAt(sort: Desc)])
  @@map("submission_scope_readings")
  @@schema("certification")
}

/// A reviewer's confirmation with the issuer (data design 3.16a, D 3.2 rule 7): at most one per
/// submission, only through a registered channel of the submission's issuer, both ticks required.
/// Insert-only (CE3); `verifiedWithIssuer` is "a row exists".
model CertificationIssuerConfirmation {
  marketId            String                                     @map("market_id") @db.VarChar(8)
  tenantId            String                                     @map("tenant_id")
  submissionId        String                                     @map("submission_id") @db.Uuid
  issuerId            String                                     @map("issuer_id") @db.Uuid
  channelId           String                                     @map("channel_id") @db.Uuid
  confirmedOn         DateTime                                   @map("confirmed_on") @db.Date
  referenceCiphertext String                                     @map("reference_ciphertext")
  confirmsNumber      Boolean                                    @map("confirms_number")
  confirmsHolder      Boolean                                    @map("confirms_holder")
  recordedByAccountId String                                     @map("recorded_by_account_id") @db.Uuid
  recordedAt          DateTime                                   @map("recorded_at") @db.Timestamptz(6)
  submission          CertificationSellerCertificationSubmission @relation(fields: [marketId, submissionId, issuerId], references: [marketId, id, issuerId], onDelete: Restrict, onUpdate: Restrict)
  channel             CertificationIssuerContactChannel          @relation(fields: [marketId, issuerId, channelId], references: [marketId, issuerId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([marketId, submissionId])
  @@map("seller_issuer_confirmations")
  @@schema("certification")
}

/// The keyed index of a submission's certificate number (data design 3.17, D 10.2): HMAC-SHA-256
/// under the stack secret over Market, type and the normalised number. Pseudonymous personal data
/// that survives the seller's key, so the erasure handler deletes the seller's rows (L4).
model CertificationCertificateNumberIndex {
  marketId     String                                     @map("market_id") @db.VarChar(8)
  tenantId     String                                     @map("tenant_id")
  submissionId String                                     @map("submission_id") @db.Uuid
  sellerId     String                                     @map("seller_id") @db.Uuid
  indexHmac    Bytes                                      @map("index_hmac")
  submission   CertificationSellerCertificationSubmission @relation(fields: [marketId, submissionId, sellerId], references: [marketId, id, sellerId], onDelete: Restrict, onUpdate: Restrict)

  @@id([marketId, submissionId])
  @@index([marketId, indexHmac])
  @@index([marketId, sellerId])
  @@map("certificate_number_index")
  @@schema("certification")
}

/// The keyed index of an uploaded file's plaintext bytes (data design 3.17): written with the file,
/// deleted with it while it is a draft, and deleted for the seller on erasure (L4).
model CertificationDocumentIndex {
  marketId   String                        @map("market_id") @db.VarChar(8)
  tenantId   String                        @map("tenant_id")
  documentId String                        @map("document_id") @db.Uuid
  sellerId   String                        @map("seller_id") @db.Uuid
  indexHmac  Bytes                         @map("index_hmac")
  document   CertificationUploadedDocument @relation(fields: [marketId, documentId, sellerId], references: [marketId, id, ownerSellerId], onDelete: Restrict, onUpdate: Restrict)

  @@id([marketId, documentId])
  @@index([marketId, indexHmac])
  @@index([marketId, sellerId])
  @@map("document_index")
  @@schema("certification")
}

/// "My issuer is not listed" (data design 3.8; D 2.1 `IssuerRequest`): one seller's request for a
/// missing issuer of one registry type, with the issuer's name as the seller typed it. The name is
/// request text only, encrypted under the seller's subject key (label
/// certification.issuer-request.typed-name, D 10.1) and immutable (not in the UPDATE grant). There
/// is no column or foreign key from `issuers` to a request: the text has no path into the registry
/// or a submission (AC 11). Never deleted. The open-queue and per-seller partial indexes are in the
/// migration (invisible to Prisma).
model CertificationIssuerRequest {
  id                   String                               @id @db.Uuid
  marketId             String                               @map("market_id") @db.VarChar(8)
  tenantId             String                               @map("tenant_id")
  sellerId             String                               @map("seller_id") @db.Uuid
  typeId               String                               @map("type_id") @db.Uuid
  /// Personal (a seller's text); a v1 envelope of the platform SubjectKeyService.
  typedNameCiphertext  String                               @map("typed_name_ciphertext")
  /// open | issuer-added | not-accepted
  state                String
  /// A reason code of the Market's list (S8); set iff not-accepted.
  answerReasonCode     String?                              @map("answer_reason_code")
  /// The issuer the admin added, of the request's type (the foreign key carries the type); set iff
  /// issuer-added.
  issuerId             String?                              @map("issuer_id") @db.Uuid
  answeredAt           DateTime?                            @map("answered_at") @db.Timestamptz(6)
  answeredByAccountId  String?                              @map("answered_by_account_id") @db.Uuid
  version              Int
  createdAt            DateTime                             @map("created_at") @db.Timestamptz(6)
  type                 CertificationType                    @relation(fields: [marketId, typeId], references: [marketId, id], onDelete: Restrict, onUpdate: Restrict)
  issuer               CertificationIssuer?                 @relation(fields: [marketId, issuerId, typeId], references: [marketId, id, typeId], onDelete: Restrict, onUpdate: Restrict)
  documents            CertificationIssuerRequestDocument[]

  @@unique([marketId, id])
  /// The target of the document link's foreign key: the link names the seller and the type.
  @@unique([marketId, id, typeId, sellerId], map: "issuer_requests_market_id_id_type_id_seller_id_key")
  @@map("issuer_requests")
  @@schema("certification")
}

/// The files of an issuer request (data design 3.8). Insert-only (CE3). The foreign keys bind the
/// file's owner and type to the request's; a trigger admits only a clean `issuer-request` file.
model CertificationIssuerRequestDocument {
  marketId        String                        @map("market_id") @db.VarChar(8)
  tenantId        String                        @map("tenant_id")
  issuerRequestId String                        @map("issuer_request_id") @db.Uuid
  typeId          String                        @map("type_id") @db.Uuid
  sellerId        String                        @map("seller_id") @db.Uuid
  documentId      String                        @map("document_id") @db.Uuid
  position        Int                           @db.SmallInt
  request         CertificationIssuerRequest    @relation(fields: [marketId, issuerRequestId, typeId, sellerId], references: [marketId, id, typeId, sellerId], map: "issuer_request_documents_request_fkey", onDelete: Restrict, onUpdate: Restrict)
  document        CertificationUploadedDocument @relation(fields: [marketId, documentId, typeId, sellerId], references: [marketId, id, typeId, ownerSellerId], map: "issuer_request_documents_document_fkey", onDelete: Restrict, onUpdate: Restrict)

  @@id([marketId, issuerRequestId, documentId])
  /// A file belongs to at most one request.
  @@unique([marketId, documentId])
  @@unique([marketId, issuerRequestId, position])
  @@map("issuer_request_documents")
  @@schema("certification")
}

/// One marker per (approved submission or manufacturer revision, warning threshold) (data design
/// 3.18, slice 9): written by the expiry job in the root's unit together with the event, so a
/// re-run creates nothing (D 8.6, AC 9). One table for two parents, no foreign key (C4).
/// Insert-only (CE3); a renewal is a new submission, so its warnings start afresh.
model CertificationExpiryWarning {
  marketId      String   @map("market_id") @db.VarChar(8)
  tenantId      String   @map("tenant_id")
  /// submission | product-revision
  versionKind   String   @map("version_kind")
  versionId     String   @map("version_id") @db.Uuid
  thresholdDays Int      @map("threshold_days") @db.SmallInt
  createdAt     DateTime @map("created_at") @db.Timestamptz(6)

  @@id([marketId, versionKind, versionId, thresholdDays])
  @@map("expiry_warnings")
  @@schema("certification")
}

/// The claim basis policy of one type in one Market (data design 3.14; D 2.1, 3.7; slice 13): the
/// root of the V1 pair with its revisions. `published_revision_id` is null until a first revision
/// is published (a first relaxing revision waits for a second admin): no published revision means
/// every query gets the type's default basis.
model CertificationClaimBasisPolicy {
  id                  String                             @id @db.Uuid
  marketId            String                             @map("market_id") @db.VarChar(8)
  tenantId            String                             @map("tenant_id")
  typeId              String                             @map("type_id") @db.Uuid
  publishedRevisionId String?                            @map("published_revision_id") @db.Uuid
  /// Optimistic version of the aggregate (CE1); 1 at insert.
  version             Int
  createdAt           DateTime                           @map("created_at") @db.Timestamptz(6)
  type                CertificationType                  @relation(fields: [marketId, typeId], references: [marketId, id], map: "claim_basis_policies_type_fkey", onDelete: Restrict, onUpdate: Restrict)
  revisions           CertificationClaimPolicyRevision[] @relation("PolicyRevisions")
  publishedRevision   CertificationClaimPolicyRevision?  @relation("PolicyPublished", fields: [marketId, id, publishedRevisionId], references: [marketId, policyId, id], map: "claim_basis_policies_published_revision_fkey", onDelete: Restrict, onUpdate: Restrict)

  @@unique([marketId, id])
  /// One policy per Market and type (D 2.1).
  @@unique([marketId, typeId])
  @@map("claim_basis_policies")
  @@schema("certification")
}

/// One revision of a policy (data design 3.14): its rows are in `claim_policy_rows`. Insert-only
/// (CE3); a revision that is never published is simply never pointed at.
model CertificationClaimPolicyRevision {
  id                     String                          @id @db.Uuid
  marketId               String                          @map("market_id") @db.VarChar(8)
  tenantId               String                          @map("tenant_id")
  policyId               String                          @map("policy_id") @db.Uuid
  /// 1, 2, ...; unique per policy.
  revisionNo             Int                             @map("revision_no")
  /// Optional admin text, a ciphertext under its own destroyable subject key (CE8).
  changeReasonCiphertext String?                         @map("change_reason_ciphertext")
  authorAccountId        String                          @map("author_account_id") @db.Uuid
  createdAt              DateTime                        @map("created_at") @db.Timestamptz(6)
  policy                 CertificationClaimBasisPolicy   @relation("PolicyRevisions", fields: [marketId, policyId], references: [marketId, id], map: "claim_policy_revisions_policy_fkey", onDelete: Restrict, onUpdate: Restrict)
  publishedOf            CertificationClaimBasisPolicy[] @relation("PolicyPublished")
  rows                   CertificationClaimPolicyRow[]

  @@unique([marketId, id])
  /// The target of the published pointer (CE4).
  @@unique([marketId, policyId, id])
  @@unique([marketId, policyId, revisionNo])
  @@map("claim_policy_revisions")
  @@schema("certification")
}

/// One row `{ selector, basis }` of a policy revision (data design 3.14). Insert-only (CE3). At
/// most one row per selector in a revision; `SELLER_OR_MANUFACTURER` only on a category (M1).
model CertificationClaimPolicyRow {
  id           String                           @id @db.Uuid
  marketId     String                           @map("market_id") @db.VarChar(8)
  tenantId     String                           @map("tenant_id")
  revisionId   String                           @map("revision_id") @db.Uuid
  /// platform-category | handling
  selectorKind String                           @map("selector_kind")
  /// A catalog platform category id (C4: no foreign key).
  categoryId   String?                          @map("category_id") @db.Uuid
  /// SEALED_ORIGINAL | REPACKED | PREPARED | FRESH
  handling     String?
  /// SELLER_REQUIRED | SELLER_OR_MANUFACTURER | NOT_APPLICABLE
  basis        String
  revision     CertificationClaimPolicyRevision @relation(fields: [marketId, revisionId], references: [marketId, id], map: "claim_policy_rows_revision_fkey", onDelete: Restrict, onUpdate: Restrict)

  @@unique([marketId, revisionId, categoryId])
  @@unique([marketId, revisionId, handling])
  @@map("claim_policy_rows")
  @@schema("certification")
}

/// A platform category `catalog` retired while a policy row may name it (data design 3.14; D 3.7
/// backstop, B2): written by `platformCategoriesRetired`, cleared by an admin.
model CertificationRetiredCategoryFlag {
  marketId           String    @map("market_id") @db.VarChar(8)
  tenantId           String    @map("tenant_id")
  categoryId         String    @map("category_id") @db.Uuid
  reportedAt         DateTime  @map("reported_at") @db.Timestamptz(6)
  clearedAt          DateTime? @map("cleared_at") @db.Timestamptz(6)
  clearedByAccountId String?   @map("cleared_by_account_id") @db.Uuid

  @@id([marketId, categoryId])
  @@map("retired_category_flags")
  @@schema("certification")
}

/// A manufacturer certificate (`ProductCertification`, data design 3.15; D 2.1, 3.4; ADR-0012 d3,
/// ADR-0028 d7; slice 14): the root with its status, its two revision pointers and the admin's
/// draft. Coverage, editors and the decision of a revision are in the insert-only tables of 3.16;
/// the draft's lists are mutable tables copied into them at submission. Never deleted (Q-C2).
model CertificationProductCertification {
  id                               String                                      @id @db.Uuid
  marketId                         String                                      @map("market_id") @db.VarChar(8)
  tenantId                         String                                      @map("tenant_id")
  typeId                           String                                      @map("type_id") @db.Uuid
  /// draft | in-review | approved | rejected | suspended | revoked | expired (D 3.4).
  status                           String
  /// The one pending revision; a single column, so "at most one pending" holds by construction.
  pendingRevisionId                String?                                     @map("pending_revision_id") @db.Uuid
  /// The approved revision (V1 pointer); only a revision of this certificate.
  approvedRevisionId               String?                                     @map("approved_revision_id") @db.Uuid
  /// Denormalised copy of the approved decision's boundary, for the expiry job's index only;
  /// evaluateClaims reads the decision row, never this column.
  approvedBoundaryAt               DateTime?                                   @map("approved_boundary_at") @db.Timestamptz(6)
  /// The admin's working copy. The manufacturer is a company, kept clear (S7, 1 to 200).
  draftManufacturerName            String?                                     @map("draft_manufacturer_name")
  /// Only an issuer of the same type and Market (CE4); its state is checked at submission.
  draftIssuerId                    String?                                     @map("draft_issuer_id") @db.Uuid
  /// Encrypted under the Market's platform subject (CE7).
  draftCertificateNumberCiphertext String?                                     @map("draft_certificate_number_ciphertext")
  draftIssueDate                   DateTime?                                   @map("draft_issue_date") @db.Date
  draftExpiryDate                  DateTime?                                   @map("draft_expiry_date") @db.Date
  /// The admin who created the record (C4: a plain id); never approves any of its revisions.
  authorAccountId                  String                                      @map("author_account_id") @db.Uuid
  statusChangedAt                  DateTime                                    @map("status_changed_at") @db.Timestamptz(6)
  lastChangedAt                    DateTime                                    @map("last_changed_at") @db.Timestamptz(6)
  /// Optimistic version of the aggregate (CE1); 1 at insert.
  version                          Int
  createdAt                        DateTime                                    @map("created_at") @db.Timestamptz(6)
  type                             CertificationType                           @relation(fields: [marketId, typeId], references: [marketId, id], map: "product_certifications_type_fkey", onDelete: Restrict, onUpdate: Restrict)
  draftIssuer                      CertificationIssuer?                        @relation("ProductCertificateDraftIssuer", fields: [marketId, draftIssuerId, typeId], references: [marketId, id, typeId], map: "product_certifications_draft_issuer_fkey", onDelete: Restrict, onUpdate: Restrict)
  revisions                        CertificationProductCertificationRevision[] @relation("ProductCertificateRevisions")
  pendingRevision                  CertificationProductCertificationRevision?  @relation("ProductCertificatePending", fields: [marketId, id, pendingRevisionId], references: [marketId, productCertificationId, id], map: "product_certifications_pending_revision_fkey", onDelete: Restrict, onUpdate: Restrict)
  approvedRevision                 CertificationProductCertificationRevision?  @relation("ProductCertificateApproved", fields: [marketId, id, approvedRevisionId], references: [marketId, productCertificationId, id], map: "product_certifications_approved_revision_fkey", onDelete: Restrict, onUpdate: Restrict)
  draftCoverage                    CertificationProductDraftCoverage[]
  draftEditors                     CertificationProductDraftEditor[]
  history                          CertificationProductCertificationHistory[]

  @@unique([marketId, id])
  /// The target of the revision foreign key, which carries the type (CE4).
  @@unique([marketId, id, typeId])
  /// The admin list, newest first (keyset on created_at DESC, id DESC).
  @@index([marketId, createdAt, id])
  @@map("product_certifications")
  @@schema("certification")
}

/// The draft's coverage (data design 3.15): mutable, copied into `product_revision_coverage` at
/// submission. `product_revision_id` is the published product revision catalog answered at the
/// save (M3), never a client value.
model CertificationProductDraftCoverage {
  id                     String                            @id @db.Uuid
  marketId               String                            @map("market_id") @db.VarChar(8)
  tenantId               String                            @map("tenant_id")
  productCertificationId String                            @map("product_certification_id") @db.Uuid
  /// catalog ids (C4: no foreign key).
  productId              String                            @map("product_id") @db.Uuid
  productRevisionId      String                            @map("product_revision_id") @db.Uuid
  /// NULL: the whole product; a value narrows to that variant (CERT-41).
  variantId              String?                           @map("variant_id") @db.Uuid
  certificate            CertificationProductCertification @relation(fields: [marketId, productCertificationId], references: [marketId, id], map: "product_certification_draft_coverage_certificate_fkey", onDelete: Restrict, onUpdate: Restrict)

  @@unique([marketId, id])
  @@index([marketId, productCertificationId])
  @@map("product_certification_draft_coverage")
  @@schema("certification")
}

/// Every admin who edited the draft since the last submission (data design 3.15; AC 20): copied
/// into `product_revision_editors` and removed at submission.
model CertificationProductDraftEditor {
  marketId               String                            @map("market_id") @db.VarChar(8)
  tenantId               String                            @map("tenant_id")
  productCertificationId String                            @map("product_certification_id") @db.Uuid
  accountId              String                            @map("account_id") @db.Uuid
  firstEditedAt          DateTime                          @map("first_edited_at") @db.Timestamptz(6)
  certificate            CertificationProductCertification @relation(fields: [marketId, productCertificationId], references: [marketId, id], map: "product_certification_draft_editors_certificate_fkey", onDelete: Restrict, onUpdate: Restrict)

  @@id([marketId, productCertificationId, accountId])
  @@map("product_certification_draft_editors")
  @@schema("certification")
}

/// One submitted revision of a manufacturer certificate (data design 3.16; V1). Insert-only (CE3):
/// its status is derived from the root's pointers and its decision row.
model CertificationProductCertificationRevision {
  id                          String                                     @id @db.Uuid
  marketId                    String                                     @map("market_id") @db.VarChar(8)
  tenantId                    String                                     @map("tenant_id")
  productCertificationId      String                                     @map("product_certification_id") @db.Uuid
  typeId                      String                                     @map("type_id") @db.Uuid
  /// The type's published revision at submission (I1, slice 14): decides the expiry rule and the
  /// badge texts, as a seller submission's does.
  typeRevisionId              String                                     @map("type_revision_id") @db.Uuid
  revisionNo                  Int                                        @map("revision_no")
  issuerId                    String                                     @map("issuer_id") @db.Uuid
  manufacturerName            String                                     @map("manufacturer_name")
  /// Encrypted under the Market's platform subject (CE7).
  certificateNumberCiphertext String                                     @map("certificate_number_ciphertext")
  issueDate                   DateTime?                                  @map("issue_date") @db.Date
  expiryDate                  DateTime?                                  @map("expiry_date") @db.Date
  /// The record's creator (copied); the decision's author foreign key points here.
  authorAccountId             String                                     @map("author_account_id") @db.Uuid
  /// "hmac-sha256:<64 hex>" under the platform subject (ADR-0009 decision 6).
  contentHash                 String                                     @map("content_hash")
  submittedByAccountId        String                                     @map("submitted_by_account_id") @db.Uuid
  submittedAt                 DateTime                                   @map("submitted_at") @db.Timestamptz(6)
  certificate                 CertificationProductCertification          @relation("ProductCertificateRevisions", fields: [marketId, productCertificationId, typeId], references: [marketId, id, typeId], map: "product_certification_revisions_certificate_fkey", onDelete: Restrict, onUpdate: Restrict)
  typeRevision                CertificationTypeRevision                  @relation(fields: [marketId, typeId, typeRevisionId], references: [marketId, typeId, id], map: "product_certification_revisions_type_revision_fkey", onDelete: Restrict, onUpdate: Restrict)
  issuer                      CertificationIssuer                        @relation(fields: [marketId, issuerId, typeId], references: [marketId, id, typeId], map: "product_certification_revisions_issuer_fkey", onDelete: Restrict, onUpdate: Restrict)
  pendingOf                   CertificationProductCertification[]        @relation("ProductCertificatePending")
  approvedOf                  CertificationProductCertification[]        @relation("ProductCertificateApproved")
  coverage                    CertificationProductRevisionCoverage[]
  editors                     CertificationProductRevisionEditor[]
  /// At most one (the decision's primary key); a list because the foreign key carries the author.
  decisions                   CertificationProductRevisionDecision[]
  issuerConfirmations         CertificationProductIssuerConfirmation[]
  history                     CertificationProductCertificationHistory[]

  @@unique([marketId, id])
  /// The target of the root's pointer foreign keys (CE4).
  @@unique([marketId, productCertificationId, id], map: "product_certification_revisions_market_id_cert_id_id_key")
  @@unique([marketId, productCertificationId, revisionNo], map: "product_certification_revisions_market_id_cert_id_no_key")
  /// The target of the coverage foreign key, which carries the type (CE4).
  @@unique([marketId, id, typeId])
  /// The target of the issuer confirmation foreign key.
  @@unique([marketId, id, issuerId])
  /// The target of the decision's author foreign key (decided_by <> author).
  @@unique([marketId, id, authorAccountId])
  @@map("product_certification_revisions")
  @@schema("certification")
}

/// The coverage of a revision (data design 3.16): insert-only, copied from the draft at
/// submission. The two partial uniques are hand-written.
model CertificationProductRevisionCoverage {
  id                String                                    @id @db.Uuid
  marketId          String                                    @map("market_id") @db.VarChar(8)
  tenantId          String                                    @map("tenant_id")
  revisionId        String                                    @map("revision_id") @db.Uuid
  typeId            String                                    @map("type_id") @db.Uuid
  productId         String                                    @map("product_id") @db.Uuid
  /// The covered product revision (M3); evaluateClaims matches it to the query's.
  productRevisionId String                                    @map("product_revision_id") @db.Uuid
  /// NULL: the whole product; a value narrows to that variant (CERT-41, L1).
  variantId         String?                                   @map("variant_id") @db.Uuid
  revision          CertificationProductCertificationRevision @relation(fields: [marketId, revisionId, typeId], references: [marketId, id, typeId], map: "product_revision_coverage_revision_fkey", onDelete: Restrict, onUpdate: Restrict)

  @@unique([marketId, id])
  /// A3: statement S3 is an index-only scan on it. The design's INCLUDE (variant_id, revision_id)
  /// is written as trailing key columns, so Prisma knows the index and never drops it as drift.
  @@index([marketId, productId, typeId, productRevisionId, variantId, revisionId], map: "product_revision_coverage_lookup_idx")
  /// Mojtaba F1: the coverage of one revision (the revision read's relation load) and the
  /// referencing side of the composite foreign key to the revision.
  @@index([marketId, revisionId, typeId])
  @@map("product_revision_coverage")
  @@schema("certification")
}

/// The admins who edited a revision, and its submitter (data design 3.16; AC 20). Insert-only.
model CertificationProductRevisionEditor {
  marketId   String                                    @map("market_id") @db.VarChar(8)
  tenantId   String                                    @map("tenant_id")
  revisionId String                                    @map("revision_id") @db.Uuid
  accountId  String                                    @map("account_id") @db.Uuid
  revision   CertificationProductCertificationRevision @relation(fields: [marketId, revisionId], references: [marketId, id], map: "product_revision_editors_revision_fkey", onDelete: Restrict, onUpdate: Restrict)

  @@id([marketId, revisionId, accountId])
  @@map("product_revision_editors")
  @@schema("certification")
}

/// The one outcome of a revision (data design 3.16; V4): approved, rejected or withdrawn. The
/// boundary of an approval is stored in the Market zone of that time (ADR-0028 d8). Insert-only.
model CertificationProductRevisionDecision {
  marketId           String                                    @map("market_id") @db.VarChar(8)
  tenantId           String                                    @map("tenant_id")
  revisionId         String                                    @map("revision_id") @db.Uuid
  /// approved | rejected | withdrawn
  outcome            String
  expiryBoundaryAt   DateTime?                                 @map("expiry_boundary_at") @db.Timestamptz(6)
  boundaryZone       String?                                   @map("boundary_zone")
  /// A code of the Market's review reasons; required for `rejected`.
  reasonCode         String?                                   @map("reason_code")
  /// The revision's real author, bound by the foreign key; never the decider (AC 20).
  authorAccountId    String                                    @map("author_account_id") @db.Uuid
  /// NULL only for a system withdrawal.
  decidedByAccountId String?                                   @map("decided_by_account_id") @db.Uuid
  decidedAt          DateTime                                  @map("decided_at") @db.Timestamptz(6)
  revision           CertificationProductCertificationRevision @relation(fields: [marketId, revisionId, authorAccountId], references: [marketId, id, authorAccountId], map: "product_revision_decisions_revision_fkey", onDelete: Restrict, onUpdate: Restrict)

  @@id([marketId, revisionId])
  @@map("product_revision_decisions")
  @@schema("certification")
}

/// A reviewer's full confirmation with the issuer for a manufacturer revision (data design 3.16,
/// shape of 3.16a; written from the documents part of slice 14). Insert-only.
model CertificationProductIssuerConfirmation {
  marketId            String                                    @map("market_id") @db.VarChar(8)
  tenantId            String                                    @map("tenant_id")
  revisionId          String                                    @map("revision_id") @db.Uuid
  issuerId            String                                    @map("issuer_id") @db.Uuid
  channelId           String                                    @map("channel_id") @db.Uuid
  confirmedOn         DateTime                                  @map("confirmed_on") @db.Date
  /// Encrypted under the Market's platform subject (CE7).
  referenceCiphertext String                                    @map("reference_ciphertext")
  confirmsNumber      Boolean                                   @map("confirms_number")
  confirmsHolder      Boolean                                   @map("confirms_holder")
  recordedByAccountId String                                    @map("recorded_by_account_id") @db.Uuid
  recordedAt          DateTime                                  @map("recorded_at") @db.Timestamptz(6)
  revision            CertificationProductCertificationRevision @relation(fields: [marketId, revisionId, issuerId], references: [marketId, id, issuerId], map: "product_issuer_confirmations_revision_fkey", onDelete: Restrict, onUpdate: Restrict)
  channel             CertificationIssuerContactChannel         @relation(fields: [marketId, issuerId, channelId], references: [marketId, issuerId, id], map: "product_issuer_confirmations_channel_fkey", onDelete: Restrict, onUpdate: Restrict)

  @@id([marketId, revisionId])
  @@map("product_issuer_confirmations")
  @@schema("certification")
}

/// The status history of a manufacturer certificate (data design 3.16, shape of 3.13; CERT-17,
/// V4): one row per submission and decision, from the first submission. Insert-only.
model CertificationProductCertificationHistory {
  id                     String                                     @id @db.Uuid
  marketId               String                                     @map("market_id") @db.VarChar(8)
  tenantId               String                                     @map("tenant_id")
  productCertificationId String                                     @map("product_certification_id") @db.Uuid
  fromStatus             String?                                    @map("from_status")
  toStatus               String                                     @map("to_status")
  revisionId             String?                                    @map("revision_id") @db.Uuid
  /// admin | system
  actorKind              String                                     @map("actor_kind")
  actorAccountId         String?                                    @map("actor_account_id") @db.Uuid
  reasonCode             String?                                    @map("reason_code")
  noteCiphertext         String?                                    @map("note_ciphertext")
  occurredAt             DateTime                                   @map("occurred_at") @db.Timestamptz(6)
  certificate            CertificationProductCertification          @relation(fields: [marketId, productCertificationId], references: [marketId, id], map: "product_certification_history_certificate_fkey", onDelete: Restrict, onUpdate: Restrict)
  revision               CertificationProductCertificationRevision? @relation(fields: [marketId, productCertificationId, revisionId], references: [marketId, productCertificationId, id], map: "product_certification_history_revision_fkey", onDelete: Restrict, onUpdate: Restrict)

  @@unique([marketId, id])
  @@index([marketId, productCertificationId, occurredAt])
  @@map("product_certification_history")
  @@schema("certification")
}
