// The customers module's tables (the buyer's delivery address book). Every model is named
// Customers<Name> and mapped to its table with @@map. The CHECKs, the one-default-address index and
// the grants are hand-written in the migration.

/// A delivery address in a customer's address book. Everything the customer typed (recipient
/// name, phone, address lines, region, postcode, delivery notes) is one ciphertext under the
/// customer account's subject key, so destroying that key erases the address. Only the country,
/// the default flag and the times are clear. At most one default address per customer.
model CustomersAddress {
  id                String   @id @db.Uuid
  marketId          String   @map("market_id") @db.VarChar(8)
  tenantId          String   @map("tenant_id")
  /// The customer account (identity), a plain id with no foreign key.
  accountId         String   @map("account_id") @db.Uuid
  /// Personal; the canonical JSON of the address, sealed under the account's subject key.
  contentCiphertext String   @map("content_ciphertext")
  /// ISO 3166 country of the address (the Market's address country).
  countryCode       String   @map("country_code") @db.VarChar(2)
  isDefault         Boolean  @default(false) @map("is_default")
  createdAt         DateTime @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @map("updated_at") @db.Timestamptz(6)

  @@index([marketId, accountId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("addresses")
  @@schema("customers")
}

/// One version of a Market's buyer account deletion setting (package 5a). Insert-only: the setting
/// in force is the row with the highest version, and the rows before it are the change history
/// (who, when, what, why).
model CustomersAccountDeletionSettings {
  marketId          String   @map("market_id") @db.VarChar(8)
  /// 1 for the first admin change, +1 for each later one. The primary key refuses two admins
  /// saving from the same version: the second one is told to reload.
  version           Int
  tenantId          String   @map("tenant_id")
  /// Whether a buyer may start a deletion request.
  enabled           Boolean
  /// Days a request waits before it is carried out; 7 to 90.
  waitingPeriodDays Int      @map("waiting_period_days") @db.SmallInt
  /// Why the admin made the change: 1 to 500 characters of one line of plain text.
  reason            String   @db.VarChar(500)
  changedAt         DateTime @map("changed_at") @db.Timestamptz(6)
  /// The admin account that made the change (a plain id, no foreign key).
  changedBy         String   @map("changed_by") @db.Uuid

  @@id([marketId, version])
  @@map("account_deletion_settings")
  @@schema("customers")
}

/// A buyer's request to delete their account (package 5b). At most one open (pending or executing) request per
/// account (a hand-written partial unique index over pending and executing). The executor job claims
/// a pending request once `scheduledFor` has passed (executing; the buyer can no longer cancel),
/// carries it out and marks it `completed`; the buyer can cancel while it waits.
/// Holds no personal data: ids, a status and times only.
model CustomersAccountDeletionRequest {
  id                String    @id @db.Uuid
  marketId          String    @map("market_id") @db.VarChar(8)
  tenantId          String    @map("tenant_id")
  /// The customer account (identity), a plain id with no foreign key; meaningless once erased.
  accountId         String    @map("account_id") @db.Uuid
  /// pending, executing, cancelled or completed (CHECK). pending to executing (the job's claim),
  /// executing back to pending (a blocker found after the claim) or to completed; pending to
  /// cancelled. Trigger-free: the grant lets the application update only the state columns, and
  /// every update is conditional on the status it moves from.
  status            String
  /// The waiting period in force when the request was made; the request keeps it.
  waitingPeriodDays Int       @map("waiting_period_days") @db.SmallInt
  requestedAt       DateTime  @map("requested_at") @db.Timestamptz(6)
  /// requestedAt plus waitingPeriodDays (UTC instants; the Clock, not Date arithmetic).
  scheduledFor      DateTime  @map("scheduled_for") @db.Timestamptz(6)
  cancelledAt       DateTime? @map("cancelled_at") @db.Timestamptz(6)
  /// customer (the buyer cancelled), sign-in (the buyer signed in during the wait) or admin (an
  /// admin cancelled, package 5c); CHECK.
  cancelReason      String?   @map("cancel_reason")
  completedAt       DateTime? @map("completed_at") @db.Timestamptz(6)
  /// When the job claimed it (status executing, and kept once completed); null while pending and
  /// on a cancelled request. A claim older than 15 minutes is taken again by the next run.
  claimedAt         DateTime? @map("claimed_at") @db.Timestamptz(6)
  /// customer (the buyer asked) or admin (an admin asked for the buyer, package 5c); CHECK.
  requestedBy       String    @default("customer") @map("requested_by")
  /// The admin who made an admin request (identity account id, no foreign key); null for a buyer's.
  adminAccountId    String?   @map("admin_account_id") @db.Uuid
  /// The support ticket of an admin request: admin-entered text, kept here and out of events and audit.
  ticketRef         String?   @map("ticket_ref") @db.VarChar(64)
  /// Why an admin made the request: admin-entered free text, 1 to 500 characters, possible personal
  /// data. Set to null (with redactedAt) when the request is closed; the ticket reference stays.
  reason            String?   @db.VarChar(500)
  /// The admin who cancelled the request (cancelReason admin); null otherwise.
  cancelledByAdminId String?  @map("cancelled_by_admin_id") @db.Uuid
  /// When the reason was redacted (the request closed, cancelled or completed); null for a buyer's
  /// request and while an admin's is open. CHECK: set if and only if an admin request has no reason.
  redactedAt        DateTime? @map("redacted_at") @db.Timestamptz(6)

  // Hand-written partial indexes (the migration): one open request per account, the due query
  // (pending, by date) and the stale-claim query (executing, by claim time).
  @@map("account_deletion_requests")
  @@schema("customers")
}

/// Customers' outbox: `customers.account-deletion-settings-changed.v1` and the three account deletion request events.
model CustomersOutbox {
  /// UUIDv7 stamped by the outbox writer.
  eventId          String    @id @map("event_id") @db.Uuid
  /// "customers.<subject>-<verb>.v<N>"; the CHECK refuses another module's type.
  type             String
  /// The instant the use case took from Clock (UTC).
  occurredAt       DateTime  @map("occurred_at") @db.Timestamptz(6)
  /// Market of the unit that wrote the event (ADR-0003); stamped by the writer.
  marketId         String    @map("market_id") @db.VarChar(8)
  /// Tenant seam (ADR-0001); stamped by the writer, no database default.
  tenantId         String    @map("tenant_id")
  aggregateType    String    @map("aggregate_type")
  aggregateId      String    @map("aggregate_id") @db.Uuid
  /// The aggregate's version after the change; unique per aggregate (P 10).
  aggregateVersion Int       @map("aggregate_version")
  correlationId    String    @map("correlation_id")
  /// The consumed event that caused this one, or null.
  causationId      String?   @map("causation_id") @db.Uuid
  payload          Json      @db.JsonB
  /// Set by the relay when the event was handed to the bus; the only column that changes.
  publishedAt      DateTime? @map("published_at") @db.Timestamptz(6)

  /// No two events of one aggregate share a version (I7); led by market_id (data design C7).
  @@unique([marketId, aggregateId, aggregateVersion])
  @@map("outbox")
  @@schema("customers")
}
