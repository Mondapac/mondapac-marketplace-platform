// The customers module's tables (the buyer's delivery address book). Every model is named
// Customers<Name> and mapped to its table with @@map. The CHECKs, the one-default-address index and
// the grants are hand-written in the migration.

/// A delivery address in a customer's address book. Everything the customer typed (recipient
/// name, phone, address lines, region, postcode, delivery notes) is one ciphertext under the
/// customer account's subject key, so destroying that key erases the address. Only the country,
/// the default flag and the times are clear. At most one default address per customer.
model CustomersAddress {
  id                String   @id @db.Uuid
  marketId          String   @map("market_id") @db.VarChar(8)
  tenantId          String   @map("tenant_id")
  /// The customer account (identity), a plain id with no foreign key.
  accountId         String   @map("account_id") @db.Uuid
  /// Personal; the canonical JSON of the address, sealed under the account's subject key.
  contentCiphertext String   @map("content_ciphertext")
  /// ISO 3166 country of the address (the Market's address country).
  countryCode       String   @map("country_code") @db.VarChar(2)
  isDefault         Boolean  @default(false) @map("is_default")
  createdAt         DateTime @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @map("updated_at") @db.Timestamptz(6)

  @@index([marketId, accountId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("addresses")
  @@schema("customers")
}

/// One version of a Market's buyer account deletion setting (package 5a). Insert-only: the setting
/// in force is the row with the highest version, and the rows before it are the change history
/// (who, when, what, why).
model CustomersAccountDeletionSettings {
  marketId          String   @map("market_id") @db.VarChar(8)
  /// 1 for the first admin change, +1 for each later one. The primary key refuses two admins
  /// saving from the same version: the second one is told to reload.
  version           Int
  tenantId          String   @map("tenant_id")
  /// Whether a buyer may start a deletion request.
  enabled           Boolean
  /// Days a request waits before it is carried out; 7 to 90.
  waitingPeriodDays Int      @map("waiting_period_days") @db.SmallInt
  /// Why the admin made the change: 1 to 500 characters of one line of plain text.
  reason            String   @db.VarChar(500)
  changedAt         DateTime @map("changed_at") @db.Timestamptz(6)
  /// The admin account that made the change (a plain id, no foreign key).
  changedBy         String   @map("changed_by") @db.Uuid

  @@id([marketId, version])
  @@map("account_deletion_settings")
  @@schema("customers")
}

/// A buyer's request to delete their account (package 5b). At most one open (pending or executing) request per
/// account (a hand-written partial unique index over pending and executing). The executor job claims
/// a pending request once `scheduledFor` has passed (executing; the buyer can no longer cancel),
/// carries it out and marks it `completed`; the buyer can cancel while it waits.
/// Holds no personal data: ids, a status and times only.
model CustomersAccountDeletionRequest {
  id                 String    @id @db.Uuid
  marketId           String    @map("market_id") @db.VarChar(8)
  tenantId           String    @map("tenant_id")
  /// The customer account (identity), a plain id with no foreign key; meaningless once erased.
  accountId          String    @map("account_id") @db.Uuid
  /// pending, executing, cancelled or completed (CHECK). pending to executing (the job's claim),
  /// executing back to pending (a blocker found after the claim) or to completed; pending to
  /// cancelled. The grant lets the application update only the state columns, and
  /// every update is conditional on the status it moves from.
  status             String
  /// The waiting period in force when the request was made; the request keeps it.
  waitingPeriodDays  Int       @map("waiting_period_days") @db.SmallInt
  requestedAt        DateTime  @map("requested_at") @db.Timestamptz(6)
  /// requestedAt plus waitingPeriodDays (UTC instants; the Clock, not Date arithmetic).
  scheduledFor       DateTime  @map("scheduled_for") @db.Timestamptz(6)
  cancelledAt        DateTime? @map("cancelled_at") @db.Timestamptz(6)
  /// customer (the buyer cancelled), sign-in (the buyer signed in during the wait) or admin (an
  /// admin cancelled, package 5c); CHECK.
  cancelReason       String?   @map("cancel_reason")
  completedAt        DateTime? @map("completed_at") @db.Timestamptz(6)
  /// When the job claimed it (status executing, and kept once completed); null while pending and
  /// on a cancelled request. A claim older than 15 minutes is taken again by the next run.
  claimedAt          DateTime? @map("claimed_at") @db.Timestamptz(6)
  /// customer (the buyer asked) or admin (an admin asked for the buyer, package 5c); CHECK.
  requestedBy        String    @default("customer") @map("requested_by")
  /// The admin who made an admin request (identity account id, no foreign key); null for a buyer's.
  adminAccountId     String?   @map("admin_account_id") @db.Uuid
  /// The support ticket of an admin request: admin-entered text, kept here and out of events and audit.
  ticketRef          String?   @map("ticket_ref") @db.VarChar(64)
  /// Why an admin made the request: admin-entered free text, 1 to 500 characters, possible personal
  /// data. Set to null (with redactedAt) when the request is closed; the ticket reference stays.
  reason             String?   @db.VarChar(500)
  /// The admin who cancelled the request (cancelReason admin); null otherwise.
  cancelledByAdminId String?   @map("cancelled_by_admin_id") @db.Uuid
  /// When the reason was redacted (the request closed, cancelled or completed); null for a buyer's
  /// request and while an admin's is open. CHECK: set if and only if an admin request has no reason.
  redactedAt         DateTime? @map("redacted_at") @db.Timestamptz(6)

  // Hand-written partial indexes (the migration): one open request per account, the due query
  // (pending, by date) and the stale-claim query (executing, by claim time).
  @@map("account_deletion_requests")
  @@schema("customers")
}

/// Customers' outbox: `customers.account-deletion-settings-changed.v1` and the three account deletion request events.
model CustomersOutbox {
  /// UUIDv7 stamped by the outbox writer.
  eventId          String    @id @map("event_id") @db.Uuid
  /// "customers.<subject>-<verb>.v<N>"; the CHECK refuses another module's type.
  type             String
  /// The instant the use case took from Clock (UTC).
  occurredAt       DateTime  @map("occurred_at") @db.Timestamptz(6)
  /// Market of the unit that wrote the event (ADR-0003); stamped by the writer.
  marketId         String    @map("market_id") @db.VarChar(8)
  /// Tenant seam (ADR-0001); stamped by the writer, no database default.
  tenantId         String    @map("tenant_id")
  aggregateType    String    @map("aggregate_type")
  aggregateId      String    @map("aggregate_id") @db.Uuid
  /// The aggregate's version after the change; unique per aggregate (P 10).
  aggregateVersion Int       @map("aggregate_version")
  correlationId    String    @map("correlation_id")
  /// The consumed event that caused this one, or null.
  causationId      String?   @map("causation_id") @db.Uuid
  payload          Json      @db.JsonB
  /// Set by the relay when the event was handed to the bus; the only column that changes.
  publishedAt      DateTime? @map("published_at") @db.Timestamptz(6)

  /// No two events of one aggregate share a version (I7); led by market_id (data design C7).
  @@unique([marketId, aggregateId, aggregateVersion])
  @@map("outbox")
  @@schema("customers")
}

/// Events customers' subscribers have handled (ADR-0006 decision 5; PM4): `runOnce` inserts
/// (event_id, handler) in the handler's own unit and skips the work when the row exists. Written
/// only by platform/persistence/outbox/. The CHECKs and the grants are hand-written in the
/// migration.
model CustomersInbox {
  eventId     String   @map("event_id") @db.Uuid
  /// The subscriber's name, "customers.<handler>".
  handler     String
  marketId    String   @map("market_id") @db.VarChar(8)
  tenantId    String   @map("tenant_id")
  processedAt DateTime @map("processed_at") @db.Timestamptz(6)

  @@id([eventId, handler])
  @@map("inbox")
  @@schema("customers")
}

/// A customer as the admin Customers pages list them (read model, customers phase 1, package B1).
/// A copy of the `identity` account kept by identity's account events and a one-off backfill, so
/// the list never reads identity's tables. Holds PERSONAL DATA (sign-in address, display name):
/// never logged, never in an event, an audit row or an error; the row is deleted when the account
/// is erased. `emailLower` is the prefix-search key.
model CustomersCustomerDirectory {
  marketId         String                         @map("market_id") @db.VarChar(8)
  tenantId         String                         @map("tenant_id")
  /// The customer account (identity), a plain id with no foreign key.
  accountId        String                         @map("account_id") @db.Uuid
  email            String
  /// The sign-in address, trimmed and lower-cased (the prefix-search key).
  emailLower       String                         @map("email_lower")
  displayName      String?                        @map("display_name")
  /// active or disabled (CHECK).
  status           String
  emailVerified    Boolean                        @map("email_verified")
  signedUpAt       DateTime                       @map("signed_up_at") @db.Timestamptz(6)
  updatedAt        DateTime                       @map("updated_at") @db.Timestamptz(6)
  /// What the customer's orders add up to; every customer has a row (all zero until the first order); the sync and the reconcile write it with the directory row.
  stats            CustomersCustomerStats?
  /// The manual groups the customer is in (phase 2); the rows go with this one.
  groupMemberships CustomersCustomerGroupMember[]
  /// The admins' notes and the activity timeline (phase 2); the rows go with this one.
  notes            CustomersCustomerNote[]
  timeline         CustomersCustomerTimelineEntry[]
  /// The customer's relation with each seller (phase 3); deleted with the directory row.
  sellerCustomers  CustomersSellerCustomer[]

  @@id([marketId, accountId])
  @@index([marketId, signedUpAt(sort: Desc), accountId(sort: Desc)])
  /// The prefix index on (market_id, email_lower text_pattern_ops) is hand-written in the migration.
  @@map("customer_directory")
  @@schema("customers")
}

/// What a customer's orders add up to (read model, customers phase 1, package B1). Recomputed from
/// `ordering` (through its facade) when an order is paid or a refund succeeds, and by the nightly
/// reconcile; never incremented, so a repeated event changes nothing. One row per customer (all zero for
/// one who never ordered). No personal data; deleted when the account is erased.
model CustomersCustomerStats {
  marketId      String                     @map("market_id") @db.VarChar(8)
  tenantId      String                     @map("tenant_id")
  accountId     String                     @map("account_id") @db.Uuid
  firstOrderAt  DateTime?                  @map("first_order_at") @db.Timestamptz(6)
  lastOrderAt   DateTime?                  @map("last_order_at") @db.Timestamptz(6)
  orderCount    Int                        @map("order_count")
  /// Sum of the confirmed orders' totals, minor units of `currency`.
  spentMinor    BigInt                     @map("spent_minor")
  currency      String?                    @db.VarChar(3)
  refundCount   Int                        @map("refund_count")
  refundedMinor BigInt                     @map("refunded_minor")
  /// When ordering was last read for this row.
  computedAt    DateTime                   @map("computed_at") @db.Timestamptz(6)
  /// The customer these totals belong to (same module: the list reads both in one query). The row
  /// goes with the directory row.
  directory     CustomersCustomerDirectory @relation(fields: [marketId, accountId], references: [marketId, accountId], onDelete: Cascade, onUpdate: Restrict)

  @@id([marketId, accountId])
  @@index([marketId, lastOrderAt(sort: Desc)])
  @@index([marketId, orderCount(sort: Desc)])
  @@index([marketId, spentMinor(sort: Desc)])
  @@map("customer_stats")
  @@schema("customers")
}

/// A saved filter (saved view) of the admin Customers list: the tab, search, filters and sort under
/// a name, for one admin ("me") or for every admin who can see the list ("everyone"). The same shape
/// as the other saved-filter tables (`list_key` is a dotted key, `admin.customers.customers` today).
/// The payload is a closed document the application validates; the CHECKs only bound its type and
/// size. `owner_account_id` is an identity account id with no foreign key. The CHECKs, the two
/// case-insensitive name uniques and the grants are hand-written in the migration.
model CustomersSavedFilter {
  id             String   @id @db.Uuid
  marketId       String   @map("market_id") @db.VarChar(8)
  tenantId       String   @map("tenant_id")
  ownerAccountId String   @map("owner_account_id") @db.Uuid
  /// me | everyone.
  visibility     String
  listKey        String   @map("list_key")
  name           String
  payload        Json
  position       Int
  createdAt      DateTime @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @map("updated_at") @db.Timestamptz(6)

  @@unique([marketId, id])
  @@map("saved_filters")
  @@schema("customers")
}

/// A manual customer group of the admin (customers management phase 2, PR 2a): a named list of
/// customers an admin keeps by hand (`kind` manual; rule-based segments come later). The name and
/// the description are admin-entered labels, not personal data (the API tells admins not to put
/// any there). An archived group keeps its members but takes no new ones and is not offered to a
/// promotion. The case-insensitive name unique, the CHECKs and the grants are hand-written in the
/// migration.
model CustomersCustomerGroup {
  id                 String                         @id @db.Uuid
  marketId           String                         @map("market_id") @db.VarChar(8)
  tenantId           String                         @map("tenant_id")
  name               String
  description        String?
  /// manual (CHECK); rule-based kinds are a later phase.
  kind               String
  /// Set while the group is archived; NULL for a live group.
  archivedAt         DateTime?                      @map("archived_at") @db.Timestamptz(6)
  /// The admin who made it (identity account id, no foreign key).
  createdByAccountId String                         @map("created_by_account_id") @db.Uuid
  createdAt          DateTime                       @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                       @map("updated_at") @db.Timestamptz(6)
  /// Optimistic version (P 10); 1 at insert.
  version            Int
  members            CustomersCustomerGroupMember[]

  @@unique([marketId, id])
  @@index([marketId, archivedAt, createdAt(sort: Desc)])
  @@map("customer_groups")
  @@schema("customers")
}

/// One customer in a manual group: who added them and when. The customer must have a directory
/// row (foreign key), and the row goes with it when the account is erased (cascade). No personal
/// data beyond the link of an account to a group.
model CustomersCustomerGroupMember {
  marketId         String                     @map("market_id") @db.VarChar(8)
  tenantId         String                     @map("tenant_id")
  groupId          String                     @map("group_id") @db.Uuid
  accountId        String                     @map("account_id") @db.Uuid
  /// The admin who added the customer (identity account id, no foreign key).
  addedByAccountId String                     @map("added_by_account_id") @db.Uuid
  addedAt          DateTime                   @map("added_at") @db.Timestamptz(6)
  group            CustomersCustomerGroup     @relation(fields: [marketId, groupId], references: [marketId, id], onDelete: Restrict, onUpdate: Restrict)
  customer         CustomersCustomerDirectory @relation(fields: [marketId, accountId], references: [marketId, accountId], onDelete: Cascade, onUpdate: Restrict)

  @@id([marketId, groupId, accountId])
  @@index([marketId, accountId])
  @@map("customer_group_members")
  @@schema("customers")
}

/// An admin's internal note about a customer (customers management phase 2, PR 2a), like the
/// admin order notes: never shown to the customer or a seller, written once, never changed. The
/// text is sealed under the customer account's subject key (label customers.customer-note.body),
/// so erasing the customer makes it unreadable; the erasure also deletes the rows. Only the author
/// and the time are in clear. The CHECKs and the grants are hand-written in the migration.
model CustomersCustomerNote {
  id              String   @id @db.Uuid
  marketId        String   @map("market_id") @db.VarChar(8)
  tenantId        String   @map("tenant_id")
  accountId       String   @map("account_id") @db.Uuid
  /// The admin who wrote it (identity account id, no foreign key).
  authorAccountId String   @map("author_account_id") @db.Uuid
  bodyCiphertext  String                     @map("body_ciphertext")
  createdAt       DateTime                   @map("created_at") @db.Timestamptz(6)
  /// The customer must have a directory row; the note goes with it when the account is erased.
  customer        CustomersCustomerDirectory @relation(fields: [marketId, accountId], references: [marketId, accountId], onDelete: Cascade, onUpdate: Restrict)

  @@index([marketId, accountId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("customer_notes")
  @@schema("customers")
}

/// One entry of a customer's activity timeline (customers management phase 2, PR 2a): a read-only
/// record copied from the events of the owning modules (sign-up, orders, refunds, account changes)
/// and written by customers' own admin actions (page opens, notes, groups, edits). Codes and ids
/// only: no name, address, amount or free text. `source_event_id` makes a repeated delivery a
/// no-op. Deleted when the account is erased. The CHECKs and the grants are hand-written.
model CustomersCustomerTimelineEntry {
  id             String   @id @db.Uuid
  marketId       String   @map("market_id") @db.VarChar(8)
  tenantId       String   @map("tenant_id")
  accountId      String   @map("account_id") @db.Uuid
  occurredAt     DateTime @map("occurred_at") @db.Timestamptz(6)
  /// What happened: a code of the pattern the CHECK holds; the application owns the list.
  kind           String
  /// The kind of thing `ref_id` names (order, refund, group, note), or NULL.
  refType        String?  @map("ref_type")
  refId          String?  @map("ref_id") @db.Uuid
  /// The admin who did it (an admin action), or NULL for the customer's own or the system's.
  actorAccountId String?  @map("actor_account_id") @db.Uuid
  /// A short code of detail (the tab opened, the field changed), or NULL.
  detail         String?
  /// The event this entry was copied from, or NULL for an admin action written directly.
  sourceEventId  String?  @map("source_event_id") @db.Uuid
  recordedAt     DateTime                   @map("recorded_at") @db.Timestamptz(6)
  /// The customer must have a directory row; the entry goes with it when the account is erased.
  customer       CustomersCustomerDirectory @relation(fields: [marketId, accountId], references: [marketId, accountId], onDelete: Cascade, onUpdate: Restrict)

  @@unique([marketId, accountId, sourceEventId])
  @@index([marketId, accountId, occurredAt(sort: Desc), id(sort: Desc)])
  @@map("customer_timeline")
  @@schema("customers")
}

/// One customer as one seller sees them (customers management phase 3): a read model kept by the
/// customer's confirmed orders with that seller (through `ordering`) and the customer's follow of
/// the store (through `engagement`), replaced, never incremented, by the sync and the nightly
/// reconcile. A row exists only while there is a relation (CHECK): bought, follows, or (phase 4)
/// exclusive. `customer_code` is drawn at random when the row is first written and never changes;
/// it is unique per seller and unrelated between sellers, so two sellers cannot match their lists.
/// The seller sees the code and the first name (from the directory), never the account id or the
/// email. Deleted with the customer's directory row (foreign key, ON DELETE CASCADE).
model CustomersSellerCustomer {
  marketId     String                     @map("market_id") @db.VarChar(8)
  tenantId     String                     @map("tenant_id")
  sellerId     String                     @map("seller_id") @db.Uuid
  accountId    String                     @map("account_id") @db.Uuid
  /// XXXX-XXXX in Crockford base32 (CHECK).
  customerCode String                     @map("customer_code") @db.VarChar(9)
  orderCount   Int                        @map("order_count")
  firstOrderAt DateTime?                  @map("first_order_at") @db.Timestamptz(6)
  lastOrderAt  DateTime?                  @map("last_order_at") @db.Timestamptz(6)
  /// The confirmed seller orders' totals less the refunds that succeeded, minor units of `currency`.
  spentMinor   BigInt                     @map("spent_minor")
  currency     String?                    @db.VarChar(3)
  follower     Boolean
  /// When the current follow started; set exactly when `follower` (CHECK).
  followedAt   DateTime?                  @map("followed_at") @db.Timestamptz(6)
  /// Reserved for phase 4 (signed up through the seller's invite link); false until then.
  exclusive    Boolean                    @default(false)
  createdAt    DateTime                   @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime                   @map("updated_at") @db.Timestamptz(6)
  directory    CustomersCustomerDirectory @relation(fields: [marketId, accountId], references: [marketId, accountId], onDelete: Cascade, onUpdate: Restrict)

  @@id([marketId, sellerId, accountId])
  @@unique([marketId, sellerId, customerCode])
  @@index([marketId, accountId])
  @@index([marketId, sellerId, lastOrderAt(sort: Desc), accountId(sort: Desc)])
  @@index([marketId, sellerId, followedAt(sort: Desc), accountId(sort: Desc)])
  @@map("seller_customers")
  @@schema("customers")
}
