// The pricing module (schema "pricing"). Physical design: docs/design/data/pricing.md; every
// model is named Pricing<Name> (its P9) and mapped to its table with @@map. Slice 1 creates the
// outbox, the inbox, the price series root, its regular price records, the two retirement
// tombstone tables and the write-refusal throttles; Cost, special prices and their markers
// arrive with their slices, each in its own migration (data design 8.1).

/// Events of the pricing module (ADR-0006 decisions 1 and 2; data design 3.1, PM1). Written only
/// by the platform OutboxWriter in the unit of the state change, read and marked only by the
/// relay (platform/persistence/outbox/). Every outbox of every module has exactly these fields.
/// The CHECKs, the partial claim index and the grants are hand-written in the migration.
/// Payloads hold ids, enums and instants only: never an amount and never Cost (D 6.3).
model PricingOutbox {
  /// UUIDv7 stamped by the outbox writer.
  eventId          String    @id @map("event_id") @db.Uuid
  /// "pricing.<subject>-<verb>.v<N>"; the CHECK refuses another module's type.
  type             String
  /// The instant the use case took from Clock (UTC).
  occurredAt       DateTime  @map("occurred_at") @db.Timestamptz(6)
  /// Market of the unit that wrote the event (ADR-0003); stamped by the writer.
  marketId         String    @map("market_id") @db.VarChar(8)
  /// Tenant seam (ADR-0001); stamped by the writer, no database default.
  tenantId         String    @map("tenant_id")
  aggregateType    String    @map("aggregate_type")
  aggregateId      String    @map("aggregate_id") @db.Uuid
  /// The aggregate's version after the change; unique per aggregate (P 10).
  aggregateVersion Int       @map("aggregate_version")
  correlationId    String    @map("correlation_id")
  /// The consumed event that caused this one, or null.
  causationId      String?   @map("causation_id") @db.Uuid
  payload          Json      @db.JsonB
  /// Set by the relay when the event was handed to the bus; the only column that changes.
  publishedAt      DateTime? @map("published_at") @db.Timestamptz(6)

  /// No two events of one aggregate share a version (I7); led by market_id (data design C7).
  @@unique([marketId, aggregateId, aggregateVersion])
  @@map("outbox")
  @@schema("pricing")
}

/// Events pricing's subscribers have handled (ADR-0006 decision 5; data design 3.1, PM4):
/// `runOnce` inserts (event_id, handler) in the handler's own unit and skips the work when the
/// row exists. Written only by platform/persistence/outbox/. The CHECKs and the grants are
/// hand-written in the migration.
model PricingInbox {
  eventId     String   @map("event_id") @db.Uuid
  /// The subscriber's name, "pricing.<handler>".
  handler     String
  marketId    String   @map("market_id") @db.VarChar(8)
  tenantId    String   @map("tenant_id")
  processedAt DateTime @map("processed_at") @db.Timestamptz(6)

  @@id([eventId, handler])
  @@map("inbox")
  @@schema("pricing")
}

/// The price series of one Variant of one Offer in one Market (pricing design 2.1; data design
/// 3.2). Offer, seller and currency never change (column grants); the Variant and product copy
/// change only through the CF4 re-key of P1 (migration 7). The CHECKs and the grants are
/// hand-written in the migration.
model PricingPriceSeries {
  id             String                      @id @db.Uuid
  marketId       String                      @map("market_id") @db.VarChar(8)
  tenantId       String                      @map("tenant_id")
  /// catalog's Offer id (a plain id, C4).
  offerId        String                      @map("offer_id") @db.Uuid
  /// catalog's Variant id.
  variantId      String                      @map("variant_id") @db.Uuid
  /// Copy from catalog's offerSellUnits at creation (D 2.3); the Variant-removed handler's key.
  productId      String                      @map("product_id") @db.Uuid
  /// Copy at creation (D 2.3). Ownership is never decided from it (D 5.2).
  sellerId       String                      @map("seller_id") @db.Uuid
  /// The Market's currency at creation, written once (P2); every record's foreign key names it.
  currency       String                      @db.Char(3)
  /// Set once by a retirement handler, with its cause (CHECK).
  retiredAt      DateTime?                   @map("retired_at") @db.Timestamptz(6)
  retireCause    String?                     @map("retire_cause")
  /// Optimistic version of the aggregate (P 10); 1 at insert, raised by every write.
  version        Int
  createdAt      DateTime                    @map("created_at") @db.Timestamptz(6)
  regularRecords PricingRegularPriceRecord[] @relation("SeriesRegularRecords")

  /// One series per (Market, Offer, Variant) (D 2.1); also the Offer-removed handler's index.
  @@unique([marketId, offerId, variantId])
  /// The target of every record's foreign key (P2): a record is in its series' currency.
  @@unique([marketId, id, currency])
  /// The Variant-removed handler (D 6.4).
  @@index([marketId, productId, variantId])
  @@map("price_series")
  @@schema("pricing")
}

/// One regular price record (pricing design 2.1, 3.1; data design 3.3), ADR-0009 V2. Content
/// never changes; status, decision, supersede and period-end columns are written once (column
/// grants and the write-once trigger). The CHECKs, the no-overlap EXCLUDE, the one-pending
/// partial unique index, the triggers and the grants are hand-written in the migration.
model PricingRegularPriceRecord {
  /// The record id ordering freezes (D 6.2).
  id                   String                      @id @db.Uuid
  marketId             String                      @map("market_id") @db.VarChar(8)
  tenantId             String                      @map("tenant_id")
  seriesId             String                      @map("series_id") @db.Uuid
  /// Minor units of `currency` (P1): 1 to 2^53 - 1.
  amountMinor          BigInt                      @map("amount_minor")
  currency             String                      @db.Char(3)
  /// The Market's pricesIncludeTax at write time (D 4.5).
  taxInclusive         Boolean                     @map("tax_inclusive")
  /// accepted | pending-review | approved | rejected | superseded.
  status               String
  submittedAt          DateTime                    @map("submitted_at") @db.Timestamptz(6)
  /// The account that wrote the price (P8; plain id).
  submittedByAccountId String                      @map("submitted_by_account_id") @db.Uuid
  /// The record this one was measured against (D 2.4); null only for the first price.
  anchorRecordId       String?                     @map("anchor_record_id") @db.Uuid
  anchorAmountMinor    BigInt?                     @map("anchor_amount_minor")
  /// up | down for a held record; null exactly for an accepted one.
  holdDirection        String?                     @map("hold_direction")
  /// Set when the record becomes effective; never by input (Q5).
  effectiveFrom        DateTime?                   @map("effective_from") @db.Timestamptz(6)
  /// The stored period end (M1); null while open. Written once, closing first (P7).
  effectiveTo          DateTime?                   @map("effective_to") @db.Timestamptz(6)
  decidedAt            DateTime?                   @map("decided_at") @db.Timestamptz(6)
  decidedByAccountId   String?                     @map("decided_by_account_id") @db.Uuid
  decisionReasonCode   String?                     @map("decision_reason_code")
  /// Personal (free text). Never in an audit row, an event or a log (D 8).
  decisionNote         String?                     @map("decision_note")
  supersededAt         DateTime?                   @map("superseded_at") @db.Timestamptz(6)
  /// The record that replaced this one; no foreign key (it is written before its target, 3.3).
  supersededByRecordId String?                     @map("superseded_by_record_id") @db.Uuid
  /// replaced | cancelled | offer-removed | variant-removed.
  supersedeCause       String?                     @map("supersede_cause")
  series               PricingPriceSeries          @relation("SeriesRegularRecords", fields: [marketId, seriesId, currency], references: [marketId, id, currency], onDelete: Restrict, onUpdate: Restrict, map: "regular_price_records_series_id_fkey")
  anchor               PricingRegularPriceRecord?  @relation("RegularAnchor", fields: [marketId, seriesId, anchorRecordId], references: [marketId, seriesId, id], onDelete: Restrict, onUpdate: Restrict, map: "regular_price_records_anchor_record_id_fkey")
  anchoredRecords      PricingRegularPriceRecord[] @relation("RegularAnchor")

  /// The target of the in-series references (P3); also "the records of a series in order".
  @@unique([marketId, seriesId, id])
  @@map("regular_price_records")
  @@schema("pricing")
}

/// Retirement tombstone of an Offer (PD7; data design 3.6): written by the Offer-removed handler,
/// even when no series exists; read by the unit that creates a series. Insert-only; ids from
/// catalog's events (no foreign key). The CHECKs and the grants are hand-written in the migration.
model PricingRetiredOffer {
  marketId     String   @map("market_id") @db.VarChar(8)
  tenantId     String   @map("tenant_id")
  offerId      String   @map("offer_id") @db.Uuid
  retiredAt    DateTime @map("retired_at") @db.Timestamptz(6)
  /// catalog's event id, for tracing.
  causeEventId String   @map("cause_event_id") @db.Uuid

  @@id([marketId, offerId])
  @@map("retired_offers")
  @@schema("pricing")
}

/// Retirement tombstone of a Variant, keyed by (product, Variant): catalog's variant-removed
/// carries no Offer id (M5; data design 3.6). Insert-only, never removed.
model PricingRetiredVariant {
  marketId     String   @map("market_id") @db.VarChar(8)
  tenantId     String   @map("tenant_id")
  productId    String   @map("product_id") @db.Uuid
  variantId    String   @map("variant_id") @db.Uuid
  retiredAt    DateTime @map("retired_at") @db.Timestamptz(6)
  causeEventId String   @map("cause_event_id") @db.Uuid

  @@id([marketId, productId, variantId])
  @@map("retired_variants")
  @@schema("pricing")
}

/// The H3 counter (D 5.2, 8; data design 3.8, M7): at most one `pricing.offer-write-refused`
/// audit row per (actor, Offer) per minute. Transient: purged after an hour. The CHECKs and the
/// grants are hand-written in the migration.
model PricingWriteRefusalThrottle {
  marketId        String   @map("market_id") @db.VarChar(8)
  tenantId        String   @map("tenant_id")
  actorAccountId  String   @map("actor_account_id") @db.Uuid
  offerId         String   @map("offer_id") @db.Uuid
  windowStartedAt DateTime @map("window_started_at") @db.Timestamptz(6)

  @@id([marketId, actorAccountId, offerId])
  @@map("write_refusal_throttles")
  @@schema("pricing")
}

/// The per-actor cap of M7 (D 5.2, 8): at most 20 refusal audit rows per actor per minute across
/// Offers, then one `pricing.offer-write-refused.suppressed` summary row (no count; data design
/// 12.1). Adopted in data design 3.8 (2026-10-08, 12.1 row 3). Transient: purged after an hour.
/// The CHECKs and the grants are hand-written in the migration.
model PricingWriteRefusalActorThrottle {
  marketId        String   @map("market_id") @db.VarChar(8)
  tenantId        String   @map("tenant_id")
  actorAccountId  String   @map("actor_account_id") @db.Uuid
  windowStartedAt DateTime @map("window_started_at") @db.Timestamptz(6)
  /// Refusal rows recorded in the current window (at most the cap).
  recordedCount   Int      @map("recorded_count")
  /// Refusals beyond the cap in the current window; the first one writes the summary row.
  suppressedCount Int      @map("suppressed_count")

  @@id([marketId, actorAccountId])
  @@map("write_refusal_actor_throttles")
  @@schema("pricing")
}
